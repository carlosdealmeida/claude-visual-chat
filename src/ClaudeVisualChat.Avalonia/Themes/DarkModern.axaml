<!--
  The colors of ClaudeChatView with the values of VS Code's "Dark Modern" theme, instead of the default "Dark 2026".
  Put it in the view's resources:

    <cvc:ClaudeChatView.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceInclude Source="avares://ClaudeVisualChat.Avalonia/Themes/DarkModern.axaml" />
        </ResourceDictionary.MergedDictionaries>
      </ResourceDictionary>
    </cvc:ClaudeChatView.Resources>

  Only the colors that come from the VS Code theme are here; the extension's own ones (the dots, the send button,
  the diff's editor) are the same in both.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="ClaudeChat.Background" Color="#1F1F1F" />           <!-- editor.background -->
  <SolidColorBrush x:Key="ClaudeChat.Surface" Color="#252526" />
  <SolidColorBrush x:Key="ClaudeChat.Border" Color="#2B2B2B" />               <!-- widget/panel borders -->
  <SolidColorBrush x:Key="ClaudeChat.BorderStrong" Color="#3C3C3C" />         <!-- input.border -->
  <SolidColorBrush x:Key="ClaudeChat.Foreground" Color="#CCCCCC" />           <!-- foreground -->
  <SolidColorBrush x:Key="ClaudeChat.ForegroundMuted" Color="#9D9D9D" />      <!-- descriptionForeground -->
  <SolidColorBrush x:Key="ClaudeChat.DisabledForeground" Color="#80CCCCCC" /> <!-- disabledForeground (VS Code's default) -->
  <SolidColorBrush x:Key="ClaudeChat.Accent" Color="#4DAAFC" />               <!-- textLink.foreground -->
  <SolidColorBrush x:Key="ClaudeChat.AccentFill" Color="#0078D4" />           <!-- button.background -->
  <SolidColorBrush x:Key="ClaudeChat.AccentForeground" Color="#FFFFFF" />     <!-- button.foreground -->
  <SolidColorBrush x:Key="ClaudeChat.FocusBorder" Color="#0078D4" />          <!-- focusBorder -->
  <SolidColorBrush x:Key="ClaudeChat.Warning" Color="#CCA700" />
  <SolidColorBrush x:Key="ClaudeChat.Error" Color="#F85149" />                <!-- errorForeground -->
  <SolidColorBrush x:Key="ClaudeChat.Success" Color="#73C991" />
  <SolidColorBrush x:Key="ClaudeChat.InputBackground" Color="#313131" />      <!-- input.background -->
  <SolidColorBrush x:Key="ClaudeChat.InputBorder" Color="#33CCCCCC" />        <!-- inlineChatInput.border = editorWidget.border -->
  <SolidColorBrush x:Key="ClaudeChat.InputActiveBorder" Color="#2488DB" />    <!-- inputOption.activeBorder -->
  <SolidColorBrush x:Key="ClaudeChat.PermissionActiveBorder" Color="#A62488DB" /> <!-- inputOption.activeBorder at 65 % -->
  <SolidColorBrush x:Key="ClaudeChat.InputPlaceholder" Color="#989898" />     <!-- input.placeholderForeground -->
  <SolidColorBrush x:Key="ClaudeChat.HoverBackground" Color="#505A5D5E" />    <!-- toolbar.hoverBackground -->
  <SolidColorBrush x:Key="ClaudeChat.TimelineLine" Color="#2B2B2B" />         <!-- sideBarActivityBarTop.border -->
  <SolidColorBrush x:Key="ClaudeChat.Dot" Color="#9D9D9D" />                  <!-- descriptionForeground -->
  <SolidColorBrush x:Key="ClaudeChat.ToolBackground" Color="#1F1F1F" />       <!-- editor.background -->
  <SolidColorBrush x:Key="ClaudeChat.CodeBackground" Color="#3C3C3C" />       <!-- textPreformat.background -->
  <SolidColorBrush x:Key="ClaudeChat.CodeForeground" Color="#D0D0D0" />       <!-- textPreformat.foreground -->
  <SolidColorBrush x:Key="ClaudeChat.CodeBlockBackground" Color="#2B2B2B" />  <!-- textCodeBlock.background -->
  <SolidColorBrush x:Key="ClaudeChat.PillBackground" Color="#1ACCCCCC" />     <!-- foreground at 10 % -->
  <SolidColorBrush x:Key="ClaudeChat.PillHoverBackground" Color="#2ECCCCCC" /> <!-- foreground at 18 % -->
  <SolidColorBrush x:Key="ClaudeChat.BannerForeground" Color="#8B98BE" />     <!-- BannerTint 50 % + foreground -->
  <SolidColorBrush x:Key="ClaudeChat.BannerBackground" Color="#2A3043" />     <!-- BannerTint 25 % + editor.background -->
  <SolidColorBrush x:Key="ClaudeChat.BannerErrorForeground" Color="#E28F8B" /> <!-- errorForeground 50 % + foreground -->
  <SolidColorBrush x:Key="ClaudeChat.BannerErrorBackground" Color="#552C2A" /> <!-- errorForeground 25 % + editor.background -->
  <SolidColorBrush x:Key="ClaudeChat.AttachmentBackground" Color="#414141" /> <!-- input.background 85 % + descriptionForeground -->
  <SolidColorBrush x:Key="ClaudeChat.AttachmentHoverBorder" Color="#85CCCCCC" /> <!-- the input border 60 % + foreground -->
  <SolidColorBrush x:Key="ClaudeChat.ThumbnailHoverBorder" Color="#B39D9D9D" /> <!-- descriptionForeground at 70 % -->
  <LinearGradientBrush x:Key="ClaudeChat.AttachmentRemoveFade" StartPoint="0%,0%" EndPoint="100%,0%">
    <GradientStop Offset="0" Color="#00414141" />
    <GradientStop Offset="0.5" Color="#414141" />
    <GradientStop Offset="1" Color="#414141" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="ClaudeChat.MenuBackground" Color="#1F1F1F" />       <!-- menu.background -->
  <SolidColorBrush x:Key="ClaudeChat.MenuForeground" Color="#CCCCCC" />       <!-- menu.foreground -->
  <SolidColorBrush x:Key="ClaudeChat.ListHoverBackground" Color="#2A2D2E" />  <!-- list.hoverBackground -->
  <SolidColorBrush x:Key="ClaudeChat.ListActiveBackground" Color="#04395E" /> <!-- list.activeSelectionBackground -->
  <SolidColorBrush x:Key="ClaudeChat.ListActiveForeground" Color="#FFFFFF" /> <!-- list.activeSelectionForeground -->
  <!-- VS Code's chart colors; Dark Modern keeps the defaults -->
  <SolidColorBrush x:Key="ClaudeChat.ContextColor1" Color="#3794FF" />        <!-- charts.blue -->
  <SolidColorBrush x:Key="ClaudeChat.ContextColor2" Color="#B180D7" />        <!-- charts.purple -->
  <SolidColorBrush x:Key="ClaudeChat.ContextColor3" Color="#D18616" />        <!-- charts.orange -->
  <SolidColorBrush x:Key="ClaudeChat.ContextColor4" Color="#89D185" />        <!-- charts.green -->
  <SolidColorBrush x:Key="ClaudeChat.ContextColor5" Color="#CCA700" />        <!-- charts.yellow -->
  <SolidColorBrush x:Key="ClaudeChat.ContextColor6" Color="#F14C4C" />        <!-- charts.red -->
  <!-- the context ring: the track is the foreground at 15 %; the fill is the same as the default theme -->
  <SolidColorBrush x:Key="ClaudeChat.ContextRingTrack" Color="#26CCCCCC" />
  <SolidColorBrush x:Key="ClaudeChat.ContextRingFill" Color="#C6613F" />
  <!-- the touch layout: the user's bubble, and the sheets that rise from the bottom (the handle and the veil have the
       same values as in the default theme) -->
  <SolidColorBrush x:Key="ClaudeChat.UserBubble" Color="#252526" />
  <SolidColorBrush x:Key="ClaudeChat.SheetBackground" Color="#181818" />
  <SolidColorBrush x:Key="ClaudeChat.SheetGroupBackground" Color="#252526" />
  <SolidColorBrush x:Key="ClaudeChat.SheetHandle" Color="#555555" />
  <SolidColorBrush x:Key="ClaudeChat.SheetOverlay" Color="#66000000" />
  <BoxShadows x:Key="ClaudeChat.ToolContentFocusShadow">inset 0 0 0 1 #0078D4</BoxShadows> <!-- focusBorder -->
  <BoxShadows x:Key="ClaudeChat.ComposerFocusShadowAcceptEdits">0 0 0 3 #1FCCCCCC</BoxShadows>
  <BoxShadows x:Key="ClaudeChat.ComposerFocusShadowPlan">0 0 0 3 #1F0078D4</BoxShadows>
  <BoxShadows x:Key="ClaudeChat.ComposerFocusShadowAuto">0 0 0 3 #1FF85149</BoxShadows>
</ResourceDictionary>
