<!--
  The look of ClaudeChatView: the Claude Code extension for VS Code (2.1.301), measured from its webview's CSS, with
  the values of the "Dark 2026" theme of VS Code, its default dark theme (Themes/DarkModern.axaml has the Dark
  Modern ones: include it in the view's Resources). ClaudeChatView includes this file in its own Styles; the app does not
  need to do anything. To change a color, a font or a size, redefine its key (ClaudeChat.*) in the Resources of the
  ClaudeChatView.

  Text: Chromium puts the extra space of a line half above and half below the letters; Avalonia 11.0 puts it all
  below, and places Consolas from its hhea ascent where Chromium on Windows uses the OS/2 one. So texts that must sit
  where the extension's sit are moved down with a RenderTransform (it moves the drawing, not the layout): 1 px for
  Segoe UI in a 1.5 line, 4 px for Consolas.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cvc="using:ClaudeVisualChat"
        xmlns:controls="using:ClaudeVisualChat.Controls"
        xmlns:ctb="clr-namespace:ColorTextBlock.Avalonia;assembly=ColorTextBlock.Avalonia"
        x:CompileBindings="True">

  <Styles.Resources>
    <!-- colors: the VS Code variable each one stands for, with its value in the "Dark 2026" theme of VS Code (its
         default dark theme since 1.142). Themes/DarkModern.axaml has the same keys with the Dark Modern values. -->
    <SolidColorBrush x:Key="ClaudeChat.Background" Color="#191A1B" />           <!-- sideBar.background -->
    <SolidColorBrush x:Key="ClaudeChat.Surface" Color="#202122" />              <!-- editorWidget.background: table headers -->
    <SolidColorBrush x:Key="ClaudeChat.Border" Color="#2A2B2C" />               <!-- widget.border -->
    <SolidColorBrush x:Key="ClaudeChat.BorderStrong" Color="#333536" />         <!-- input.border -->
    <SolidColorBrush x:Key="ClaudeChat.Foreground" Color="#BFBFBF" />           <!-- foreground -->
    <SolidColorBrush x:Key="ClaudeChat.ForegroundMuted" Color="#8C8C8C" />      <!-- descriptionForeground -->
    <SolidColorBrush x:Key="ClaudeChat.Accent" Color="#48A0C7" />               <!-- textLink.foreground -->
    <SolidColorBrush x:Key="ClaudeChat.AccentFill" Color="#297AA0" />           <!-- button.background -->
    <SolidColorBrush x:Key="ClaudeChat.AccentForeground" Color="#FFFFFF" />     <!-- button.foreground -->
    <SolidColorBrush x:Key="ClaudeChat.FocusBorder" Color="#B33994BC" />        <!-- focusBorder -->
    <SolidColorBrush x:Key="ClaudeChat.Warning" Color="#CCA700" />
    <SolidColorBrush x:Key="ClaudeChat.Error" Color="#F48771" />                <!-- errorForeground -->
    <SolidColorBrush x:Key="ClaudeChat.Success" Color="#73C991" />              <!-- gitDecoration.addedResourceForeground -->
    <SolidColorBrush x:Key="ClaudeChat.InputBackground" Color="#191A1B" />      <!-- input.background -->
    <SolidColorBrush x:Key="ClaudeChat.InputBorder" Color="#2A2B2C" />          <!-- inlineChatInput.border = editorWidget.border -->
    <SolidColorBrush x:Key="ClaudeChat.InputActiveBorder" Color="#2A2B2C" />    <!-- inputOption.activeBorder -->
    <SolidColorBrush x:Key="ClaudeChat.PermissionActiveBorder" Color="#A62A2B2C" /> <!-- inputOption.activeBorder at 65 % -->
    <SolidColorBrush x:Key="ClaudeChat.InputPlaceholder" Color="#555555" />     <!-- input.placeholderForeground -->
    <SolidColorBrush x:Key="ClaudeChat.HoverBackground" Color="#505A5D5E" />    <!-- toolbar.hoverBackground -->
    <SolidColorBrush x:Key="ClaudeChat.OptionBorder" Color="#1AFFFFFF" />       <!-- the inner line of an option -->
    <SolidColorBrush x:Key="ClaudeChat.TimelineLine" Color="#2A2B2C" />         <!-- sideBarActivityBarTop.border -->
    <SolidColorBrush x:Key="ClaudeChat.Dot" Color="#8C8C8C" />                  <!-- descriptionForeground -->
    <SolidColorBrush x:Key="ClaudeChat.DotSucceeded" Color="#74C991" />         <!-- the extension's own dot colors -->
    <SolidColorBrush x:Key="ClaudeChat.DotFailed" Color="#C74E39" />
    <SolidColorBrush x:Key="ClaudeChat.DotRejected" Color="#E1C08D" />
    <SolidColorBrush x:Key="ClaudeChat.ToolBackground" Color="#121314" />       <!-- editor.background -->
    <SolidColorBrush x:Key="ClaudeChat.CodeBackground" Color="#262626" />       <!-- textPreformat.background -->
    <SolidColorBrush x:Key="ClaudeChat.CodeForeground" Color="#8C8C8C" />       <!-- textPreformat.foreground -->
    <SolidColorBrush x:Key="ClaudeChat.CodeBlockBackground" Color="#242526" />  <!-- textCodeBlock.background -->
    <SolidColorBrush x:Key="ClaudeChat.PillBackground" Color="#1ABFBFBF" />     <!-- foreground at 10 % -->
    <SolidColorBrush x:Key="ClaudeChat.PillHoverBackground" Color="#2EBFBFBF" /> <!-- foreground at 18 % -->
    <SolidColorBrush x:Key="ClaudeChat.SendBackground" Color="#C6613F" />       <!-- the send button, default mode -->
    <SolidColorBrush x:Key="ClaudeChat.SendForeground" Color="#FAF9F5" />
    <SolidColorBrush x:Key="ClaudeChat.FocusRing" Color="#D97757" />            <!-- the reply box with the focus, default mode -->
    <SolidColorBrush x:Key="ClaudeChat.Spinner" Color="#D97757" />              <!-- the working line's dot, default mode -->
    <!-- the reply box's shadow, and its ring with the focus: the mode's color at 12 % -->
    <BoxShadows x:Key="ClaudeChat.ComposerShadow">0 1 2 0 #1A000000</BoxShadows>
    <BoxShadows x:Key="ClaudeChat.ComposerFocusShadow">0 0 0 3 #1FD97757</BoxShadows>
    <BoxShadows x:Key="ClaudeChat.ComposerFocusShadowAcceptEdits">0 0 0 3 #1FBFBFBF</BoxShadows>
    <BoxShadows x:Key="ClaudeChat.ComposerFocusShadowPlan">0 0 0 3 #153994BC</BoxShadows>
    <BoxShadows x:Key="ClaudeChat.ComposerFocusShadowAuto">0 0 0 3 #1FF48771</BoxShadows>
    <!-- the diff: the extension draws it with the editor's vs-dark theme, whatever the VS Code theme -->
    <SolidColorBrush x:Key="ClaudeChat.DiffBackground" Color="#1E1E1E" />
    <SolidColorBrush x:Key="ClaudeChat.DiffForeground" Color="#D4D4D4" />
    <SolidColorBrush x:Key="ClaudeChat.DiffRemoved" Color="#33FF0000" />        <!-- diffEditor.removedLineBackground -->
    <SolidColorBrush x:Key="ClaudeChat.DiffAdded" Color="#339BB955" />          <!-- diffEditor.insertedLineBackground -->
    <SolidColorBrush x:Key="ClaudeChat.DiffRemovedText" Color="#33FF0000" />    <!-- diffEditor.removedTextBackground -->
    <SolidColorBrush x:Key="ClaudeChat.DiffAddedText" Color="#339CCC2C" />      <!-- diffEditor.insertedTextBackground -->
    <SolidColorBrush x:Key="ClaudeChat.DiffHatch" Color="#33CCCCCC" />          <!-- diffEditor.diagonalFill -->
    <SolidColorBrush x:Key="ClaudeChat.DiffGuide" Color="#404040" />            <!-- editorIndentGuide.background1 -->
    <SolidColorBrush x:Key="ClaudeChat.DiffCurrentLine" Color="#282828" />      <!-- editor.lineHighlightBorder -->
    <SolidColorBrush x:Key="ClaudeChat.DiffSign" Color="#4C4C4C" />
    <!-- the old side's shadow on the new one, and the fade of a diff cut at 200 px -->
    <LinearGradientBrush x:Key="ClaudeChat.DiffShadow" StartPoint="0%,0%" EndPoint="100%,0%">
      <GradientStop Offset="0" Color="#00000000" />
      <GradientStop Offset="0.5" Color="#14000000" />
      <GradientStop Offset="0.8" Color="#47000000" />
      <GradientStop Offset="1" Color="#8A000000" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ClaudeChat.DiffFade" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#001E1E1E" />
      <GradientStop Offset="1" Color="#1E1E1E" />
    </LinearGradientBrush>

    <!-- fonts: VS Code's on Windows (the interface's and the editor's) -->
    <FontFamily x:Key="ClaudeChat.FontFamily">Segoe UI, Segoe WPC, Inter, sans-serif</FontFamily>
    <FontFamily x:Key="ClaudeChat.MonoFontFamily">Consolas, Courier New, monospace</FontFamily>
    <x:Double x:Key="ClaudeChat.FontSize">13</x:Double>
    <x:Double x:Key="ClaudeChat.LineHeight">19.5</x:Double>          <!-- line-height: 1.5 -->
    <x:Double x:Key="ClaudeChat.SmallFontSize">11.05</x:Double>      <!-- .85em: times, paths, the line under a tool -->
    <x:Double x:Key="ClaudeChat.SmallLineHeight">16.575</x:Double>
    <x:Double x:Key="ClaudeChat.CodeFontSize">11.7</x:Double>        <!-- .9em: inline code and code blocks -->
    <x:Double x:Key="ClaudeChat.EditorFontSize">14</x:Double>        <!-- the editor's: the diff -->
    <x:Double x:Key="ClaudeChat.EditorLineHeight">19</x:Double>
    <x:Double x:Key="ClaudeChat.PromptFontSize">14.3</x:Double>      <!-- 1.1em: the permission request -->
    <x:Double x:Key="ClaudeChat.PromptLineHeight">21.45</x:Double>
    <x:Double x:Key="ClaudeChat.PromptCodeFontSize">12.87</x:Double> <!-- .9em of the request -->

    <!-- places -->
    <Thickness x:Key="ClaudeChat.ListPadding">20,20,20,40</Thickness>
    <x:Double x:Key="ClaudeChat.ComposerMaxWidth">680</x:Double>
    <x:Double x:Key="ClaudeChat.ScrollBarGutter">16</x:Double>

    <!-- icons, drawn on the 26 px box of the extension's bar (20 px for send, 16 px for the thinking arrow) -->
    <StreamGeometry x:Key="ClaudeChat.Icon.ModeDefault">M9.6,13.3 L9.6,9.6 M11.9,12.5 L11.9,7.6 M14.2,12.5 L14.2,7.6 M16.5,13.3 L16.5,9.9 M9.6,13.3 L9.6,14.3 C9.6,17.3 11.3,19.1 13.4,19.1 C15.5,19.1 17.6,17.4 17.6,14.6 L17.6,13.3 M9.6,14.6 L8.2,12.8</StreamGeometry>
    <StreamGeometry x:Key="ClaudeChat.Icon.ModeAcceptEdits">M10.4,9.9 L6.5,13 L10.4,16.1 M15.6,9.9 L19.5,13 L15.6,16.1 M14.2,8.3 L11.8,17.7</StreamGeometry>
    <StreamGeometry x:Key="ClaudeChat.Icon.ModePlan">M9.1,7.2 L16.9,7.2 C17.5,7.2 18,7.7 18,8.3 L18,17.7 C18,18.3 17.5,18.8 16.9,18.8 L9.1,18.8 C8.5,18.8 8,18.3 8,17.7 L8,8.3 C8,7.7 8.5,7.2 9.1,7.2 Z M10.4,10.9 L15.6,10.9 M10.4,13.5 L15.6,13.5 M10.4,16.1 L13.6,16.1</StreamGeometry>
    <StreamGeometry x:Key="ClaudeChat.Icon.ModeAuto">M14.2,6.8 L8.6,13.8 L13,13.8 L11.8,19.2 L17.4,12.2 L13,12.2 Z</StreamGeometry>
    <!-- the arrow of send, on the extension's 20 px icon: from 3 to 17, its point 10.7 wide -->
    <StreamGeometry x:Key="ClaudeChat.Icon.Send">M10,17 L10,3 M4.65,8.35 L10,3 L15.35,8.35</StreamGeometry>
    <StreamGeometry x:Key="ClaudeChat.Icon.Chevron">M6.2,4.4 L9.8,8 L6.2,11.6</StreamGeometry>

    <!-- one template per item; the list picks the one that matches -->
    <controls:ChatItemTemplates x:Key="ClaudeChat.ItemTemplates">

      <!-- the user's message: its time, then a box as wide as the list -->
      <DataTemplate DataType="cvc:UserMessageItem">
        <StackPanel Classes="ClaudeChatUserTurn">
          <TextBlock Classes="ClaudeChatStamp"
                     IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock.Text>
              <MultiBinding Converter="{x:Static controls:ChatConverters.Time}">
                <Binding Path="Timestamp" />
                <Binding Path="$parent[controls:ClaudeChatView].Strings" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
          <Border Classes="ClaudeChatUser">
            <SelectableTextBlock Classes="ClaudeChatUserText"
                                 Text="{Binding Text, Converter={x:Static controls:ChatConverters.Clip}}" />
          </Border>
        </StackPanel>
      </DataTemplate>

      <DataTemplate DataType="cvc:AssistantTextItem">
        <controls:ChatTimelineRow>
          <controls:ChatTimelineRow.Stamp>
            <MultiBinding Converter="{x:Static controls:ChatConverters.Time}">
              <Binding Path="Timestamp" />
              <Binding Path="$parent[controls:ClaudeChatView].Strings" />
            </MultiBinding>
          </controls:ChatTimelineRow.Stamp>
          <controls:MarkdownBlock Classes="ClaudeChatAnswer" Markdown="{Binding Text}" />
        </controls:ChatTimelineRow>
      </DataTemplate>

      <!-- "Thinking", and the arrow after it when there is something to open -->
      <DataTemplate DataType="cvc:ThinkingItem">
        <controls:ChatTimelineRow>
          <StackPanel>
            <ToggleButton Classes="ClaudeChatDisclosure" HorizontalAlignment="Left"
                          IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                          IsHitTestVisible="{Binding Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                          Focusable="{Binding Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <StackPanel Classes="ClaudeChatThinkingSummary" Orientation="Horizontal">
                <!-- "Thinking" while it arrives (or when its length is unknown), then "Thought for 3s" -->
                <TextBlock Classes="ClaudeChatThinkingLabel">
                  <TextBlock.Text>
                    <MultiBinding Converter="{x:Static controls:ChatConverters.ThinkingLabel}">
                      <Binding Path="IsStreaming" />
                      <Binding Path="DurationMs" />
                      <Binding Path="$parent[controls:ClaudeChatView].Strings" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
                <Path Classes="ClaudeChatChevron"
                      IsVisible="{Binding Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </ToggleButton>
            <TextBlock Classes="ClaudeChatThought"
                       Text="{Binding Text, Converter={x:Static controls:ChatConverters.Clip}}">
              <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="IsExpanded" />
                  <Binding Path="Text" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                </MultiBinding>
              </TextBlock.IsVisible>
            </TextBlock>
          </StackPanel>
        </controls:ChatTimelineRow>
      </DataTemplate>

      <DataTemplate DataType="cvc:ToolCallItem">
        <controls:ToolCallView />
      </DataTemplate>

      <DataTemplate DataType="cvc:TurnFooterItem">
        <TextBlock Classes="ClaudeChatFooter"
                   IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock.Text>
            <MultiBinding Converter="{x:Static controls:ChatConverters.Footer}">
              <Binding />
              <Binding Path="$parent[controls:ClaudeChatView].Strings" />
            </MultiBinding>
          </TextBlock.Text>
        </TextBlock>
      </DataTemplate>

      <DataTemplate DataType="cvc:NoticeItem">
        <TextBlock Classes="ClaudeChatNotice"
                   Classes.failed="{Binding Kind, Converter={x:Static controls:ChatConverters.IsTurnFailed}}">
          <TextBlock.Text>
            <MultiBinding Converter="{x:Static controls:ChatConverters.Notice}">
              <Binding Path="Kind" />
              <Binding Path="$parent[controls:ClaudeChatView].Strings" />
            </MultiBinding>
          </TextBlock.Text>
        </TextBlock>
      </DataTemplate>

    </controls:ChatItemTemplates>
  </Styles.Resources>

  <!-- ===== the view and its lists ===== -->

  <Style Selector="controls|ClaudeChatView">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="FontFamily" Value="{DynamicResource ClaudeChat.FontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.FontSize}" />
  </Style>

  <Style Selector="ItemsControl.ClaudeChatItems">
    <Setter Property="ItemTemplate" Value="{DynamicResource ClaudeChat.ItemTemplates}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
          <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <!-- the conversation's list: its items, then the "Working…" line, inside ClaudeChat.ListPadding -->
  <Style Selector="controls|ChatItemList">
    <Setter Property="Padding" Value="{DynamicResource ClaudeChat.ListPadding}" />
    <Setter Property="ItemTemplate" Value="{DynamicResource ClaudeChat.ItemTemplates}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
          <controls:ChatListBody>
            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
            <ContentPresenter Name="PART_Footer" Content="{TemplateBinding Footer}" />
          </controls:ChatListBody>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- "Working…" at the end of the list: 4 px under it, 1.85em high; the dot in the extension's 24 px icon column,
       the text after it in medium weight -->
  <Style Selector="Panel.ClaudeChatWorking">
    <Setter Property="Margin" Value="0,4,0,0" />
    <Setter Property="Height" Value="24" />
  </Style>
  <Style Selector="Ellipse.ClaudeChatWorkingDot">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="9,0,0,0" />
    <Setter Property="Fill" Value="{DynamicResource ClaudeChat.Spinner}" />
  </Style>
  <!-- it blinks only while the line shows (class "on", set with its visibility): hidden, the clock does not run -->
  <Style Selector="Panel.ClaudeChatWorking.on Ellipse.ClaudeChatWorkingDot">
    <Style.Animations>
      <Animation Duration="0:0:1" IterationCount="Infinite">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Panel.ClaudeChatWorking.acceptEdits Ellipse.ClaudeChatWorkingDot">
    <Setter Property="Fill" Value="{DynamicResource ClaudeChat.Foreground}" />
  </Style>
  <Style Selector="Panel.ClaudeChatWorking.plan Ellipse.ClaudeChatWorkingDot">
    <Setter Property="Fill" Value="{DynamicResource ClaudeChat.AccentFill}" />
  </Style>
  <Style Selector="Panel.ClaudeChatWorking.auto Ellipse.ClaudeChatWorkingDot">
    <Setter Property="Fill" Value="{DynamicResource ClaudeChat.Error}" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatWorkingText">
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.LineHeight}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="28,0,0,0" />
    <Setter Property="RenderTransform" Value="translate(0px,1px)" />
  </Style>

  <!-- ===== shared pieces ===== -->

  <!-- the time over a message: .85em, 16 px lines, at the right -->
  <Style Selector="TextBlock.ClaudeChatStamp">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.SmallFontSize}" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="RenderTransform" Value="translate(0px,1px)" />
  </Style>

  <!-- a flat toggle: a thought, or a subagent's work -->
  <Style Selector="ToggleButton.ClaudeChatDisclosure">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.FontSize}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
    <Setter Property="Transitions" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_Disclosure"
                          Background="{TemplateBinding Background}"
                          Padding="{TemplateBinding Padding}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.ClaudeChatDisclosure:focus-visible /template/ ContentPresenter#PART_Disclosure">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.HoverBackground}" />
  </Style>

  <!-- the arrow after "Thinking" and a subagent: 16 px, turned down when open -->
  <Style Selector="Path.ClaudeChatChevron">
    <Setter Property="Data" Value="{DynamicResource ClaudeChat.Icon.Chevron}" />
    <Setter Property="Stroke" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="StrokeThickness" Value="0.9" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector="ToggleButton.ClaudeChatDisclosure:checked Path.ClaudeChatChevron">
    <Setter Property="RenderTransform" Value="rotate(90deg)" />
  </Style>

  <!-- ===== the timeline: a dot at 9 px, the line at 12 px, the content at 30 px; 8 px over and under ===== -->

  <Style Selector="controls|ChatTimelineRow">
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Rectangle Name="PART_Line" Width="1" HorizontalAlignment="Left" Margin="12,0,0,0"
                     Fill="{DynamicResource ClaudeChat.TimelineLine}" />
          <Ellipse Name="PART_Dot" Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Top"
                   Margin="9,15,0,0" Fill="{DynamicResource ClaudeChat.Dot}" />
          <TextBlock Name="PART_Stamp" Classes="ClaudeChatStamp" VerticalAlignment="Top"
                     Text="{TemplateBinding Stamp}" IsVisible="False" />
          <ContentPresenter Name="PART_ContentPresenter" Margin="30,8,0,8"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <!-- the first entry of a list has no space over it; an answer with its time, 24 px -->
  <Style Selector="controls|ChatTimelineRow:first /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Margin" Value="30,0,0,8" />
  </Style>
  <Style Selector="controls|ChatTimelineRow:first /template/ Ellipse#PART_Dot">
    <Setter Property="Margin" Value="9,7,0,0" />
  </Style>
  <Style Selector="controls|ChatTimelineRow:stamped /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Margin" Value="30,24,0,8" />
  </Style>
  <Style Selector="controls|ChatTimelineRow:stamped /template/ Ellipse#PART_Dot">
    <Setter Property="Margin" Value="9,31,0,0" />
  </Style>
  <Style Selector="controls|ChatTimelineRow:stamped /template/ TextBlock#PART_Stamp">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="Margin" Value="0,6,0,0" />
  </Style>
  <!-- the line starts 3 px under the first dot of a run and stops 18 px into the last entry; alone, there is none -->
  <Style Selector="controls|ChatTimelineRow:runStart /template/ Rectangle#PART_Line">
    <Setter Property="Margin" Value="12,18,0,0" />
  </Style>
  <Style Selector="controls|ChatTimelineRow:runStart:first /template/ Rectangle#PART_Line">
    <Setter Property="Margin" Value="12,10,0,0" />
  </Style>
  <Style Selector="controls|ChatTimelineRow:runStart:stamped /template/ Rectangle#PART_Line">
    <Setter Property="Margin" Value="12,34,0,0" />
  </Style>
  <Style Selector="controls|ChatTimelineRow:runEnd /template/ Rectangle#PART_Line">
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Height" Value="18" />
  </Style>
  <Style Selector="controls|ChatTimelineRow:runStart:runEnd /template/ Rectangle#PART_Line">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="controls|ChatTimelineRow.succeeded /template/ Ellipse#PART_Dot">
    <Setter Property="Fill" Value="{DynamicResource ClaudeChat.DotSucceeded}" />
  </Style>
  <Style Selector="controls|ChatTimelineRow.failed /template/ Ellipse#PART_Dot">
    <Setter Property="Fill" Value="{DynamicResource ClaudeChat.DotFailed}" />
  </Style>
  <Style Selector="controls|ChatTimelineRow.rejected /template/ Ellipse#PART_Dot">
    <Setter Property="Fill" Value="{DynamicResource ClaudeChat.DotRejected}" />
  </Style>
  <!-- a tool still running blinks, once a second -->
  <Style Selector="controls|ChatTimelineRow.running /template/ Ellipse#PART_Dot">
    <Style.Animations>
      <Animation Duration="0:0:1" IterationCount="Infinite">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- ===== items ===== -->

  <!-- the user's turn: 14 px over, 12 px under, the box as wide as the list -->
  <Style Selector="StackPanel.ClaudeChatUserTurn">
    <Setter Property="Margin" Value="0,14,0,12" />
  </Style>
  <Style Selector="Border.ClaudeChatUser">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.InputBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.InputBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="6,4" />
  </Style>
  <Style Selector="SelectableTextBlock.ClaudeChatUserText">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.LineHeight}" />
    <Setter Property="RenderTransform" Value="translate(0px,1px)" />
  </Style>

  <Style Selector="controls|MarkdownBlock.ClaudeChatAnswer">
    <Setter Property="Margin" Value="0" />
  </Style>

  <!-- "Thinking": muted at 80 %, its box sits 2 px low in the line (vertical-align: middle) -->
  <Style Selector="StackPanel.ClaudeChatThinkingSummary">
    <Setter Property="Spacing" Value="4" />
    <Setter Property="Margin" Value="0,2,0,0" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatThinkingLabel">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.LineHeight}" />
    <Setter Property="RenderTransform" Value="translate(0px,1px)" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatThought">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.LineHeight}" />
    <Setter Property="Margin" Value="0,4,0,0" />
    <Setter Property="RenderTransform" Value="translate(0px,1px)" />
  </Style>

  <Style Selector="TextBlock.ClaudeChatFooter">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.SmallFontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.SmallLineHeight}" />
    <Setter Property="Opacity" Value="0.7" />
    <Setter Property="Margin" Value="30,0,0,8" />
    <Setter Property="RenderTransform" Value="translate(0px,1px)" />
  </Style>

  <Style Selector="TextBlock.ClaudeChatNotice">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="FontStyle" Value="Italic" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.LineHeight}" />
    <Setter Property="Margin" Value="0,8" />
    <Setter Property="RenderTransform" Value="translate(0px,1px)" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatNotice.failed">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Error}" />
  </Style>

  <!-- ===== tool calls ===== -->

  <!-- the name, bold -->
  <Style Selector="TextBlock.ClaudeChatToolName">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.LineHeight}" />
    <Setter Property="Margin" Value="0,0,7.6,0" /> <!-- 4 px, and the space after the name -->
    <Setter Property="RenderTransform" Value="translate(0px,1px)" />
  </Style>
  <!-- a path or a pattern next to the name: .85em in the editor's font; a file, in the link color -->
  <Style Selector="TextBlock.ClaudeChatToolDetail">
    <Setter Property="FontFamily" Value="{DynamicResource ClaudeChat.MonoFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.SmallFontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.LineHeight}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="RenderTransform" Value="translate(0px,7px)" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatToolDetail.file">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Accent}" />
  </Style>
  <!-- a command's description, muted, in the interface's font -->
  <Style Selector="TextBlock.ClaudeChatToolDetail.plain">
    <Setter Property="FontFamily" Value="{DynamicResource ClaudeChat.FontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.FontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="RenderTransform" Value="translate(0px,1px)" />
  </Style>
  <!-- the lines a Read asked for, plain -->
  <Style Selector="TextBlock.ClaudeChatToolRange">
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.LineHeight}" />
    <Setter Property="Margin" Value="3.6,0,0,0" /> <!-- the space before it -->
    <Setter Property="RenderTransform" Value="translate(0px,1px)" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatRejected">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Warning}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.SmallFontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.LineHeight}" />
    <Setter Property="Margin" Value="8,0,0,0" />
    <Setter Property="RenderTransform" Value="translate(0px,2px)" />
  </Style>

  <!-- the line under the name ("Modified", "47 lines"): .85em, muted at 70 %, in a 21 px line -->
  <Style Selector="TextBlock.ClaudeChatSecondary">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.SmallFontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.SmallLineHeight}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Opacity" Value="0.7" />
    <Setter Property="Margin" Value="0,3,0,2" />
    <Setter Property="RenderTransform" Value="translate(0px,1px)" />
  </Style>

  <!-- "Run in background", right under the command's box (measured on the print: 4 px higher than the line above a box) -->
  <Style Selector="TextBlock.ClaudeChatSecondary.background">
    <Setter Property="Margin" Value="0,-1,0,2" />
  </Style>

  <!-- the box under a tool -->
  <Style Selector="Border.ClaudeChatToolBody">
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.InputBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.ToolBackground}" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Margin" Value="0,8" />
  </Style>
  <!-- a row of the box (IN, OUT), 4 px inside, a line between rows -->
  <Style Selector="Border.ClaudeChatToolRow">
    <Setter Property="Padding" Value="4" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.InputBorder}" />
  </Style>
  <Style Selector="Border.ClaudeChatToolRow.next">
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatToolLabel">
    <Setter Property="FontFamily" Value="{DynamicResource ClaudeChat.MonoFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.SmallFontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.SmallLineHeight}" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="Opacity" Value="0.5" />
    <Setter Property="Margin" Value="4,4,7,4" />
    <Setter Property="RenderTransform" Value="translate(0px,3px)" />
  </Style>
  <!-- what goes in a row: the editor's font at .85em, without wrapping, 60 px at most with a fade -->
  <Style Selector="Border.ClaudeChatToolContent">
    <Setter Property="Padding" Value="4" />
    <Setter Property="MaxHeight" Value="68" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="OpacityMask">
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,60">
        <GradientStop Offset="0" Color="Black" />
        <GradientStop Offset="0.8333" Color="Black" />
        <GradientStop Offset="1" Color="Transparent" />
      </LinearGradientBrush>
    </Setter>
  </Style>
  <Style Selector="Border.ClaudeChatToolContent.whole">
    <Setter Property="MaxHeight" Value="Infinity" />
    <Setter Property="OpacityMask" Value="{x:Null}" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatToolText, SelectableTextBlock.ClaudeChatToolText">
    <Setter Property="FontFamily" Value="{DynamicResource ClaudeChat.MonoFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.SmallFontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.SmallLineHeight}" />
    <Setter Property="RenderTransform" Value="translate(0px,3px)" />
  </Style>
  <Style Selector="SelectableTextBlock.ClaudeChatOutput.failed">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Error}" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatMoreLines">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.SmallFontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.SmallLineHeight}" />
    <Setter Property="RenderTransform" Value="translate(0px,1px)" />
  </Style>

  <!-- a to-do list: a box per entry (checked when done, a star while doing), 4 px apart -->
  <Style Selector="StackPanel.ClaudeChatTodos">
    <Setter Property="Spacing" Value="4" />
    <Setter Property="Margin" Value="0,8" />
  </Style>
  <Style Selector="Border.ClaudeChatTodoBox">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
    <Setter Property="Margin" Value="2,4,8,2" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.InputBorder}" />
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.InputBackground}" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatTodoMark">
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.SmallFontSize}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatTodo">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.LineHeight}" />
    <Setter Property="RenderTransform" Value="translate(0px,1px)" />
  </Style>
  <Style Selector="DockPanel.ClaudeChatTodoRow.completed">
    <Setter Property="Opacity" Value="0.7" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatTodo.completed">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="TextDecorations" Value="Strikethrough" />
    <Setter Property="Opacity" Value="0.7" />
  </Style>

  <!-- ===== the diff (its layout comes from DiffView) ===== -->

  <Style Selector="controls|DiffView">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.DiffBackground}" />
  </Style>
  <Style Selector="Panel.ClaudeChatDiffRow">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.DiffBackground}" />
  </Style>
  <Style Selector="Border.ClaudeChatDiffLine.removed">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.DiffRemoved}" />
  </Style>
  <Style Selector="Border.ClaudeChatDiffLine.added">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.DiffAdded}" />
  </Style>
  <Style Selector="Run.ClaudeChatDiffChanged.removed">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.DiffRemovedText}" />
  </Style>
  <Style Selector="Run.ClaudeChatDiffChanged.added">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.DiffAddedText}" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatDiffText">
    <Setter Property="FontFamily" Value="{DynamicResource ClaudeChat.MonoFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.EditorFontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.EditorLineHeight}" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.DiffForeground}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="RenderTransform" Value="translate(0px,4px)" />
  </Style>
  <Style Selector="Rectangle.ClaudeChatDiffGuide">
    <Setter Property="Fill" Value="{DynamicResource ClaudeChat.DiffGuide}" />
  </Style>
  <Style Selector="Border.ClaudeChatDiffCurrentLine">
    <Setter Property="Height" Value="{DynamicResource ClaudeChat.EditorLineHeight}" />
    <Setter Property="BorderThickness" Value="0,2" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.DiffCurrentLine}" />
  </Style>
  <Style Selector="Border.ClaudeChatDiffSign">
    <Setter Property="Width" Value="5" />
    <Setter Property="Height" Value="5" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.DiffSign}" />
  </Style>
  <Style Selector="Border.ClaudeChatDiffHatch">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.DiffHatch}" />
  </Style>
  <Style Selector="Rectangle.ClaudeChatDiffShadow">
    <Setter Property="Fill" Value="{DynamicResource ClaudeChat.DiffShadow}" />
  </Style>
  <Style Selector="Rectangle.ClaudeChatDiffFade">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="controls|DiffView:cut Rectangle.ClaudeChatDiffFade">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="Fill" Value="{DynamicResource ClaudeChat.DiffFade}" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatDiffGap">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.EditorLineHeight}" />
    <Setter Property="RenderTransform" Value="translate(0px,1px)" />
  </Style>

  <!-- ===== buttons =====
       A template of their own, so the app's theme (Fluent or Simple) changes neither the colors nor the size. -->

  <Style Selector="Button.ClaudeChatButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.FontSize}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
    <Setter Property="Transitions" Value="{x:Null}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_ChatButton"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Name="PART_ChatButtonContent"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- ===== the permission request: the reply box's frame, the options as the extension's buttons ===== -->

  <Style Selector="Border.ClaudeChatPermission">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.InputBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.InputBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="8" />
  </Style>
  <!-- with the focus inside, the active border at 65 % -->
  <Style Selector="Border.ClaudeChatPermission:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.PermissionActiveBorder}" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatPermissionTitle">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.PromptFontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.PromptLineHeight}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="RenderTransform" Value="translate(0px,1px)" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatPermissionMore">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.SmallFontSize}" />
    <Setter Property="Margin" Value="12,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- the command: the editor's font at .9em of the request, as it will run -->
  <Style Selector="Border.ClaudeChatPermissionSummary">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="SelectableTextBlock.ClaudeChatPermissionSummaryText">
    <Setter Property="FontFamily" Value="{DynamicResource ClaudeChat.MonoFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.PromptCodeFontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.PromptLineHeight}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="RenderTransform" Value="translate(0px,5px)" />
  </Style>
  <Style Selector="StackPanel.ClaudeChatPermissionOptions">
    <Setter Property="Spacing" Value="8" />
    <Setter Property="Margin" Value="0,8,0,0" />
  </Style>
  <Style Selector="Button.ClaudeChatOption">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.OptionBorder}" />
    <Setter Property="Padding" Value="7,5" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <!-- the option the keys answer with: the accent, bold, white on it -->
  <Style Selector="Button.ClaudeChatOption.selected">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.AccentFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.AccentFill}" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.AccentForeground}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.ClaudeChatOption:pointerover /template/ Border#PART_ChatButton">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.HoverBackground}" />
  </Style>
  <Style Selector="Button.ClaudeChatOption.selected:pointerover /template/ Border#PART_ChatButton">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.AccentFill}" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatOptionNumber">
    <Setter Property="Opacity" Value="0.6" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatOptionText">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- what to tell Claude: an option's frame, the active border with the focus -->
  <Style Selector="TextBox.ClaudeChatField">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="CaretBrush" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.OptionBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="7,5" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.FontSize}" />
    <Setter Property="Margin" Value="0,8,0,0" />
  </Style>
  <Style Selector="TextBox.ClaudeChatField /template/ Border#PART_BorderElement, TextBox.ClaudeChatField:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.OptionBorder}" />
  </Style>
  <Style Selector="TextBox.ClaudeChatField:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.InputActiveBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- ===== the reply box: 680 px, 8 px corners, the text over a bar of 36 px ===== -->

  <Style Selector="Border.ClaudeChatComposer">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.InputBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.InputBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BoxShadow" Value="{DynamicResource ClaudeChat.ComposerShadow}" />
  </Style>
  <!-- with the focus inside, a ring in the color of the mode -->
  <Style Selector="Border.ClaudeChatComposer:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.FocusRing}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ClaudeChat.ComposerFocusShadow}" />
  </Style>
  <Style Selector="Border.ClaudeChatComposer.acceptEdits:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ClaudeChat.ComposerFocusShadowAcceptEdits}" />
  </Style>
  <Style Selector="Border.ClaudeChatComposer.plan:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.FocusBorder}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ClaudeChat.ComposerFocusShadowPlan}" />
  </Style>
  <Style Selector="Border.ClaudeChatComposer.auto:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.Error}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ClaudeChat.ComposerFocusShadowAuto}" />
  </Style>

  <!-- the text: 10 px over and under, 14 px at the left, 36 px at the right; no frame of its own, in any state -->
  <Style Selector="TextBox.ClaudeChatInput">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="CaretBrush" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="14,10,36,10" />
    <Setter Property="MinHeight" Value="39.5" />
    <Setter Property="MaxHeight" Value="200" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.FontSize}" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>
  <Style Selector="TextBox.ClaudeChatInput /template/ Border#PART_BorderElement, TextBox.ClaudeChatInput:pointerover /template/ Border#PART_BorderElement, TextBox.ClaudeChatInput:focus /template/ Border#PART_BorderElement, TextBox.ClaudeChatInput:disabled /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="TextBox.ClaudeChatInput /template/ TextBlock#PART_Watermark, TextBox.ClaudeChatField /template/ TextBlock#PART_Watermark">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.InputPlaceholder}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="TextBox.ClaudeChatInput:pointerover /template/ TextBlock#PART_Watermark, TextBox.ClaudeChatInput:focus /template/ TextBlock#PART_Watermark, TextBox.ClaudeChatField:pointerover /template/ TextBlock#PART_Watermark, TextBox.ClaudeChatField:focus /template/ TextBlock#PART_Watermark">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.InputPlaceholder}" />
  </Style>

  <!-- the bar under the text: a line over it, 5 px inside, 2 px between its pieces -->
  <Style Selector="Border.ClaudeChatComposerBar">
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.InputBorder}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="5" />
  </Style>

  <!-- the pickers: a template of their own (the list opens upward, in the app's theme for its entries) -->
  <Style Selector="ComboBox.ClaudeChatPicker">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.SmallFontSize}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_PickerBox"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <Panel>
              <TextBlock Name="PlaceholderTextBlock" VerticalAlignment="Center"
                         Text="{TemplateBinding PlaceholderText}"
                         Foreground="{TemplateBinding PlaceholderForeground}"
                         IsVisible="{TemplateBinding SelectionBoxItem, Converter={x:Static ObjectConverters.IsNull}}" />
              <ContentControl Name="ContentPresenter" VerticalAlignment="Center"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding ItemTemplate}" />
            </Panel>
          </Border>
          <Popup Name="PART_Popup"
                 IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                 MaxHeight="{TemplateBinding MaxDropDownHeight}"
                 PlacementTarget="PART_PickerBox"
                 Placement="Top"
                 IsLightDismissEnabled="True"
                 WindowManagerAddShadowHint="False">
            <Border Classes="ClaudeChatPickerMenu">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
              </ScrollViewer>
            </Border>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Border.ClaudeChatPickerMenu">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.InputBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style Selector="ComboBox.ClaudeChatPicker:pointerover /template/ Border#PART_PickerBox, ComboBox.ClaudeChatPicker:focus-visible /template/ Border#PART_PickerBox">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.HoverBackground}" />
  </Style>
  <!-- the mode: its icon on 26 px and its name, 8 px after it -->
  <Style Selector="ComboBox.ClaudeChatModePicker">
    <Setter Property="Height" Value="26" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="0,0,8,0" />
  </Style>
  <Style Selector="Path.ClaudeChatModeIcon">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Stroke" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="StrokeThickness" Value="0.85" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatModeLabel">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- the model: a round pill, 18 px high -->
  <Style Selector="ComboBox.ClaudeChatModelPicker">
    <Setter Property="Height" Value="18" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Margin" Value="6,0,0,0" />
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.PillBackground}" />
  </Style>
  <Style Selector="ComboBox.ClaudeChatModelPicker:pointerover /template/ Border#PART_PickerBox">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.PillHoverBackground}" />
  </Style>
  <!-- a model asked for and not yet confirmed by the claude -->
  <Style Selector="ComboBox.ClaudeChatPicker.pending">
    <Setter Property="FontStyle" Value="Italic" />
  </Style>

  <!-- send and stop: one 26 px square, in the color of the mode -->
  <Style Selector="Button.ClaudeChatSend, Button.ClaudeChatStop">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.SendBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.SendForeground}" />
  </Style>
  <!-- with the keyboard on it, a 1 px line in focusBorder just inside its edge (outline 1px, offset -1px) -->
  <Style Selector="Button.ClaudeChatSend:focus-visible /template/ Border#PART_ChatButton, Button.ClaudeChatStop:focus-visible /template/ Border#PART_ChatButton">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.FocusBorder}" />
  </Style>
  <Style Selector="Border.ClaudeChatComposer.acceptEdits Button.ClaudeChatSend, Border.ClaudeChatComposer.acceptEdits Button.ClaudeChatStop">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ToolBackground}" />
  </Style>
  <Style Selector="Border.ClaudeChatComposer.plan Button.ClaudeChatSend, Border.ClaudeChatComposer.plan Button.ClaudeChatStop">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.AccentFill}" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.AccentForeground}" />
  </Style>
  <Style Selector="Border.ClaudeChatComposer.auto Button.ClaudeChatSend, Border.ClaudeChatComposer.auto Button.ClaudeChatStop">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.Error}" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.AccentForeground}" />
  </Style>
  <Style Selector="Button.ClaudeChatSend:disabled">
    <Setter Property="Opacity" Value="0.4" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>
  <Style Selector="Path.ClaudeChatSendIcon">
    <Setter Property="Data" Value="{DynamicResource ClaudeChat.Icon.Send}" />
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector="Border.ClaudeChatStopIcon">
    <Setter Property="Width" Value="11" />
    <Setter Property="Height" Value="11" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{Binding $parent[Button].Foreground}" />
  </Style>

  <!-- ===== markdown (only inside a MarkdownBlock) ===== -->

  <Style Selector="controls|MarkdownBlock ctb|CTextBlock">
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.LineHeight}" />
    <Setter Property="Margin" Value="0,1.3,0,2.6" />
    <Setter Property="RenderTransform" Value="translate(0px,1px)" />
  </Style>
  <Style Selector="controls|MarkdownBlock StackPanel > ctb|CTextBlock:nth-child(1)">
    <Setter Property="Margin" Value="0,0,0,2.6" />
  </Style>
  <Style Selector="controls|MarkdownBlock ctb|CTextBlock.Heading1">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="NaN" />
    <Setter Property="Margin" Value="0,10,0,4" />
  </Style>
  <Style Selector="controls|MarkdownBlock ctb|CTextBlock.Heading2">
    <Setter Property="FontSize" Value="19.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="NaN" />
    <Setter Property="Margin" Value="0,10,0,4" />
  </Style>
  <Style Selector="controls|MarkdownBlock ctb|CTextBlock.Heading3">
    <Setter Property="FontSize" Value="15.2" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="NaN" />
    <Setter Property="Margin" Value="0,8,0,3" />
  </Style>
  <Style Selector="controls|MarkdownBlock ctb|CTextBlock.Heading4, controls|MarkdownBlock ctb|CTextBlock.Heading5, controls|MarkdownBlock ctb|CTextBlock.Heading6">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,6,0,2" />
  </Style>
  <Style Selector="controls|MarkdownBlock ctb|CHyperlink">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Accent}" />
    <Setter Property="IsUnderline" Value="True" />
  </Style>
  <!-- inline code: .9em in the editor's font, 2 px by 4 px inside, 3 px corners -->
  <Style Selector="controls|MarkdownBlock ctb|CCode">
    <Setter Property="MonospaceFontFamily" Value="{DynamicResource ClaudeChat.MonoFontFamily}" />
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.CodeBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.CodeForeground}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.CodeFontSize}" />
    <Setter Property="Padding" Value="4,4,4,0" /> <!-- 2 px by 4 px in the CSS; the text sits 2 px higher here -->
    <Setter Property="CornerRadius" Value="3" />
  </Style>
  <!-- a code block: 8 px inside, 4 px corners, 8 px over and under -->
  <Style Selector="controls|MarkdownBlock Border.CodeBlock">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.CodeBlockBackground}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="Margin" Value="0,8" />
  </Style>
  <!-- only sideways: the list is the one that scrolls up and down -->
  <Style Selector="controls|MarkdownBlock ScrollViewer.CodeBlock">
    <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
  </Style>
  <Style Selector="controls|MarkdownBlock TextBlock.CodeBlock">
    <Setter Property="FontFamily" Value="{DynamicResource ClaudeChat.MonoFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.CodeFontSize}" />
    <Setter Property="LineHeight" Value="17.55" />
    <Setter Property="RenderTransform" Value="translate(0px,4px)" />
  </Style>
  <Style Selector="controls|MarkdownBlock Grid.List">
    <Setter Property="Margin" Value="10,0,0,0" />
  </Style>
  <Style Selector="controls|MarkdownBlock ctb|CTextBlock.ListMarker">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="Margin" Value="0,1.3,8,2.6" />
  </Style>
  <Style Selector="controls|MarkdownBlock Border.Blockquote">
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.BorderStrong}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="Padding" Value="10,0,0,0" />
    <Setter Property="Margin" Value="0,4" />
  </Style>
  <Style Selector="controls|MarkdownBlock Border.Blockquote ctb|CTextBlock">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
  </Style>
  <Style Selector="controls|MarkdownBlock Border.Table">
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.InputBorder}" />
    <Setter Property="BorderThickness" Value="0,0,1,1" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Margin" Value="0,4" />
  </Style>
  <Style Selector="controls|MarkdownBlock Grid.Table > Border">
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.InputBorder}" />
    <Setter Property="BorderThickness" Value="1,1,0,0" />
    <Setter Property="Padding" Value="2" />
  </Style>
  <Style Selector="controls|MarkdownBlock Border.TableHeader">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.Surface}" />
  </Style>
  <Style Selector="controls|MarkdownBlock Border.TableHeader ctb|CTextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
</Styles>
