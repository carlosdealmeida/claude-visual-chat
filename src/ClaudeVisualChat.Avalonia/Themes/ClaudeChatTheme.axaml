<!--
  The look of ClaudeChatView: the Claude Code extension for VS Code (2.1.301), measured from its webview's CSS, with
  the values of the "Dark 2026" theme of VS Code, its default dark theme (Themes/DarkModern.axaml has the Dark
  Modern ones: include it in the view's Resources). ClaudeChatView includes this file in its own Styles; the app does not
  need to do anything. To change a color, a font or a size, redefine its key (ClaudeChat.*) in the Resources of the
  ClaudeChatView.

  The touch layout (ChatLayout.Touch) has its sizes in Themes/Touch.axaml and its styles in Themes/ClaudeChatTouch.axaml.
  Its colors are here with the others (the sheets, the user's bubble, the request frame), and so are its icons and what
  the shared templates hold for it: the class touch on the user's message and on the end of a turn, and the copy button
  under a turn, which only the touch layout shows (its holder is hidden here and shown there).

  Text: Chromium puts the extra space of a line half above and half below the letters; Avalonia 11.0 puts it all
  below, and places Consolas from its hhea ascent where Chromium on Windows uses the OS/2 one. So texts that must sit
  where the extension's sit are moved down with a RenderTransform (it moves the drawing, not the layout): 1 px for
  Segoe UI in a 1.5 line, 4 px for Consolas.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cvc="using:ClaudeVisualChat"
        xmlns:controls="using:ClaudeVisualChat.Controls"
        xmlns:ctb="clr-namespace:ColorTextBlock.Avalonia;assembly=ColorTextBlock.Avalonia"
        x:CompileBindings="True">

  <Styles.Resources>
    <!-- colors: the VS Code variable each one stands for, with its value in the "Dark 2026" theme of VS Code (its
         default dark theme since 1.142). Themes/DarkModern.axaml has the Dark Modern values of those that come from the
         VS Code theme; the others (the extension's own, like the dots, the send button and the inner line of an option, and
         the touch layout's request frame) are the same in both and are only here. -->
    <SolidColorBrush x:Key="ClaudeChat.Background" Color="#191A1B" />           <!-- sideBar.background -->
    <SolidColorBrush x:Key="ClaudeChat.Surface" Color="#202122" />              <!-- editorWidget.background: table headers -->
    <SolidColorBrush x:Key="ClaudeChat.Border" Color="#2A2B2C" />               <!-- widget.border -->
    <SolidColorBrush x:Key="ClaudeChat.BorderStrong" Color="#333536" />         <!-- input.border -->
    <SolidColorBrush x:Key="ClaudeChat.Foreground" Color="#BFBFBF" />           <!-- foreground -->
    <SolidColorBrush x:Key="ClaudeChat.ForegroundMuted" Color="#8C8C8C" />      <!-- descriptionForeground -->
    <SolidColorBrush x:Key="ClaudeChat.DisabledForeground" Color="#555555" />   <!-- disabledForeground: the date line -->
    <SolidColorBrush x:Key="ClaudeChat.Accent" Color="#48A0C7" />               <!-- textLink.foreground -->
    <SolidColorBrush x:Key="ClaudeChat.AccentFill" Color="#297AA0" />           <!-- button.background -->
    <SolidColorBrush x:Key="ClaudeChat.AccentForeground" Color="#FFFFFF" />     <!-- button.foreground -->
    <SolidColorBrush x:Key="ClaudeChat.FocusBorder" Color="#B33994BC" />        <!-- focusBorder -->
    <SolidColorBrush x:Key="ClaudeChat.Warning" Color="#CCA700" />
    <SolidColorBrush x:Key="ClaudeChat.Error" Color="#F48771" />                <!-- errorForeground -->
    <SolidColorBrush x:Key="ClaudeChat.Success" Color="#73C991" />              <!-- gitDecoration.addedResourceForeground -->
    <SolidColorBrush x:Key="ClaudeChat.InputBackground" Color="#191A1B" />      <!-- input.background -->
    <SolidColorBrush x:Key="ClaudeChat.InputBorder" Color="#2A2B2C" />          <!-- inlineChatInput.border = editorWidget.border -->
    <SolidColorBrush x:Key="ClaudeChat.InputActiveBorder" Color="#2A2B2C" />    <!-- inputOption.activeBorder -->
    <SolidColorBrush x:Key="ClaudeChat.PermissionActiveBorder" Color="#A62A2B2C" /> <!-- inputOption.activeBorder at 65 % -->
    <SolidColorBrush x:Key="ClaudeChat.PermissionWarningBorder" Color="#99CCA700" /> <!-- the touch layout's request frame: Warning at 60 % -->
    <SolidColorBrush x:Key="ClaudeChat.InputPlaceholder" Color="#555555" />     <!-- input.placeholderForeground -->
    <SolidColorBrush x:Key="ClaudeChat.HoverBackground" Color="#505A5D5E" />    <!-- toolbar.hoverBackground -->
    <SolidColorBrush x:Key="ClaudeChat.OptionBorder" Color="#1AFFFFFF" />       <!-- the inner line of an option -->
    <SolidColorBrush x:Key="ClaudeChat.TimelineLine" Color="#2A2B2C" />         <!-- sideBarActivityBarTop.border -->
    <SolidColorBrush x:Key="ClaudeChat.Dot" Color="#8C8C8C" />                  <!-- descriptionForeground -->
    <SolidColorBrush x:Key="ClaudeChat.DotSucceeded" Color="#74C991" />         <!-- the extension's own dot colors -->
    <SolidColorBrush x:Key="ClaudeChat.DotFailed" Color="#C74E39" />
    <SolidColorBrush x:Key="ClaudeChat.DotRejected" Color="#E1C08D" />        <!-- not used since 0.6.0: a refused call is as red as a failed one -->
    <SolidColorBrush x:Key="ClaudeChat.ToolBackground" Color="#121314" />       <!-- editor.background -->
    <SolidColorBrush x:Key="ClaudeChat.CodeBackground" Color="#262626" />       <!-- textPreformat.background -->
    <SolidColorBrush x:Key="ClaudeChat.CodeForeground" Color="#8C8C8C" />       <!-- textPreformat.foreground -->
    <SolidColorBrush x:Key="ClaudeChat.CodeBlockBackground" Color="#242526" />  <!-- textCodeBlock.background -->
    <SolidColorBrush x:Key="ClaudeChat.PillBackground" Color="#1ABFBFBF" />     <!-- foreground at 10 % -->
    <SolidColorBrush x:Key="ClaudeChat.PillHoverBackground" Color="#2EBFBFBF" /> <!-- foreground at 18 % -->
    <SolidColorBrush x:Key="ClaudeChat.SendBackground" Color="#C6613F" />       <!-- the send button, default mode -->
    <SolidColorBrush x:Key="ClaudeChat.SendForeground" Color="#FAF9F5" />
    <SolidColorBrush x:Key="ClaudeChat.BannerTint" Color="#4A63AF" />           <!-- the Remote Control banner's blue -->
    <SolidColorBrush x:Key="ClaudeChat.RemoteControlForeground" Color="#FAF9F5" /> <!-- text on that banner -->
    <!-- the connected Remote Control chip with the pointer on it: the extension's brightness(1.1) -->
    <SolidColorBrush x:Key="ClaudeChat.RemoteControlHoverBackground" Color="#516DC1" />
    <SolidColorBrush x:Key="ClaudeChat.RemoteControlHoverForeground" Color="#FFFFFF" />
    <!-- the banners over the reply box: text and border are the tint at 50 % over foreground, the fill the tint at
         25 % over editor.background (the blue BannerTint, or errorForeground for the red one) -->
    <SolidColorBrush x:Key="ClaudeChat.BannerForeground" Color="#8591B7" />
    <SolidColorBrush x:Key="ClaudeChat.BannerBackground" Color="#20273B" />
    <SolidColorBrush x:Key="ClaudeChat.BannerErrorForeground" Color="#DAA398" />
    <SolidColorBrush x:Key="ClaudeChat.BannerErrorBackground" Color="#4B302B" />
    <SolidColorBrush x:Key="ClaudeChat.FocusRing" Color="#D97757" />            <!-- the reply box with the focus, default mode -->
    <SolidColorBrush x:Key="ClaudeChat.Spinner" Color="#D97757" />              <!-- the working line's dot, default mode -->
    <!-- an image attached to the reply box: a pill of input.background with 15 % of descriptionForeground; its border
         takes 40 % of the foreground with the pointer on it; the × fades in over the pill's end -->
    <SolidColorBrush x:Key="ClaudeChat.AttachmentBackground" Color="#2A2B2C" />
    <SolidColorBrush x:Key="ClaudeChat.AttachmentHoverBorder" Color="#666667" />
    <LinearGradientBrush x:Key="ClaudeChat.AttachmentRemoveFade" StartPoint="0%,0%" EndPoint="100%,0%">
      <GradientStop Offset="0" Color="#002A2B2C" />
      <GradientStop Offset="0.5" Color="#2A2B2C" />
      <GradientStop Offset="1" Color="#2A2B2C" />
    </LinearGradientBrush>
    <!-- a message's thumbnail under the pointer: its frame at 70 % of descriptionForeground -->
    <SolidColorBrush x:Key="ClaudeChat.ThumbnailHoverBorder" Color="#B38C8C8C" />
    <!-- the image preview: the extension's backdrop and shadow; its close button is a menu's -->
    <SolidColorBrush x:Key="ClaudeChat.PreviewOverlay" Color="#D9000000" />
    <BoxShadows x:Key="ClaudeChat.PreviewShadow">0 4 24 0 #80000000</BoxShadows>
    <!-- the Agent map: the extension's modal backdrop, and the dot of an agent at work (its status-busy green) -->
    <SolidColorBrush x:Key="ClaudeChat.ModalOverlay" Color="#BF000000" />
    <SolidColorBrush x:Key="ClaudeChat.AgentRunning" Color="#89D185" />
    <!-- the dot of a background agent's line while a request of its own (or of an agent it started) waits: the extension's blue -->
    <SolidColorBrush x:Key="ClaudeChat.AgentWaiting" Color="#3B82F6" />
    <SolidColorBrush x:Key="ClaudeChat.ContextRingTrack" Color="#26BFBFBF" />   <!-- the ring's track: the foreground at 15 % -->
    <SolidColorBrush x:Key="ClaudeChat.ContextRingFill" Color="#C6613F" />      <!-- the extension clay button orange -->
    <!-- the touch layout: the user's bubble; the sheets that rise from the bottom (the sheet, its groups, its handle and
         the veil over the view behind it). Themes/DarkModern.axaml has the same keys -->
    <SolidColorBrush x:Key="ClaudeChat.UserBubble" Color="#2A2B2C" />
    <SolidColorBrush x:Key="ClaudeChat.SheetBackground" Color="#202122" />
    <SolidColorBrush x:Key="ClaudeChat.SheetGroupBackground" Color="#2A2B2C" />
    <SolidColorBrush x:Key="ClaudeChat.SheetHandle" Color="#555555" />
    <SolidColorBrush x:Key="ClaudeChat.SheetOverlay" Color="#66000000" />
    <SolidColorBrush x:Key="ClaudeChat.MenuBackground" Color="#202122" />       <!-- menu.background -->
    <SolidColorBrush x:Key="ClaudeChat.MenuForeground" Color="#BFBFBF" />       <!-- menu.foreground -->
    <SolidColorBrush x:Key="ClaudeChat.ListHoverBackground" Color="#14FFFFFF" /> <!-- list.hoverBackground -->
    <!-- the marked row of the command palette and of the model menu -->
    <SolidColorBrush x:Key="ClaudeChat.ListActiveBackground" Color="#22FFFFFF" /> <!-- list.activeSelectionBackground -->
    <SolidColorBrush x:Key="ClaudeChat.ListActiveForeground" Color="#EDEDED" />  <!-- list.activeSelectionForeground -->
    <!-- the /context and /usage panels: the menus' frame, with VS Code's widget shadow (widget.shadow, #0000005C) -->
    <BoxShadows x:Key="ClaudeChat.PanelShadow">0 0 8 2 #5C000000</BoxShadows>
    <!-- the used categories of /context, in order: VS Code's chart colors -->
    <SolidColorBrush x:Key="ClaudeChat.ContextColor1" Color="#57A3F8" />        <!-- charts.blue -->
    <SolidColorBrush x:Key="ClaudeChat.ContextColor2" Color="#AD80D7" />        <!-- charts.purple -->
    <SolidColorBrush x:Key="ClaudeChat.ContextColor3" Color="#CD861A" />        <!-- charts.orange -->
    <SolidColorBrush x:Key="ClaudeChat.ContextColor4" Color="#86CF86" />        <!-- charts.green -->
    <SolidColorBrush x:Key="ClaudeChat.ContextColor5" Color="#E0B97F" />        <!-- charts.yellow -->
    <SolidColorBrush x:Key="ClaudeChat.ContextColor6" Color="#EF8773" />        <!-- charts.red -->
    <!-- the thumb of the effort slider -->
    <BoxShadows x:Key="ClaudeChat.EffortThumbShadow">0 1 2 0 #33000000</BoxShadows>
    <!-- the reply box's shadow, and its ring with the focus: the mode's color at 12 % -->
    <BoxShadows x:Key="ClaudeChat.ComposerShadow">0 1 2 0 #1A000000</BoxShadows>
    <BoxShadows x:Key="ClaudeChat.ComposerFocusShadow">0 0 0 3 #1FD97757</BoxShadows>
    <BoxShadows x:Key="ClaudeChat.ComposerFocusShadowAcceptEdits">0 0 0 3 #1FBFBFBF</BoxShadows>
    <BoxShadows x:Key="ClaudeChat.ComposerFocusShadowPlan">0 0 0 3 #153994BC</BoxShadows>
    <BoxShadows x:Key="ClaudeChat.ComposerFocusShadowAuto">0 0 0 3 #1FF48771</BoxShadows>
    <!-- the keyboard's focus on a cut text of a tool: a thin line inside, in the focus border color -->
    <BoxShadows x:Key="ClaudeChat.ToolContentFocusShadow">inset 0 0 0 1 #B33994BC</BoxShadows>
    <!-- the diff: the extension draws it with the editor's vs-dark theme, whatever the VS Code theme -->
    <SolidColorBrush x:Key="ClaudeChat.DiffBackground" Color="#1E1E1E" />
    <SolidColorBrush x:Key="ClaudeChat.DiffForeground" Color="#D4D4D4" />
    <SolidColorBrush x:Key="ClaudeChat.DiffRemoved" Color="#33FF0000" />        <!-- diffEditor.removedLineBackground -->
    <SolidColorBrush x:Key="ClaudeChat.DiffAdded" Color="#339BB955" />          <!-- diffEditor.insertedLineBackground -->
    <SolidColorBrush x:Key="ClaudeChat.DiffRemovedText" Color="#33FF0000" />    <!-- diffEditor.removedTextBackground -->
    <SolidColorBrush x:Key="ClaudeChat.DiffAddedText" Color="#339CCC2C" />      <!-- diffEditor.insertedTextBackground -->
    <SolidColorBrush x:Key="ClaudeChat.DiffHatch" Color="#33CCCCCC" />          <!-- diffEditor.diagonalFill -->
    <SolidColorBrush x:Key="ClaudeChat.DiffGuide" Color="#404040" />            <!-- editorIndentGuide.background1 -->
    <SolidColorBrush x:Key="ClaudeChat.DiffCurrentLine" Color="#282828" />      <!-- editor.lineHighlightBorder -->
    <SolidColorBrush x:Key="ClaudeChat.DiffSign" Color="#4C4C4C" />
    <SolidColorBrush x:Key="ClaudeChat.PlanCommentHighlight" Color="#33EA5C00" /> <!-- editor.findMatchHighlightBackground at 60 % -->
    <SolidColorBrush x:Key="ClaudeChat.SecondaryButtonBackground" Color="#313131" /> <!-- button.secondaryBackground -->
    <!-- the old side's shadow on the new one, and the fade of a diff cut at 200 px -->
    <LinearGradientBrush x:Key="ClaudeChat.DiffShadow" StartPoint="0%,0%" EndPoint="100%,0%">
      <GradientStop Offset="0" Color="#00000000" />
      <GradientStop Offset="0.5" Color="#14000000" />
      <GradientStop Offset="0.8" Color="#47000000" />
      <GradientStop Offset="1" Color="#8A000000" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ClaudeChat.DiffFade" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#001E1E1E" />
      <GradientStop Offset="1" Color="#1E1E1E" />
    </LinearGradientBrush>
    <!-- the extension's own, the same in both themes: the layer over a diff of the list darkens under the pointer, its pill "Click to
         expand" gets a light border under the pointer, and the Diff View's dialog has a soft shadow -->
    <SolidColorBrush x:Key="ClaudeChat.DiffExpandHover" Color="#0D000000" />
    <SolidColorBrush x:Key="ClaudeChat.DiffExpandPillHoverBorder" Color="#4DFFFFFF" />
    <BoxShadows x:Key="ClaudeChat.DiffViewShadow">0 4 12 0 #0D000000</BoxShadows>

    <!-- fonts: VS Code's on Windows (the interface's and the editor's) -->
    <FontFamily x:Key="ClaudeChat.FontFamily">Segoe UI, Segoe WPC, Inter, sans-serif</FontFamily>
    <FontFamily x:Key="ClaudeChat.MonoFontFamily">Consolas, Courier New, monospace</FontFamily>
    <x:Double x:Key="ClaudeChat.FontSize">13</x:Double>
    <x:Double x:Key="ClaudeChat.LineHeight">19.5</x:Double>          <!-- line-height: 1.5 -->
    <x:Double x:Key="ClaudeChat.SmallFontSize">11.05</x:Double>      <!-- .85em: times, paths, the line under a tool -->
    <x:Double x:Key="ClaudeChat.SmallLineHeight">16.575</x:Double>
    <x:Double x:Key="ClaudeChat.CodeFontSize">11.7</x:Double>        <!-- .9em: inline code and code blocks -->
    <x:Double x:Key="ClaudeChat.EditorFontSize">14</x:Double>        <!-- the editor's: the diff -->
    <x:Double x:Key="ClaudeChat.EditorLineHeight">19</x:Double>
    <x:Double x:Key="ClaudeChat.PromptFontSize">14.3</x:Double>      <!-- 1.1em: the permission request -->
    <x:Double x:Key="ClaudeChat.PromptLineHeight">21.45</x:Double>
    <x:Double x:Key="ClaudeChat.PromptCodeFontSize">12.87</x:Double> <!-- .9em of the request -->
    <x:Double x:Key="ClaudeChat.PromptHintFontSize">12.155</x:Double> <!-- .85em of the request: "Esc to cancel" -->
    <!-- the plan card's list of comments scrolls past this (the extension's clamp(4em, 70vh - 16em, 40vh) in a window of some 600 px) -->
    <x:Double x:Key="ClaudeChat.PlanCommentsMaxHeight">160</x:Double>

    <!-- places -->
    <Thickness x:Key="ClaudeChat.ListPadding">20,20,20,40</Thickness>
    <x:Double x:Key="ClaudeChat.ComposerMaxWidth">680</x:Double>
    <x:Double x:Key="ClaudeChat.ScrollBarGutter">16</x:Double>
    <x:Double x:Key="ClaudeChat.PromptDetailMaxHeight">200</x:Double>   <!-- the command or the diff of a permission request: a taller one scrolls -->
    <!-- the same while the field of option 3 is open: only the touch layout shrinks it (its keyboard leaves the view some 400 px) -->
    <x:Double x:Key="ClaudeChat.PromptDetailPeekHeight">200</x:Double>
    <!-- the field of "What went wrong?": four lines of its .9em text, with its 8 px inside and its border -->
    <x:Double x:Key="ClaudeChat.FeedbackFieldHeight">80</x:Double>

    <!-- icons, drawn on the 26 px box of the extension's bar (20 px for send, 16 px for the thinking arrow) -->
    <StreamGeometry x:Key="ClaudeChat.Icon.ModeDefault">M9.6,13.3 L9.6,9.6 M11.9,12.5 L11.9,7.6 M14.2,12.5 L14.2,7.6 M16.5,13.3 L16.5,9.9 M9.6,13.3 L9.6,14.3 C9.6,17.3 11.3,19.1 13.4,19.1 C15.5,19.1 17.6,17.4 17.6,14.6 L17.6,13.3 M9.6,14.6 L8.2,12.8</StreamGeometry>
    <StreamGeometry x:Key="ClaudeChat.Icon.ModeAcceptEdits">M10.4,9.9 L6.5,13 L10.4,16.1 M15.6,9.9 L19.5,13 L15.6,16.1 M14.2,8.3 L11.8,17.7</StreamGeometry>
    <StreamGeometry x:Key="ClaudeChat.Icon.ModePlan">M9.1,7.2 L16.9,7.2 C17.5,7.2 18,7.7 18,8.3 L18,17.7 C18,18.3 17.5,18.8 16.9,18.8 L9.1,18.8 C8.5,18.8 8,18.3 8,17.7 L8,8.3 C8,7.7 8.5,7.2 9.1,7.2 Z M10.4,10.9 L15.6,10.9 M10.4,13.5 L15.6,13.5 M10.4,16.1 L13.6,16.1</StreamGeometry>
    <StreamGeometry x:Key="ClaudeChat.Icon.ModeAuto">M14.2,6.8 L8.6,13.8 L13,13.8 L11.8,19.2 L17.4,12.2 L13,12.2 Z</StreamGeometry>
    <!-- the arrow of send, on the extension's 20 px icon: from 3 to 17, its point 10.7 wide -->
    <StreamGeometry x:Key="ClaudeChat.Icon.Send">M10,17 L10,3 M4.65,8.35 L10,3 L15.35,8.35</StreamGeometry>
    <StreamGeometry x:Key="ClaudeChat.Icon.Chevron">M6.2,4.4 L9.8,8 L6.2,11.6</StreamGeometry>
    <!-- the fold of a permission card's "Details": a 12 px arrow down, after the Codicons (MIT) chevron-down -->
    <StreamGeometry x:Key="ClaudeChat.Icon.ChevronDown">M2.6,4.3 L6,7.7 L9.4,4.3</StreamGeometry>
    <!-- and the same turned over, the card's "Expand" when it is folded (Codicons, MIT, chevron-up) -->
    <StreamGeometry x:Key="ClaudeChat.Icon.ChevronUp">M2.6,7.7 L6,4.3 L9.4,7.7</StreamGeometry>
    <!-- the bar's + and /, on its 26 px box with a 1.3 px line: a 13 px cross; a 14.3 px rounded square with a slash -->
    <StreamGeometry x:Key="ClaudeChat.Icon.Add">M13,7.15 L13,18.85 M7.15,13 L18.85,13</StreamGeometry>
    <StreamGeometry x:Key="ClaudeChat.Icon.Slash">M7.8,6.5 L18.2,6.5 A1.3,1.3 0 0 1 19.5,7.8 L19.5,18.2 A1.3,1.3 0 0 1 18.2,19.5 L7.8,19.5 A1.3,1.3 0 0 1 6.5,18.2 L6.5,7.8 A1.3,1.3 0 0 1 7.8,6.5 Z M14.95,9.1 L11.05,16.9</StreamGeometry>
    <!-- an attachment's × and the preview's close, on a 20 px box with a 1.5 px line -->
    <StreamGeometry x:Key="ClaudeChat.Icon.Remove">M5.75,5.75 L14.25,14.25 M14.25,5.75 L5.75,14.25</StreamGeometry>
    <!-- on a 16 px box, stroked like the chevron; shapes after the Codicons (MIT) clock and close -->
    <StreamGeometry x:Key="ClaudeChat.Icon.Clock">M8,2 C11.3,2 14,4.7 14,8 C14,11.3 11.3,14 8,14 C4.7,14 2,11.3 2,8 C2,4.7 4.7,2 8,2 Z M8,4.5 L8,8 L10.5,9.5</StreamGeometry>
    <StreamGeometry x:Key="ClaudeChat.Icon.Close">M3.5,3.5 L12.5,12.5 M12.5,3.5 L3.5,12.5</StreamGeometry>
    <!-- the Agent map's back arrow, on a 16 px box: after the Codicons (MIT) arrow-left -->
    <StreamGeometry x:Key="ClaudeChat.Icon.ArrowLeft">M13.5,8 L2.5,8 M7,3.5 L2.5,8 L7,12.5</StreamGeometry>
    <!-- a file's chip, on a 16 px box stroked like the chevron, drawn at 12 px: shapes after the Codicons (MIT)
         file-pdf, file-text and table -->
    <StreamGeometry x:Key="ClaudeChat.Icon.FilePdf">M3.5,1.5 L9.5,1.5 L12.5,4.5 L12.5,14.5 L3.5,14.5 Z M9.5,1.5 L9.5,4.5 L12.5,4.5 M5.5,12.5 C6.8,11.2 8,8.8 8,7.2 C8,6.3 7.2,6.3 7.1,7.2 C7,8.6 8.6,10.9 10.5,11.3</StreamGeometry>
    <StreamGeometry x:Key="ClaudeChat.Icon.FileText">M3.5,1.5 L9.5,1.5 L12.5,4.5 L12.5,14.5 L3.5,14.5 Z M9.5,1.5 L9.5,4.5 L12.5,4.5 M5.5,8 L10.5,8 M5.5,10 L10.5,10 M5.5,12 L8.5,12</StreamGeometry>
    <StreamGeometry x:Key="ClaudeChat.Icon.Table">M2.5,2.5 L13.5,2.5 L13.5,13.5 L2.5,13.5 Z M2.5,6 L13.5,6 M2.5,9.75 L13.5,9.75 M6.5,6 L6.5,13.5</StreamGeometry>
    <!-- the current model's check, on a 24 px box with a 1.5 px line (the extension's heroicons check, drawn at 16 px) -->
    <StreamGeometry x:Key="ClaudeChat.Icon.Check">M4.5,12.75 L10.5,18.75 L19.5,5.25</StreamGeometry>
    <!-- the touch layout's: on a 16 px box, stroked like the chevron; shapes after the Codicons (MIT) copy, mic and
         refresh -->
    <StreamGeometry x:Key="ClaudeChat.Icon.Copy">M4.5,3.5 L10.2,3.5 L13.5,6.8 L13.5,14.5 L4.5,14.5 Z M2.5,11.5 L2.5,1.5 L8.5,1.5</StreamGeometry>
    <StreamGeometry x:Key="ClaudeChat.Icon.Mic">M8,1.5 A2,2 0 0 1 10,3.5 L10,7.5 A2,2 0 0 1 6,7.5 L6,3.5 A2,2 0 0 1 8,1.5 Z M3.5,7.5 A4.5,4.5 0 0 0 12.5,7.5 M8,12 L8,14.5 M5.5,14.5 L10.5,14.5</StreamGeometry>
    <StreamGeometry x:Key="ClaudeChat.Icon.Refresh">M13.5,8 A5.5,5.5 0 1 1 12.1,4.3 L13.5,5.7 M13.5,2.7 L13.5,5.7 L10.5,5.7</StreamGeometry>
    <!-- the rows of the touch layout's "+" sheet, on a 16 px box, stroked like the chevron, drawn at 18 px: a picture, a
         globe, a screen and a link that leaves the app (the mode rows take the mode icons above, the commands row the slash) -->
    <StreamGeometry x:Key="ClaudeChat.Icon.Photo">M3.5,3 L12.5,3 A1.5,1.5 0 0 1 14,4.5 L14,11.5 A1.5,1.5 0 0 1 12.5,13 L3.5,13 A1.5,1.5 0 0 1 2,11.5 L2,4.5 A1.5,1.5 0 0 1 3.5,3 Z M9.4,6.5 A1.1,1.1 0 1 1 11.6,6.5 A1.1,1.1 0 1 1 9.4,6.5 Z M2.5,11.5 L6,8 L9,11 L10.5,9.5 L13,12</StreamGeometry>
    <StreamGeometry x:Key="ClaudeChat.Icon.Globe">M8,2 A6,6 0 1 1 8,14 A6,6 0 1 1 8,2 Z M2,8 L14,8 M8,2 C5,4.5 5,11.5 8,14 M8,2 C11,4.5 11,11.5 8,14</StreamGeometry>
    <StreamGeometry x:Key="ClaudeChat.Icon.Remote">M2.5,3 L13.5,3 L13.5,10 L2.5,10 Z M8,10 L8,13 M5,13 L11,13</StreamGeometry>
    <StreamGeometry x:Key="ClaudeChat.Icon.External">M12.5,9 L12.5,13 L3,13 L3,3.5 L7,3.5 M9.5,2.5 L13.5,2.5 L13.5,6.5 M13.5,2.5 L7.5,8.5</StreamGeometry>
    <!-- the row under a reply, on a 16 px box stroked like the chevron, drawn at 14 px: shapes after the Codicons (MIT) bookmark (filled
         once marked), thumbsup and thumbsdown -->
    <StreamGeometry x:Key="ClaudeChat.Icon.Bookmark">M4,1.5 L12,1.5 L12,14.5 L8,11.5 L4,14.5 Z</StreamGeometry>
    <StreamGeometry x:Key="ClaudeChat.Icon.ThumbUp">M2.5,7 L4.5,7 L4.5,14 L2.5,14 Z M4.5,7.5 L7,2.5 C7.8,2.5 8.5,3.2 8.5,4 L8.5,6.5 L12.3,6.5 C13.1,6.5 13.7,7.2 13.5,8 L12.6,12.8 C12.5,13.5 11.9,14 11.2,14 L4.5,14</StreamGeometry>
    <StreamGeometry x:Key="ClaudeChat.Icon.ThumbDown">M2.5,9 L4.5,9 L4.5,2 L2.5,2 Z M4.5,8.5 L7,13.5 C7.8,13.5 8.5,12.8 8.5,12 L8.5,9.5 L12.3,9.5 C13.1,9.5 13.7,8.8 13.5,8 L12.6,3.2 C12.5,2.5 11.9,2 11.2,2 L4.5,2</StreamGeometry>

    <!-- a message held until the claude takes it (the end of the list, under "Working…"): the bubble of a sent message, without
         its time, its date line or any action -->
    <DataTemplate x:Key="ClaudeChat.QueuedMessageTemplate" DataType="cvc:UserMessageItem">
      <StackPanel Classes="ClaudeChatUserTurn"
                  Classes.touch="{Binding $parent[controls:ClaudeChatView].Layout, Converter={x:Static controls:ChatConverters.IsTouch}}">
        <Border Classes="ClaudeChatUser">
          <StackPanel>
            <controls:MessageAttachments Images="{Binding Images}" Files="{Binding Files}"
                                         Classes.alone="{Binding Text, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
            <controls:FoldedText IsExpanded="{Binding IsTextExpanded, Mode=TwoWay}"
                                 IsVisible="{Binding Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <SelectableTextBlock Classes="ClaudeChatUserText"
                                   Text="{Binding Text, Converter={x:Static controls:ChatConverters.Clip}}" />
            </controls:FoldedText>
          </StackPanel>
        </Border>
      </StackPanel>
    </DataTemplate>

    <!-- one template per item; the list picks the one that matches -->
    <controls:ChatItemTemplates x:Key="ClaudeChat.ItemTemplates">

      <!-- the user's message: the date line when it is the first message of a day, its time (the whole date and time in its
           tooltip), then a box as wide as the list (in the touch layout, no time and a bubble at the right: the class touch, from
           the view's layout, tells the styles of Themes/ClaudeChatTouch.axaml) -->
      <DataTemplate DataType="cvc:UserMessageItem">
        <StackPanel>
          <controls:DateSeparator />
          <StackPanel Classes="ClaudeChatUserTurn"
                      Classes.touch="{Binding $parent[controls:ClaudeChatView].Layout, Converter={x:Static controls:ChatConverters.IsTouch}}">
            <!-- the time keeps its own visibility (from its text); this holder is what the touch layout hides -->
            <Panel Classes="ClaudeChatUserStamp">
              <TextBlock Classes="ClaudeChatStamp"
                         IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         ToolTip.Tip="{Binding Timestamp, Converter={x:Static controls:ChatConverters.FullTime}}">
                <TextBlock.Text>
                  <MultiBinding Converter="{x:Static controls:ChatConverters.Time}">
                    <Binding Path="Timestamp" />
                    <Binding Path="$parent[controls:ClaudeChatView].Strings" />
                    <Binding Path="$parent[controls:ClaudeChatView].ShowTimestamps" />
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </Panel>
            <Border Classes="ClaudeChatUser">
              <!-- what it took, images then files, in one row above the text (as the extension's), then the text: folded at 60 px
                   behind "Show more" when it is taller, open or folded as the item says -->
              <StackPanel>
                <controls:MessageAttachments Images="{Binding Images}" Files="{Binding Files}"
                                             Classes.alone="{Binding Text, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                <controls:FoldedText IsExpanded="{Binding IsTextExpanded, Mode=TwoWay}"
                                     IsVisible="{Binding Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <SelectableTextBlock Classes="ClaudeChatUserText"
                                       Text="{Binding Text, Converter={x:Static controls:ChatConverters.Clip}}" />
                </controls:FoldedText>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </DataTemplate>

      <DataTemplate DataType="cvc:AssistantTextItem">
        <controls:ChatTimelineRow StampTip="{Binding Timestamp, Converter={x:Static controls:ChatConverters.FullTime}}">
          <controls:ChatTimelineRow.Stamp>
            <MultiBinding Converter="{x:Static controls:ChatConverters.Time}">
              <Binding Path="Timestamp" />
              <Binding Path="$parent[controls:ClaudeChatView].Strings" />
              <Binding Path="$parent[controls:ClaudeChatView].ShowTimestamps" />
            </MultiBinding>
          </controls:ChatTimelineRow.Stamp>
          <controls:MarkdownBlock Classes="ClaudeChatAnswer" Markdown="{Binding Text}" />
        </controls:ChatTimelineRow>
      </DataTemplate>

      <!-- "Thinking", and the arrow after it when there is something to open -->
      <DataTemplate DataType="cvc:ThinkingItem">
        <controls:ChatTimelineRow>
          <StackPanel>
            <ToggleButton Classes="ClaudeChatDisclosure" HorizontalAlignment="Left"
                          Classes.interactive="{Binding Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                          IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                          IsHitTestVisible="{Binding Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                          Focusable="{Binding Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <StackPanel Classes="ClaudeChatThinkingSummary" Orientation="Horizontal">
                <!-- "Thinking" while it arrives (or when its length is unknown), then "Thought for 3s" -->
                <TextBlock Classes="ClaudeChatThinkingLabel">
                  <TextBlock.Text>
                    <MultiBinding Converter="{x:Static controls:ChatConverters.ThinkingLabel}">
                      <Binding Path="IsStreaming" />
                      <Binding Path="DurationMs" />
                      <Binding Path="$parent[controls:ClaudeChatView].Strings" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
                <Path Classes="ClaudeChatChevron"
                      IsVisible="{Binding Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </ToggleButton>
            <TextBlock Classes="ClaudeChatThought"
                       Text="{Binding Text, Converter={x:Static controls:ChatConverters.Clip}}">
              <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="IsExpanded" />
                  <Binding Path="Text" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                </MultiBinding>
              </TextBlock.IsVisible>
            </TextBlock>
          </StackPanel>
        </controls:ChatTimelineRow>
      </DataTemplate>

      <DataTemplate DataType="cvc:ToolCallItem">
        <controls:ToolCallView />
      </DataTemplate>

      <!-- the end of a turn: the row of actions under the answer (copy, bookmark and, with the host, the thumbs), then the line of
           duration, tokens and cost; in the touch layout (the class touch) the button that copies the answer instead of both, with
           the host's actions of the row beside it. The text keeps its own visibility (from its text), and so do the row and the copy
           button (from the turn); the holders are what the layout shows or hides -->
      <DataTemplate DataType="cvc:TurnFooterItem">
        <StackPanel Classes="ClaudeChatTurnEnd"
                    Classes.touch="{Binding $parent[controls:ClaudeChatView].Layout, Converter={x:Static controls:ChatConverters.IsTouch}}">
          <StackPanel Classes="ClaudeChatTurnActions" Orientation="Horizontal">
            <Panel Classes="ClaudeChatFooterCopy">
              <controls:CopyTurnButton />
            </Panel>
            <controls:ResponseActions />
          </StackPanel>
          <Panel Classes="ClaudeChatFooterLine">
            <TextBlock Classes="ClaudeChatFooter"
                       IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock.Text>
                <MultiBinding Converter="{x:Static controls:ChatConverters.Footer}">
                  <Binding />
                  <Binding Path="$parent[controls:ClaudeChatView].Strings" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
          </Panel>
        </StackPanel>
      </DataTemplate>

      <DataTemplate DataType="cvc:NoticeItem">
        <TextBlock Classes="ClaudeChatNotice"
                   Classes.failed="{Binding Kind, Converter={x:Static controls:ChatConverters.IsTurnFailed}}">
          <TextBlock.Text>
            <MultiBinding Converter="{x:Static controls:ChatConverters.Notice}">
              <Binding Path="Kind" />
              <Binding Path="$parent[controls:ClaudeChatView].Strings" />
            </MultiBinding>
          </TextBlock.Text>
        </TextBlock>
      </DataTemplate>

      <!-- what a command printed: in the timeline like an answer, without a dot, as printed -->
      <DataTemplate DataType="cvc:CommandOutputItem">
        <controls:ChatTimelineRow Classes="plain">
          <SelectableTextBlock Classes="ClaudeChatCommandOutput"
                               Text="{Binding Text, Converter={x:Static controls:ChatConverters.Clip}}" />
        </controls:ChatTimelineRow>
      </DataTemplate>

      <!-- what the conversation says about its own commands (/copy): a line, not part of the timeline -->
      <DataTemplate DataType="cvc:MetaLineItem">
        <SelectableTextBlock Classes="ClaudeChatMetaLine" Text="{Binding Text}" />
      </DataTemplate>

    </controls:ChatItemTemplates>
  </Styles.Resources>

  <!-- ===== the view and its lists ===== -->

  <Style Selector="controls|ClaudeChatView">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="FontFamily" Value="{DynamicResource ClaudeChat.FontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.FontSize}" />
  </Style>

  <Style Selector="ItemsControl.ClaudeChatItems">
    <Setter Property="ItemTemplate" Value="{DynamicResource ClaudeChat.ItemTemplates}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
          <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <!-- the conversation's list: its items, then the "Working…" line, inside ClaudeChat.ListPadding -->
  <Style Selector="controls|ChatItemList">
    <Setter Property="Padding" Value="{DynamicResource ClaudeChat.ListPadding}" />
    <Setter Property="ItemTemplate" Value="{DynamicResource ClaudeChat.ItemTemplates}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
          <controls:ChatListBody>
            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
            <ContentPresenter Name="PART_Footer" Content="{TemplateBinding Footer}" />
          </controls:ChatListBody>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- "Working…" at the end of the list: 4 px under it, 1.85em high; the dot in the extension's 24 px icon column,
       the text after it in medium weight -->
  <Style Selector="Panel.ClaudeChatWorking">
    <Setter Property="Margin" Value="0,4,0,0" />
    <Setter Property="Height" Value="24" />
  </Style>
  <Style Selector="Ellipse.ClaudeChatWorkingDot">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="9,0,0,0" />
    <Setter Property="Fill" Value="{DynamicResource ClaudeChat.Spinner}" />
  </Style>
  <!-- it blinks only while the line shows (class "on", set with its visibility): hidden, the clock does not run -->
  <Style Selector="Panel.ClaudeChatWorking.on Ellipse.ClaudeChatWorkingDot">
    <Style.Animations>
      <Animation Duration="0:0:1" IterationCount="Infinite">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Panel.ClaudeChatWorking.acceptEdits Ellipse.ClaudeChatWorkingDot">
    <Setter Property="Fill" Value="{DynamicResource ClaudeChat.Foreground}" />
  </Style>
  <Style Selector="Panel.ClaudeChatWorking.plan Ellipse.ClaudeChatWorkingDot">
    <Setter Property="Fill" Value="{DynamicResource ClaudeChat.AccentFill}" />
  </Style>
  <Style Selector="Panel.ClaudeChatWorking.auto Ellipse.ClaudeChatWorkingDot">
    <Setter Property="Fill" Value="{DynamicResource ClaudeChat.Error}" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatWorkingText">
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.LineHeight}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="28,0,0,0" />
    <Setter Property="RenderTransform" Value="translate(0px,1px)" />
  </Style>

  <!-- ===== shared pieces ===== -->

  <!-- the time over a message: .85em, 16 px lines, at the right -->
  <Style Selector="TextBlock.ClaudeChatStamp">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.SmallFontSize}" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="RenderTransform" Value="translate(0px,1px)" />
  </Style>

  <!-- the date line where the day changes: the date at .9em in disabledForeground, its wavy rules in the same color (DateSeparator
       lays them out: 7 px tall, 32 px at least, 10 px from the date, 8 px over and under) -->
  <Style Selector="controls|DateSeparator">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.DisabledForeground}" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatDateLabel">
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.CodeFontSize}" />
    <Setter Property="LineHeight" Value="17.55" />
    <Setter Property="RenderTransform" Value="translate(0px,1px)" />
  </Style>

  <!-- a flat toggle: a thought, or a subagent's work -->
  <Style Selector="ToggleButton.ClaudeChatDisclosure">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.FontSize}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
    <Setter Property="Transitions" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_Disclosure"
                          Background="{TemplateBinding Background}"
                          Padding="{TemplateBinding Padding}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.ClaudeChatDisclosure:focus-visible /template/ ContentPresenter#PART_Disclosure">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.HoverBackground}" />
  </Style>

  <!-- the arrow after "Thinking" and a subagent: 16 px, turned down when open -->
  <Style Selector="Path.ClaudeChatChevron">
    <Setter Property="Data" Value="{DynamicResource ClaudeChat.Icon.Chevron}" />
    <Setter Property="Stroke" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="StrokeThickness" Value="0.9" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector="ToggleButton.ClaudeChatDisclosure:checked Path.ClaudeChatChevron">
    <Setter Property="RenderTransform" Value="rotate(90deg)" />
  </Style>

  <!-- ===== the timeline: a dot at 9 px, the line at 12 px, the content at 30 px; 8 px over and under ===== -->

  <!-- over the entry, the date line when it is the first of a day (it hides itself otherwise): the line of the run stops over it -->
  <Style Selector="controls|ChatTimelineRow">
    <Setter Property="Template">
      <ControlTemplate>
        <DockPanel>
          <controls:DateSeparator Name="PART_Date" DockPanel.Dock="Top" />
          <Panel>
            <Rectangle Name="PART_Line" Width="1" HorizontalAlignment="Left" Margin="12,0,0,0"
                       Fill="{DynamicResource ClaudeChat.TimelineLine}" />
            <Ellipse Name="PART_Dot" Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="9,15,0,0" Fill="{DynamicResource ClaudeChat.Dot}" />
            <TextBlock Name="PART_Stamp" Classes="ClaudeChatStamp" VerticalAlignment="Top"
                       Text="{TemplateBinding Stamp}" ToolTip.Tip="{TemplateBinding StampTip}" IsVisible="False" />
            <ContentPresenter Name="PART_ContentPresenter" Margin="30,8,0,8"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Panel>
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </Style>
  <!-- the first entry of a list has no space over it; an answer with its time, 24 px -->
  <Style Selector="controls|ChatTimelineRow:first /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Margin" Value="30,0,0,8" />
  </Style>
  <Style Selector="controls|ChatTimelineRow:first /template/ Ellipse#PART_Dot">
    <Setter Property="Margin" Value="9,7,0,0" />
  </Style>
  <Style Selector="controls|ChatTimelineRow:stamped /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Margin" Value="30,24,0,8" />
  </Style>
  <Style Selector="controls|ChatTimelineRow:stamped /template/ Ellipse#PART_Dot">
    <Setter Property="Margin" Value="9,31,0,0" />
  </Style>
  <Style Selector="controls|ChatTimelineRow:stamped /template/ TextBlock#PART_Stamp">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="Margin" Value="0,6,0,0" />
  </Style>
  <!-- the line starts 3 px under the first dot of a run and stops 18 px into the last entry; alone, there is none -->
  <Style Selector="controls|ChatTimelineRow:runStart /template/ Rectangle#PART_Line">
    <Setter Property="Margin" Value="12,18,0,0" />
  </Style>
  <Style Selector="controls|ChatTimelineRow:runStart:first /template/ Rectangle#PART_Line">
    <Setter Property="Margin" Value="12,10,0,0" />
  </Style>
  <Style Selector="controls|ChatTimelineRow:runStart:stamped /template/ Rectangle#PART_Line">
    <Setter Property="Margin" Value="12,34,0,0" />
  </Style>
  <Style Selector="controls|ChatTimelineRow:runEnd /template/ Rectangle#PART_Line">
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Height" Value="18" />
  </Style>
  <Style Selector="controls|ChatTimelineRow:runStart:runEnd /template/ Rectangle#PART_Line">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="controls|ChatTimelineRow.succeeded /template/ Ellipse#PART_Dot">
    <Setter Property="Fill" Value="{DynamicResource ClaudeChat.DotSucceeded}" />
  </Style>
  <Style Selector="controls|ChatTimelineRow.failed /template/ Ellipse#PART_Dot">
    <Setter Property="Fill" Value="{DynamicResource ClaudeChat.DotFailed}" />
  </Style>
  <Style Selector="controls|ChatTimelineRow.rejected /template/ Ellipse#PART_Dot">
    <Setter Property="Fill" Value="{DynamicResource ClaudeChat.DotFailed}" />
  </Style>
  <!-- a tool still running blinks, once a second -->
  <Style Selector="controls|ChatTimelineRow.running /template/ Ellipse#PART_Dot">
    <Style.Animations>
      <Animation Duration="0:0:1" IterationCount="Infinite">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- ===== items ===== -->

  <!-- the user's turn: 14 px over, 12 px under, the box as wide as the list -->
  <Style Selector="StackPanel.ClaudeChatUserTurn">
    <Setter Property="Margin" Value="0,14,0,12" />
  </Style>
  <Style Selector="Border.ClaudeChatUser, Border.ClaudeChatStickyBubble">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.InputBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.InputBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="6,4" />
  </Style>
  <Style Selector="SelectableTextBlock.ClaudeChatUserText">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.LineHeight}" />
    <Setter Property="RenderTransform" Value="translate(0px,1px)" />
  </Style>

  <!-- the prompt pinned at the top of the list (StickyPrompt): a band of the side bar's color, 14 px over the bubble and 12 px under
       it, its last 12 px fading out; the bubble across the list's width, 40 % of the view's height at most (set by the view), scrolling
       inside, and a hand: a click goes to the start of the turn -->
  <Style Selector="Rectangle.ClaudeChatStickyFill, Rectangle.ClaudeChatStickyFade">
    <Setter Property="Fill" Value="{DynamicResource ClaudeChat.Background}" />
  </Style>
  <Style Selector="Rectangle.ClaudeChatStickyFade">
    <Setter Property="OpacityMask">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="Black" />
        <GradientStop Offset="1" Color="Transparent" />
      </LinearGradientBrush>
    </Setter>
  </Style>

  <!-- the fade at the bottom of the view: 150 px from nothing to the background, over the end of the list and under the reply box,
       so the list dims into the background over the box -->
  <Style Selector="Border.ClaudeChatListFade">
    <Setter Property="Height" Value="150" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.Background}" />
    <Setter Property="OpacityMask">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="Transparent" />
        <GradientStop Offset="1" Color="Black" />
      </LinearGradientBrush>
    </Setter>
  </Style>

  <!-- what a message took, above its text: the extension's message attachments (2.1.309), one row 6 px over the
       text; a message with nothing written has nothing under it. The thumbnails keep 4 px after each one, and the
       files come 4 px after the last (the thumbnails are buttons: their styles come after the buttons') -->
  <Style Selector="ScrollViewer.ClaudeChatMessageAttachments">
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <Style Selector="ScrollViewer.ClaudeChatMessageAttachments.alone">
    <Setter Property="Margin" Value="0" />
  </Style>
  <!-- a file there: the reply box's pill, without the × -->
  <Style Selector="Border.ClaudeChatMessageFile">
    <Setter Property="Height" Value="24" />
    <Setter Property="MaxWidth" Value="180" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.InputBorder}" />
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.AttachmentBackground}" />
  </Style>

  <!-- what a command printed: the editor's font at .9em, in the secondary color, its spaces kept -->
  <Style Selector="SelectableTextBlock.ClaudeChatCommandOutput">
    <Setter Property="FontFamily" Value="{DynamicResource ClaudeChat.MonoFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.CodeFontSize}" />
    <Setter Property="LineHeight" Value="17.55" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="RenderTransform" Value="translate(0px,4px)" />
  </Style>
  <Style Selector="controls|ChatTimelineRow.plain /template/ Ellipse#PART_Dot">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="controls|MarkdownBlock.ClaudeChatAnswer">
    <Setter Property="Margin" Value="0" />
  </Style>

  <!-- "Thinking": muted at 80 %, its box sits 2 px low in the line (vertical-align: middle) -->
  <Style Selector="StackPanel.ClaudeChatThinkingSummary">
    <Setter Property="Spacing" Value="4" />
    <Setter Property="Margin" Value="0,2,0,0" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatThinkingLabel">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.LineHeight}" />
    <Setter Property="RenderTransform" Value="translate(0px,1px)" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatThought">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.LineHeight}" />
    <Setter Property="Margin" Value="0,4,0,0" />
    <Setter Property="RenderTransform" Value="translate(0px,1px)" />
  </Style>

  <Style Selector="TextBlock.ClaudeChatFooter">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.SmallFontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.SmallLineHeight}" />
    <Setter Property="Opacity" Value="0.7" />
    <Setter Property="Margin" Value="30,0,0,8" />
    <Setter Property="RenderTransform" Value="translate(0px,1px)" />
  </Style>
  <!-- the copy button's holder: only the touch layout shows it (Themes/ClaudeChatTouch.axaml) -->
  <Style Selector="Panel.ClaudeChatFooterCopy">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- ===== the row of actions under a reply (ResponseActions), at the end of its turn: 16 px tall, 2 px between, in the answer's
       column. Buttons of 20 px, 2 px inside, 4 px corners, transparent, a 14 px icon in the secondary color; under the pointer the
       foreground on the editor's background. The row is clear until the pointer is over the end of the turn or the keyboard is in it; a
       marked bookmark, and a rated reply's thumbs and text, stay in sight. The thumb up rated is the added green, the thumb down the
       error red; the text beside them is .9em in the secondary color, 6 px after them, its link underlined ===== -->

  <Style Selector="StackPanel.ClaudeChatTurnEnd">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="controls|ResponseActions">
    <Setter Property="Height" Value="16" />
    <Setter Property="Spacing" Value="2" />
    <Setter Property="Margin" Value="30,0,0,0" />
  </Style>
  <Style Selector="Button.ClaudeChatResponseAction">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
  </Style>
  <!-- the copy and the bookmark are clear each on its own; the thumbs and their text, as one (ClaudeChatResponseRating) -->
  <Style Selector="Button.ClaudeChatResponseCopy, Button.ClaudeChatResponseBookmark, StackPanel.ClaudeChatResponseRating">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="StackPanel.ClaudeChatResponseRating">
    <Setter Property="Spacing" Value="2" />
  </Style>
  <Style Selector="Button.ClaudeChatResponseAction:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
  </Style>
  <Style Selector="Button.ClaudeChatResponseAction:pointerover /template/ Border#PART_ChatButton">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.ToolBackground}" />
  </Style>
  <Style Selector="Button.ClaudeChatResponseAction:focus-visible /template/ Border#PART_ChatButton">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.FocusBorder}" />
  </Style>
  <Style Selector="Button.ClaudeChatResponseGood.selected">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Success}" />
  </Style>
  <Style Selector="Button.ClaudeChatResponseBad.selected">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Error}" />
  </Style>
  <Style Selector="Viewbox.ClaudeChatResponseIcon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>
  <Style Selector="Path.ClaudeChatBookmarkIcon, Path.ClaudeChatThumbUpIcon, Path.ClaudeChatThumbDownIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector="Path.ClaudeChatBookmarkIcon">
    <Setter Property="Data" Value="{DynamicResource ClaudeChat.Icon.Bookmark}" />
  </Style>
  <Style Selector="Path.ClaudeChatBookmarkIcon.marked">
    <Setter Property="Fill" Value="{Binding $parent[Button].Foreground}" />
  </Style>
  <Style Selector="Path.ClaudeChatThumbUpIcon">
    <Setter Property="Data" Value="{DynamicResource ClaudeChat.Icon.ThumbUp}" />
  </Style>
  <Style Selector="Path.ClaudeChatThumbDownIcon">
    <Setter Property="Data" Value="{DynamicResource ClaudeChat.Icon.ThumbDown}" />
  </Style>
  <Style Selector="StackPanel.ClaudeChatResponseNotice">
    <Setter Property="Margin" Value="6,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- .9em of the text (the size of inline code) -->
  <Style Selector="TextBlock.ClaudeChatResponseNoticeText">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.CodeFontSize}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.ClaudeChatResponseLink">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
  </Style>
  <Style Selector="Button.ClaudeChatResponseLink:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
  </Style>
  <Style Selector="Button.ClaudeChatResponseLink:focus-visible /template/ Border#PART_ChatButton">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.FocusBorder}" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatResponseLinkText">
    <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.CodeFontSize}" />
    <Setter Property="TextDecorations" Value="Underline" />
  </Style>
  <!-- in sight: under the pointer, with the keyboard (on the button; anywhere in the thumbs), a marked bookmark, a rated reply's thumbs -->
  <Style Selector="StackPanel.ClaudeChatTurnEnd:pointerover Button.ClaudeChatResponseCopy, StackPanel.ClaudeChatTurnEnd:pointerover Button.ClaudeChatResponseBookmark, StackPanel.ClaudeChatTurnEnd:pointerover StackPanel.ClaudeChatResponseRating, Button.ClaudeChatResponseCopy:focus, Button.ClaudeChatResponseBookmark:focus, StackPanel.ClaudeChatResponseRating:focus-within, Button.ClaudeChatResponseBookmark.marked, controls|ResponseActions:rated StackPanel.ClaudeChatResponseRating">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- ===== "What went wrong?" (FeedbackDialog): the modal backdrop over the whole view; a dialog of 400 px at most with the side bar's
       color, a 1 px border, 8 px corners and 16 px inside; the title at 16 px, semibold, and a × of 20 px; a field of four lines in the
       input's colors, 8 px inside, .9em; "Skip" (plain) and "Send feedback" (the button color, semibold) at the right, 16 px under it ===== -->

  <Style Selector="controls|FeedbackDialog">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.ModalOverlay}" />
  </Style>
  <Style Selector="Border.ClaudeChatFeedbackDialog">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style Selector="Border.ClaudeChatFeedbackDialog:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.PermissionActiveBorder}" />
  </Style>
  <Style Selector="DockPanel.ClaudeChatFeedbackHeader">
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatFeedbackTitle">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBox.ClaudeChatFeedbackField">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.InputBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="CaretBrush" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.InputBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="Height" Value="{DynamicResource ClaudeChat.FeedbackFieldHeight}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.CodeFontSize}" />
  </Style>
  <Style Selector="TextBox.ClaudeChatFeedbackField /template/ Border#PART_BorderElement, TextBox.ClaudeChatFeedbackField:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.InputBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.InputBorder}" />
  </Style>
  <Style Selector="TextBox.ClaudeChatFeedbackField:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.InputBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.FocusBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="StackPanel.ClaudeChatFeedbackButtons">
    <Setter Property="Spacing" Value="8" />
    <Setter Property="Margin" Value="0,16,0,0" />
  </Style>
  <Style Selector="Button.ClaudeChatFeedbackSkip, Button.ClaudeChatFeedbackSend">
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.CodeFontSize}" />
  </Style>
  <Style Selector="Button.ClaudeChatFeedbackSkip:pointerover /template/ Border#PART_ChatButton">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.HoverBackground}" />
  </Style>
  <Style Selector="Button.ClaudeChatFeedbackSend">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.AccentFill}" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.AccentForeground}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.ClaudeChatFeedbackSkip:focus-visible /template/ Border#PART_ChatButton, Button.ClaudeChatFeedbackSend:focus-visible /template/ Border#PART_ChatButton">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.FocusBorder}" />
  </Style>

  <!-- "Interrupted" and "Tool interrupted": a plain line in the column of the user's messages, no dot and no bubble, not
       indented; italic, muted, 8 px over and under -->
  <Style Selector="TextBlock.ClaudeChatNotice">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="FontStyle" Value="Italic" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.LineHeight}" />
    <Setter Property="Margin" Value="0,8" />
    <Setter Property="RenderTransform" Value="translate(0px,1px)" />
  </Style>
  <!-- a meta line: italic, the secondary color at 80%, 8 px of padding, 4 px over and under, selectable -->
  <Style Selector="SelectableTextBlock.ClaudeChatMetaLine">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="FontStyle" Value="Italic" />
    <Setter Property="Opacity" Value="0.8" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="Margin" Value="0,4" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatNotice.failed">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Error}" />
  </Style>

  <!-- ===== tool calls ===== -->

  <!-- the name, bold -->
  <Style Selector="TextBlock.ClaudeChatToolName">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.LineHeight}" />
    <Setter Property="Margin" Value="0,0,7.6,0" /> <!-- 4 px, and the space after the name -->
    <Setter Property="RenderTransform" Value="translate(0px,1px)" />
  </Style>
  <!-- a path or a pattern next to the name: .85em in the editor's font; a file, in the link color -->
  <Style Selector="TextBlock.ClaudeChatToolDetail">
    <Setter Property="FontFamily" Value="{DynamicResource ClaudeChat.MonoFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.SmallFontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.LineHeight}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="RenderTransform" Value="translate(0px,7px)" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatToolDetail.file">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Accent}" />
  </Style>
  <!-- a command's description, muted, in the interface's font -->
  <Style Selector="TextBlock.ClaudeChatToolDetail.plain">
    <Setter Property="FontFamily" Value="{DynamicResource ClaudeChat.FontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.FontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="RenderTransform" Value="translate(0px,1px)" />
  </Style>
  <!-- the lines a Read asked for, plain -->
  <Style Selector="TextBlock.ClaudeChatToolRange">
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.LineHeight}" />
    <Setter Property="Margin" Value="3.6,0,0,0" /> <!-- the space before it -->
    <Setter Property="RenderTransform" Value="translate(0px,1px)" />
  </Style>

  <!-- the line under the name ("Modified", "47 lines"): .85em, muted at 70 %, in a 21 px line -->
  <Style Selector="TextBlock.ClaudeChatSecondary">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.SmallFontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.SmallLineHeight}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Opacity" Value="0.7" />
    <Setter Property="Margin" Value="0,3,0,2" />
    <Setter Property="RenderTransform" Value="translate(0px,1px)" />
  </Style>

  <!-- "Run in background", right under the command's box (measured on the print: 4 px higher than the line above a box) -->
  <Style Selector="TextBlock.ClaudeChatSecondary.background">
    <Setter Property="Margin" Value="0,-1,0,2" />
  </Style>

  <!-- the line under a background agent's row: the secondary line (.85em, muted, 70 %) starting with an 8 px dot and a space;
       the dot is green while it works, blue while a request waits, red when it (or an agent it started) failed or stopped,
       and gray at 40 % once it finished -->
  <Style Selector="DockPanel.ClaudeChatAgentLine">
    <Setter Property="Opacity" Value="0.7" />
    <Setter Property="Margin" Value="0,-1,0,2" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatAgentLineText">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.SmallFontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.SmallLineHeight}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="RenderTransform" Value="translate(0px,1px)" />
  </Style>
  <Style Selector="Ellipse.ClaudeChatAgentLineDot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,5.3,3.5,0" /> <!-- centered on the first line; then the space -->
    <Setter Property="Fill" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="Ellipse.ClaudeChatAgentLineDot.running">
    <Setter Property="Fill" Value="{DynamicResource ClaudeChat.AgentRunning}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Ellipse.ClaudeChatAgentLineDot.waiting">
    <Setter Property="Fill" Value="{DynamicResource ClaudeChat.AgentWaiting}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Ellipse.ClaudeChatAgentLineDot.failed">
    <Setter Property="Fill" Value="{DynamicResource ClaudeChat.Error}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- the line under a Glob or a Grep with output: the secondary line, which opens the output; the keyboard's focus is the thin
       line inside that the box's texts have -->
  <Style Selector="Border.ClaudeChatOutputLine:focus-visible">
    <Setter Property="BoxShadow" Value="{DynamicResource ClaudeChat.ToolContentFocusShadow}" />
  </Style>
  <!-- what a Web Fetch that worked says in its box: plain, half strength, 8 px from the frame -->
  <Style Selector="TextBlock.ClaudeChatFetched">
    <Setter Property="Opacity" Value="0.5" />
    <Setter Property="Margin" Value="8" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- the box under a tool -->
  <Style Selector="Border.ClaudeChatToolBody">
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.InputBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.ToolBackground}" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Margin" Value="0,8" />
  </Style>
  <!-- a row of the box (IN, OUT), 4 px inside, a line between rows -->
  <Style Selector="Border.ClaudeChatToolRow">
    <Setter Property="Padding" Value="4" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.InputBorder}" />
  </Style>
  <Style Selector="Border.ClaudeChatToolRow.next">
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatToolLabel">
    <Setter Property="FontFamily" Value="{DynamicResource ClaudeChat.MonoFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.SmallFontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.SmallLineHeight}" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="Opacity" Value="0.5" />
    <Setter Property="Margin" Value="4,4,7,4" />
    <Setter Property="RenderTransform" Value="translate(0px,3px)" />
  </Style>
  <!-- what goes in a row: the editor's font at .85em, without wrapping, 60 px at most with a fade -->
  <Style Selector="Border.ClaudeChatToolContent">
    <Setter Property="Padding" Value="4" />
    <Setter Property="MaxHeight" Value="68" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="OpacityMask">
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,60">
        <GradientStop Offset="0" Color="Black" />
        <GradientStop Offset="0.8333" Color="Black" />
        <GradientStop Offset="1" Color="Transparent" />
      </LinearGradientBrush>
    </Setter>
  </Style>
  <Style Selector="Border.ClaudeChatToolContent.whole">
    <Setter Property="MaxHeight" Value="Infinity" />
    <Setter Property="OpacityMask" Value="{x:Null}" />
  </Style>
  <!-- a long text takes clicks and the keyboard (the cursor tells it; nothing else shows on the content); the keyboard's focus
       is a thin line inside, which takes no room -->
  <Style Selector="Border.ClaudeChatToolContent.expandable:focus-visible">
    <Setter Property="BoxShadow" Value="{DynamicResource ClaudeChat.ToolContentFocusShadow}" />
  </Style>
  <!-- a string result: on the code background (textCodeBlock.background), as wide as the row, scrolling sideways -->
  <Style Selector="Border.ClaudeChatToolResult">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.CodeBlockBackground}" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatToolText, SelectableTextBlock.ClaudeChatToolText">
    <Setter Property="FontFamily" Value="{DynamicResource ClaudeChat.MonoFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.SmallFontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.SmallLineHeight}" />
    <Setter Property="RenderTransform" Value="translate(0px,3px)" />
  </Style>

  <!-- a to-do list: a box per entry (checked when done, a star while doing), 4 px apart -->
  <Style Selector="StackPanel.ClaudeChatTodos">
    <Setter Property="Spacing" Value="4" />
    <Setter Property="Margin" Value="0,8" />
  </Style>
  <Style Selector="Border.ClaudeChatTodoBox">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
    <Setter Property="Margin" Value="2,4,8,2" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.InputBorder}" />
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.InputBackground}" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatTodoMark">
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.SmallFontSize}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatTodo">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.LineHeight}" />
    <Setter Property="RenderTransform" Value="translate(0px,1px)" />
  </Style>
  <Style Selector="DockPanel.ClaudeChatTodoRow.completed">
    <Setter Property="Opacity" Value="0.7" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatTodo.completed">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="TextDecorations" Value="Strikethrough" />
    <Setter Property="Opacity" Value="0.7" />
  </Style>

  <!-- ===== the diff (its layout comes from DiffView) ===== -->

  <Style Selector="controls|DiffView">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.DiffBackground}" />
  </Style>
  <Style Selector="Panel.ClaudeChatDiffRow">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.DiffBackground}" />
  </Style>
  <Style Selector="Border.ClaudeChatDiffLine.removed">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.DiffRemoved}" />
  </Style>
  <Style Selector="Border.ClaudeChatDiffLine.added">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.DiffAdded}" />
  </Style>
  <Style Selector="Run.ClaudeChatDiffChanged.removed">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.DiffRemovedText}" />
  </Style>
  <Style Selector="Run.ClaudeChatDiffChanged.added">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.DiffAddedText}" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatDiffText">
    <Setter Property="FontFamily" Value="{DynamicResource ClaudeChat.MonoFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.EditorFontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.EditorLineHeight}" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.DiffForeground}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="RenderTransform" Value="translate(0px,4px)" />
  </Style>
  <Style Selector="Rectangle.ClaudeChatDiffGuide">
    <Setter Property="Fill" Value="{DynamicResource ClaudeChat.DiffGuide}" />
  </Style>
  <Style Selector="Border.ClaudeChatDiffCurrentLine">
    <Setter Property="Height" Value="{DynamicResource ClaudeChat.EditorLineHeight}" />
    <Setter Property="BorderThickness" Value="0,2" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.DiffCurrentLine}" />
  </Style>
  <Style Selector="Border.ClaudeChatDiffSign">
    <Setter Property="Width" Value="5" />
    <Setter Property="Height" Value="5" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.DiffSign}" />
  </Style>
  <Style Selector="Border.ClaudeChatDiffHatch">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.DiffHatch}" />
  </Style>
  <Style Selector="Rectangle.ClaudeChatDiffShadow">
    <Setter Property="Fill" Value="{DynamicResource ClaudeChat.DiffShadow}" />
  </Style>
  <Style Selector="Rectangle.ClaudeChatDiffFade">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="controls|DiffView:cut Rectangle.ClaudeChatDiffFade">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="Fill" Value="{DynamicResource ClaudeChat.DiffFade}" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatDiffGap">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.EditorLineHeight}" />
    <Setter Property="RenderTransform" Value="translate(0px,1px)" />
  </Style>

  <!-- the layer over a diff of the list: it takes the click (its background is what the pointer hits), darkens under the pointer, and
       shows "Click to expand" 8 px in from its bottom right while the pointer or the keyboard is on it; the keyboard's focus is the thin
       line inside of a tool's texts -->
  <Style Selector="Border.ClaudeChatDiffExpand">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Border.ClaudeChatDiffExpand:pointerover">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.DiffExpandHover}" />
  </Style>
  <Style Selector="Border.ClaudeChatDiffExpand:focus-visible">
    <Setter Property="BoxShadow" Value="{DynamicResource ClaudeChat.ToolContentFocusShadow}" />
  </Style>
  <!-- the pill: the menus' colors, 11 px, 4 by 8 px inside, 4 px corners; under the pointer a light border and 5 % larger -->
  <Style Selector="Border.ClaudeChatDiffExpandPill">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.MenuBackground}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Margin" Value="8" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
  </Style>
  <Style Selector="Border.ClaudeChatDiffExpand:pointerover Border.ClaudeChatDiffExpandPill, Border.ClaudeChatDiffExpand:focus-visible Border.ClaudeChatDiffExpandPill">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="Border.ClaudeChatDiffExpandPill:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.DiffExpandPillHoverBorder}" />
    <Setter Property="RenderTransform" Value="scale(1.05)" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatDiffExpandText">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.MenuForeground}" />
  </Style>

  <!-- the Diff View: the whole view on the side bar's color, 16 px around; the dialog as large as the view less 40 px (DiffViewPanel),
       with the input border, 4 px corners and a soft shadow; its header in the editor's color, 8 by 12 px inside, a line under it; the
       title (the file's whole path) semibold on one line, then a × of 20 px -->
  <Style Selector="controls|DiffViewPanel">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.Background}" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style Selector="Border.ClaudeChatDiffViewDialog">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BoxShadow" Value="{DynamicResource ClaudeChat.DiffViewShadow}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.ClaudeChatDiffViewHeader">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.ToolBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.BorderStrong}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatDiffViewTitle">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,12,0" />
  </Style>
  <Style Selector="Button.ClaudeChatDiffViewClose">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
  </Style>
  <Style Selector="Button.ClaudeChatDiffViewClose:pointerover, Button.ClaudeChatDiffViewClose:focus-visible">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
  </Style>
  <Style Selector="Button.ClaudeChatDiffViewClose:pointerover /template/ Border#PART_ChatButton, Button.ClaudeChatDiffViewClose:focus-visible /template/ Border#PART_ChatButton">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.HoverBackground}" />
  </Style>
  <Style Selector="Viewbox.ClaudeChatDiffViewCloseIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>

  <!-- ===== buttons =====
       A template of their own, so the app's theme (Fluent or Simple) changes neither the colors nor the size. -->

  <Style Selector="Button.ClaudeChatButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.FontSize}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
    <Setter Property="Transitions" Value="{x:Null}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_ChatButton"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Name="PART_ChatButtonContent"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- ===== a long prompt folded at 60 px (FoldedText): "Show more" inside the bubble at the bottom right and "Show less" under the
       open text at the right; 4 px around, 8 px inside, 4 px corners, .85em, in the menu's colors turned over. Under the pointer they
       grow by 5 % over 0.2 s. "Show more" shows only while the pointer is on the bubble or the keyboard is on it; "Show less" always, at
       90 % until the pointer comes ===== -->

  <Style Selector="Button.ClaudeChatFoldButton">
    <Setter Property="Margin" Value="4" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.SmallFontSize}" />
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.MenuForeground}" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.MenuBackground}" />
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.ClaudeChatFoldButton:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.05)" />
  </Style>
  <Style Selector="Button.ClaudeChatShowMore">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Border.ClaudeChatUser:pointerover Button.ClaudeChatShowMore, Border.ClaudeChatStickyBubble:pointerover Button.ClaudeChatShowMore, Button.ClaudeChatShowMore:focus-visible">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.ClaudeChatShowLess">
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Button.ClaudeChatShowLess:pointerover">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- ===== the copy button under a finished turn (shown by the touch layout): a 44 px target around a 20 px icon, in the
       secondary color; its glyph, not its target, lines up with the text. The corners are rounded only a little, since
       a corner that is cut off is a corner a finger misses. After a copy the icon is the check ===== -->

  <Style Selector="Button.ClaudeChatCopyTurn">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Margin" Value="-12,0,0,0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
  </Style>
  <Style Selector="Button.ClaudeChatCopyTurn:pointerover /template/ Border#PART_ChatButton, Button.ClaudeChatCopyTurn:pressed /template/ Border#PART_ChatButton">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.HoverBackground}" />
  </Style>
  <Style Selector="Button.ClaudeChatCopyTurn:focus-visible /template/ Border#PART_ChatButton">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.FocusBorder}" />
  </Style>
  <Style Selector="Viewbox.ClaudeChatCopyIcon">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
  </Style>
  <Style Selector="Path.ClaudeChatCopyIcon">
    <Setter Property="Data" Value="{DynamicResource ClaudeChat.Icon.Copy}" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector="Path.ClaudeChatCopyIcon.copied">
    <Setter Property="Data" Value="{DynamicResource ClaudeChat.Icon.Check}" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Stroke" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="StrokeThickness" Value="1.5" />
  </Style>

  <!-- ===== the copy button on a command's row (Bash, PowerShell): at the row's top right, 4 px in (the row's own padding), a 14 px
       icon in the secondary color, 4 px inside, on the editor's background with a 1 px border and 4 px corners. It is clear until the
       pointer is over the row (or the keyboard is on it), and comes in over .15 s; the touch layout always shows it ===== -->

  <Style Selector="Border.ClaudeChatToolRow.ClaudeChatCopyHost">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.ClaudeChatCopyCode">
    <Setter Property="Padding" Value="4" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.ToolBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.ClaudeChatToolRow.ClaudeChatCopyHost:pointerover Button.ClaudeChatCopyCode, Button.ClaudeChatCopyCode:pointerover, Button.ClaudeChatCopyCode:focus-visible">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.ClaudeChatCopyCode:pointerover /template/ Border#PART_ChatButton, Button.ClaudeChatCopyCode:pressed /template/ Border#PART_ChatButton">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.HoverBackground}" />
  </Style>
  <Style Selector="Button.ClaudeChatCopyCode:focus-visible /template/ Border#PART_ChatButton">
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.FocusBorder}" />
  </Style>
  <Style Selector="Viewbox.ClaudeChatCopyCodeIcon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>

  <!-- ===== the permission request: the reply box's frame, the options as the extension's buttons ===== -->

  <Style Selector="Border.ClaudeChatPermission">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.InputBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.InputBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="8" />
  </Style>
  <!-- with the focus inside, the active border at 65 % -->
  <Style Selector="Border.ClaudeChatPermission:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.PermissionActiveBorder}" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatPermissionTitle">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.PromptFontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.PromptLineHeight}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="RenderTransform" Value="translate(0px,1px)" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatPermissionMore">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.SmallFontSize}" />
    <Setter Property="Margin" Value="12,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- the command: the editor's font at .9em of the request, as it will run -->
  <Style Selector="Border.ClaudeChatPermissionSummary">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="SelectableTextBlock.ClaudeChatPermissionSummaryText">
    <Setter Property="FontFamily" Value="{DynamicResource ClaudeChat.MonoFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.PromptCodeFontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.PromptLineHeight}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="RenderTransform" Value="translate(0px,5px)" />
  </Style>
  <Style Selector="StackPanel.ClaudeChatPermissionOptions">
    <Setter Property="Spacing" Value="8" />
    <Setter Property="Margin" Value="0,8,0,0" />
  </Style>
  <Style Selector="Button.ClaudeChatOption">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.OptionBorder}" />
    <Setter Property="Padding" Value="7,5" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <!-- the option the keys answer with: the accent, bold, white on it -->
  <Style Selector="Button.ClaudeChatOption.selected">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.AccentFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.AccentFill}" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.AccentForeground}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.ClaudeChatOption:pointerover /template/ Border#PART_ChatButton">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.HoverBackground}" />
  </Style>
  <Style Selector="Button.ClaudeChatOption.selected:pointerover /template/ Border#PART_ChatButton">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.AccentFill}" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatOptionNumber">
    <Setter Property="Opacity" Value="0.6" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatOptionText">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <!-- in option 2, where the rule is saved and "N more": a dotted underline with a tooltip, solid with the pointer on it -->
  <Style Selector="TextBlock.ClaudeChatAllowAlwaysHint">
    <Setter Property="TextDecorations">
      <TextDecorationCollection>
        <TextDecoration Location="Underline" StrokeDashArray="1,2" />
      </TextDecorationCollection>
    </Setter>
  </Style>
  <Style Selector="TextBlock.ClaudeChatAllowAlwaysHint:pointerover">
    <Setter Property="TextDecorations" Value="Underline" />
  </Style>

  <!-- what to tell Claude: an option's frame, the active border with the focus -->
  <Style Selector="TextBox.ClaudeChatField">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="CaretBrush" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.OptionBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="7,5" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.FontSize}" />
    <Setter Property="Margin" Value="0,8,0,0" />
  </Style>
  <Style Selector="TextBox.ClaudeChatField /template/ Border#PART_BorderElement, TextBox.ClaudeChatField:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.OptionBorder}" />
  </Style>
  <Style Selector="TextBox.ClaudeChatField:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.InputActiveBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- the desktop's card of the extension 2.1.310 (the touch layout draws none of this: its request is the 0.5.0 one) -->
  <!-- in the title, a file's name or a path in the editor's font, a tool's raw name in bold -->
  <Style Selector="Run.ClaudeChatPermissionPath">
    <Setter Property="FontFamily" Value="{DynamicResource ClaudeChat.MonoFontFamily}" />
  </Style>
  <Style Selector="Run.ClaudeChatPermissionTool">
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <!-- the lines under the title: .9em of the card, 6 px under them; a description in descriptionForeground -->
  <Style Selector="StackPanel.ClaudeChatPermissionNotes">
    <Setter Property="Spacing" Value="6" />
  </Style>
  <Style Selector="StackPanel.ClaudeChatPermissionNotes > TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.PromptCodeFontSize}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="StackPanel.ClaudeChatPermissionNotes > TextBlock:nth-last-child(1)">
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatPermissionNote">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatPermissionDescription">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
  </Style>
  <!-- "Details": the fold of any other tool's input, its 12 px arrow turned over when open -->
  <Style Selector="ToggleButton.ClaudeChatPermissionDetails">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.PromptCodeFontSize}" />
  </Style>
  <Style Selector="Path.ClaudeChatPermissionDetailsChevron">
    <Setter Property="Data" Value="{DynamicResource ClaudeChat.Icon.ChevronDown}" />
    <Setter Property="Stroke" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector="ToggleButton.ClaudeChatPermissionDetails:checked Path.ClaudeChatPermissionDetailsChevron">
    <Setter Property="RenderTransform" Value="rotate(180deg)" />
  </Style>
  <!-- the input as indented JSON: a box of the editor's colors, 4 px corners, 8 px inside and above -->
  <Style Selector="Border.ClaudeChatPermissionJson">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.ToolBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.InputBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="Margin" Value="0,8,0,0" />
  </Style>
  <Style Selector="SelectableTextBlock.ClaudeChatPermissionJsonText">
    <Setter Property="FontFamily" Value="{DynamicResource ClaudeChat.MonoFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.PromptCodeFontSize}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <!-- the card's fold button, at its top right: 20 px, 4 px from the top and the right (8 px from the top when folded), the arrow
       12 px inside a padding of 4; the secondary color, the toolbar's hover with the pointer or the keyboard on it, .8 pressed -->
  <Style Selector="Button.ClaudeChatPermissionFold">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Margin" Value="0,-5,-5,0" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
  </Style>
  <Style Selector="Button.ClaudeChatPermissionFold.folded">
    <Setter Property="Margin" Value="0,-1,-5,0" />
  </Style>
  <Style Selector="Button.ClaudeChatPermissionFold:pointerover, Button.ClaudeChatPermissionFold:focus-visible">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
  </Style>
  <Style Selector="Button.ClaudeChatPermissionFold:pointerover /template/ Border#PART_ChatButton, Button.ClaudeChatPermissionFold:focus-visible /template/ Border#PART_ChatButton">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.HoverBackground}" />
  </Style>
  <Style Selector="Button.ClaudeChatPermissionFold:pressed">
    <Setter Property="Opacity" Value="0.8" />
  </Style>
  <Style Selector="Path.ClaudeChatPermissionFoldIcon">
    <Setter Property="Data" Value="{DynamicResource ClaudeChat.Icon.ChevronDown}" />
    <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
  </Style>
  <Style Selector="Button.ClaudeChatPermissionFold.folded Path.ClaudeChatPermissionFoldIcon">
    <Setter Property="Data" Value="{DynamicResource ClaudeChat.Icon.ChevronUp}" />
  </Style>
  <!-- the header keeps 28 px on the right for the button; folded, it is the only line left: 4 px over and under it, on one line
       with an ellipsis -->
  <Style Selector="DockPanel.ClaudeChatPermissionHeader.foldable">
    <Setter Property="Margin" Value="0,0,28,0" />
  </Style>
  <Style Selector="Border.ClaudeChatPermission.folded DockPanel.ClaudeChatPermissionHeader">
    <Setter Property="Margin" Value="0,4,28,4" />
  </Style>
  <Style Selector="Border.ClaudeChatPermission.folded TextBlock.ClaudeChatPermissionTitle">
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="Margin" Value="0" />
  </Style>
  <!-- the options drawn disabled for 500 ms after the card comes; no numbers with default_to_no -->
  <Style Selector="StackPanel.ClaudeChatPermissionOptions.arming > Button.ClaudeChatOption">
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <Style Selector="StackPanel.ClaudeChatPermissionOptions.noNumbers TextBlock.ClaudeChatOptionNumber">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <!-- a plan's comments, over the card's title: "Comments (N)" at weight 600, 4 px under it, the block 8 px over the title; each comment
       a 2 px bar of descriptionForeground, 8 px in, 6 px under it: its passage in italics at 70 % and .9em, its words, and a × in
       descriptionForeground at its right ("Remove comment") -->
  <Style Selector="StackPanel.ClaudeChatPlanComments">
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatPlanCommentsTitle">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.PromptFontSize}" />
    <Setter Property="Margin" Value="0,0,28,4" />
  </Style>
  <Style Selector="Border.ClaudeChatPlanCommentRow">
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="Padding" Value="8,0,0,0" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatPlanCommentRowQuote">
    <Setter Property="FontStyle" Value="Italic" />
    <Setter Property="Opacity" Value="0.7" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.PromptCodeFontSize}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatPlanCommentRowText">
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.PromptFontSize}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Button.ClaudeChatPlanCommentRemove">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="Button.ClaudeChatPlanCommentRemove:pointerover, Button.ClaudeChatPlanCommentRemove:focus-visible">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
  </Style>

  <!-- "Esc to cancel", under the field: descriptionForeground, .85em -->
  <Style Selector="TextBlock.ClaudeChatPermissionHint">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.PromptHintFontSize}" />
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>
  <!-- "Waiting for permission…", above the reply box while the card waits for the typing to pause -->
  <Style Selector="TextBlock.ClaudeChatPermissionWaiting">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.FontSize}" />
  </Style>

  <!-- ===== the reply box: 680 px, 8 px corners, the text over a bar of 36 px ===== -->

  <Style Selector="Border.ClaudeChatComposer">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.InputBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.InputBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BoxShadow" Value="{DynamicResource ClaudeChat.ComposerShadow}" />
  </Style>
  <!-- with the focus inside, a ring in the color of the mode -->
  <Style Selector="Border.ClaudeChatComposer:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.FocusRing}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ClaudeChat.ComposerFocusShadow}" />
  </Style>
  <Style Selector="Border.ClaudeChatComposer.acceptEdits:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ClaudeChat.ComposerFocusShadowAcceptEdits}" />
  </Style>
  <Style Selector="Border.ClaudeChatComposer.plan:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.FocusBorder}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ClaudeChat.ComposerFocusShadowPlan}" />
  </Style>
  <Style Selector="Border.ClaudeChatComposer.auto:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.Error}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ClaudeChat.ComposerFocusShadowAuto}" />
  </Style>

  <!-- the text: 10 px over and under, 14 px at the left, 36 px at the right; no frame of its own, in any state -->
  <Style Selector="TextBox.ClaudeChatInput">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="CaretBrush" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="14,10,36,10" />
    <Setter Property="MinHeight" Value="39.5" />
    <Setter Property="MaxHeight" Value="200" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.FontSize}" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>
  <Style Selector="TextBox.ClaudeChatInput /template/ Border#PART_BorderElement, TextBox.ClaudeChatInput:pointerover /template/ Border#PART_BorderElement, TextBox.ClaudeChatInput:focus /template/ Border#PART_BorderElement, TextBox.ClaudeChatInput:disabled /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="TextBox.ClaudeChatInput /template/ TextBlock#PART_Watermark, TextBox.ClaudeChatField /template/ TextBlock#PART_Watermark">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.InputPlaceholder}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="TextBox.ClaudeChatInput:pointerover /template/ TextBlock#PART_Watermark, TextBox.ClaudeChatInput:focus /template/ TextBlock#PART_Watermark, TextBox.ClaudeChatField:pointerover /template/ TextBlock#PART_Watermark, TextBox.ClaudeChatField:focus /template/ TextBlock#PART_Watermark">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.InputPlaceholder}" />
  </Style>

  <!-- the bar under the text: a line over it, 5 px inside, 2 px between its pieces -->
  <Style Selector="Border.ClaudeChatComposerBar">
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.InputBorder}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="5" />
  </Style>

  <!-- the mode picker: a template of its own (the list opens upward, in the app's theme for its entries) -->
  <Style Selector="ComboBox.ClaudeChatPicker">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.SmallFontSize}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_PickerBox"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <Panel>
              <TextBlock Name="PlaceholderTextBlock" VerticalAlignment="Center"
                         Text="{TemplateBinding PlaceholderText}"
                         Foreground="{TemplateBinding PlaceholderForeground}"
                         IsVisible="{TemplateBinding SelectionBoxItem, Converter={x:Static ObjectConverters.IsNull}}" />
              <ContentControl Name="ContentPresenter" VerticalAlignment="Center"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding ItemTemplate}" />
            </Panel>
          </Border>
          <Popup Name="PART_Popup"
                 IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                 MaxHeight="{TemplateBinding MaxDropDownHeight}"
                 PlacementTarget="PART_PickerBox"
                 Placement="Top"
                 IsLightDismissEnabled="True"
                 WindowManagerAddShadowHint="False">
            <Border Classes="ClaudeChatPickerMenu">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
              </ScrollViewer>
            </Border>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Border.ClaudeChatPickerMenu">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.InputBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style Selector="ComboBox.ClaudeChatPicker:pointerover /template/ Border#PART_PickerBox, ComboBox.ClaudeChatPicker:focus-visible /template/ Border#PART_PickerBox">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.HoverBackground}" />
  </Style>
  <!-- the mode: its icon on 26 px and its name, 8 px after it -->
  <Style Selector="ComboBox.ClaudeChatModePicker">
    <Setter Property="Height" Value="26" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="0,0,8,0" />
  </Style>
  <Style Selector="Path.ClaudeChatModeIcon">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Stroke" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="StrokeThickness" Value="0.85" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatModeLabel">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- the model chip: a round pill, 18 px high, 8 px at the sides, .85em, 6 px after what comes before it; the level
       4 px after the name, in the secondary color -->
  <Style Selector="Button.ClaudeChatModelChip">
    <Setter Property="Height" Value="18" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Margin" Value="6,0,0,0" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.SmallFontSize}" />
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.PillBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
  </Style>
  <Style Selector="Button.ClaudeChatModelChip:pointerover /template/ Border#PART_ChatButton">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.PillHoverBackground}" />
  </Style>
  <Style Selector="Button.ClaudeChatModelChip:focus-visible /template/ Border#PART_ChatButton">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.FocusBorder}" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatModelChipEffort">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="Margin" Value="4,0,0,0" />
  </Style>
  <!-- a model or a level asked for and not yet confirmed by the claude -->
  <Style Selector="Button.ClaudeChatModelChip.pending TextBlock">
    <Setter Property="FontStyle" Value="Italic" />
  </Style>

  <!-- send and stop: one 26 px square, in the color of the mode -->
  <Style Selector="Button.ClaudeChatSend, Button.ClaudeChatStop">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.SendBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.SendForeground}" />
  </Style>
  <!-- with the keyboard on it, a 1 px line in focusBorder just inside its edge (outline 1px, offset -1px) -->
  <Style Selector="Button.ClaudeChatSend:focus-visible /template/ Border#PART_ChatButton, Button.ClaudeChatStop:focus-visible /template/ Border#PART_ChatButton">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.FocusBorder}" />
  </Style>
  <Style Selector="Border.ClaudeChatComposer.acceptEdits Button.ClaudeChatSend, Border.ClaudeChatComposer.acceptEdits Button.ClaudeChatStop">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ToolBackground}" />
  </Style>
  <Style Selector="Border.ClaudeChatComposer.plan Button.ClaudeChatSend, Border.ClaudeChatComposer.plan Button.ClaudeChatStop">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.AccentFill}" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.AccentForeground}" />
  </Style>
  <Style Selector="Border.ClaudeChatComposer.auto Button.ClaudeChatSend, Border.ClaudeChatComposer.auto Button.ClaudeChatStop">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.Error}" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.AccentForeground}" />
  </Style>
  <Style Selector="Button.ClaudeChatSend:disabled">
    <Setter Property="Opacity" Value="0.4" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>
  <Style Selector="Path.ClaudeChatSendIcon">
    <Setter Property="Data" Value="{DynamicResource ClaudeChat.Icon.Send}" />
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector="Border.ClaudeChatStopIcon">
    <Setter Property="Width" Value="11" />
    <Setter Property="Height" Value="11" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{Binding $parent[Button].Foreground}" />
  </Style>

  <!-- the bar's + and /: 26 px squares with 5 px corners, in the text's color; the toolbar's hover -->
  <Style Selector="Button.ClaudeChatBarButton">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>
  <Style Selector="Button.ClaudeChatBarButton:pointerover /template/ Border#PART_ChatButton">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.HoverBackground}" />
  </Style>
  <Style Selector="Button.ClaudeChatBarButton:focus-visible /template/ Border#PART_ChatButton">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.FocusBorder}" />
  </Style>
  <Style Selector="Path.ClaudeChatBarIcon">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
    <Setter Property="StrokeThickness" Value="1.3" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector="Path.ClaudeChatAddIcon">
    <Setter Property="Data" Value="{DynamicResource ClaudeChat.Icon.Add}" />
  </Style>
  <Style Selector="Path.ClaudeChatCommandsIcon">
    <Setter Property="Data" Value="{DynamicResource ClaudeChat.Icon.Slash}" />
  </Style>

  <!-- the prompt cache clock: 26 px high, the icon on a 26 px box at .58 of it, the minutes at .85em and 8 px after
       them; cold, only the icon, in the error color. Not a button: no hover -->
  <Style Selector="controls|PromptCacheClock">
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="0,0,8,0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="controls|PromptCacheClock.cold">
    <Setter Property="Padding" Value="0" />
  </Style>
  <!-- the extension's circle (7 of its 20 units, at 1.3 px × .58 each) is 6 of this icon's 16: 14.08 px for the box -->
  <Style Selector="Viewbox.ClaudeChatCacheClockIcon">
    <Setter Property="Width" Value="14.08" />
    <Setter Property="Height" Value="14.08" />
    <Setter Property="Margin" Value="5.96" />
  </Style>
  <Style Selector="Path.ClaudeChatCacheClockIcon">
    <Setter Property="Data" Value="{DynamicResource ClaudeChat.Icon.Clock}" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stroke" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="StrokeThickness" Value="0.857" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector="controls|PromptCacheClock.cold Path.ClaudeChatCacheClockIcon">
    <Setter Property="Stroke" Value="{DynamicResource ClaudeChat.Error}" />
  </Style>
  <!-- Segoe UI's digits are tabular already, as the extension asks with tabular-nums -->
  <Style Selector="TextBlock.ClaudeChatCacheClockMinutes">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.SmallFontSize}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- the Remote Control chip: a round pill, 18 px high, 8 px at the sides, .85em; grey when it failed, blue while
       it connects or is connected; a link (with the extension's brightness under the pointer) only when connected -->
  <Style Selector="Button.ClaudeChatRemoteControl">
    <Setter Property="Height" Value="18" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.SmallFontSize}" />
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.PillBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>
  <Style Selector="Button.ClaudeChatRemoteControl.on">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.BannerTint}" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.RemoteControlForeground}" />
  </Style>
  <Style Selector="Button.ClaudeChatRemoteControl.link">
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.ClaudeChatRemoteControl.link:pointerover /template/ Border#PART_ChatButton">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.RemoteControlHoverBackground}" />
  </Style>
  <Style Selector="Button.ClaudeChatRemoteControl.link:pointerover /template/ ContentPresenter#PART_ChatButtonContent">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.RemoteControlHoverForeground}" />
  </Style>
  <Style Selector="Button.ClaudeChatRemoteControl:focus-visible /template/ Border#PART_ChatButton">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.FocusBorder}" />
  </Style>
  <Style Selector="Button.ClaudeChatRemoteControl.on:focus-visible /template/ Border#PART_ChatButton">
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.RemoteControlForeground}" />
  </Style>
  <Style Selector="Button.ClaudeChatRemoteControl TextBlock">
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- ===== the command palette and the model menu (the extension's menuPopup): over the reply box, as wide as it,
       8 px above it; the menu's colors, the input's border, 8 px corners ===== -->

  <Style Selector="Border.ClaudeChatMenu">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.MenuBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.InputBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style Selector="Border.ClaudeChatMenu TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource ClaudeChat.FontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.FontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
  </Style>
  <!-- the list: 300 px at most, 8 px under its rows -->
  <Style Selector="ScrollViewer.ClaudeChatMenuScroller">
    <Setter Property="MaxHeight" Value="300" />
  </Style>
  <Style Selector="StackPanel.ClaudeChatMenuList">
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <!-- the model menu's rows, 2 px apart -->
  <Style Selector="StackPanel.ClaudeChatMenuRows">
    <Setter Property="Spacing" Value="2" />
  </Style>
  <!-- the palette's filter field: .9em, 8 px by 12 px inside, 4 px around, 4 px corners, no frame in any state; its
       placeholder at half opacity -->
  <Style Selector="TextBox.ClaudeChatMenuFilter">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.InputBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="CaretBrush" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="FontFamily" Value="{DynamicResource ClaudeChat.FontFamily}" />
    <Setter Property="FontSize" Value="11.7" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="4" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="TextBox.ClaudeChatMenuFilter /template/ Border#PART_BorderElement, TextBox.ClaudeChatMenuFilter:pointerover /template/ Border#PART_BorderElement, TextBox.ClaudeChatMenuFilter:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.InputBackground}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="TextBox.ClaudeChatMenuFilter /template/ TextBlock#PART_Watermark, TextBox.ClaudeChatMenuFilter:pointerover /template/ TextBlock#PART_Watermark, TextBox.ClaudeChatMenuFilter:focus /template/ TextBlock#PART_Watermark">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <!-- a section's title: .9em at half opacity, 4 px by 12 px around it -->
  <Style Selector="Border.ClaudeChatMenu TextBlock.ClaudeChatMenuHeader">
    <Setter Property="FontSize" Value="11.7" />
    <Setter Property="Opacity" Value="0.5" />
    <Setter Property="Margin" Value="12,4" />
  </Style>
  <!-- nothing matches: .9em, centered, at 70 % -->
  <Style Selector="Border.ClaudeChatMenu TextBlock.ClaudeChatMenuEmpty">
    <Setter Property="FontSize" Value="11.7" />
    <Setter Property="Opacity" Value="0.7" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Margin" Value="8,8,8,4" />
  </Style>
  <!-- a row: 4 px by 8 px inside, 4 px from the sides, 4 px corners; the marked one in the list's selection colors -->
  <Style Selector="Border.ClaudeChatMenuItem">
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Margin" Value="4,0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Border.ClaudeChatMenuItem.active">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.ListActiveBackground}" />
  </Style>
  <Style Selector="Border.ClaudeChatMenuItem.active TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ListActiveForeground}" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatMenuLabel">
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- a model: its name and its description (.85em, at half opacity), both in lines of 1.2em -->
  <Style Selector="Border.ClaudeChatMenu TextBlock.ClaudeChatModelLabel">
    <Setter Property="LineHeight" Value="15.6" />
  </Style>
  <Style Selector="Border.ClaudeChatMenu TextBlock.ClaudeChatModelDescription">
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.SmallFontSize}" />
    <Setter Property="LineHeight" Value="15.6" />
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <!-- the current model's check: 16 px at the left of a 24 px column -->
  <Style Selector="Path.ClaudeChatMenuCheck">
    <Setter Property="Data" Value="{DynamicResource ClaudeChat.Icon.Check}" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Stroke" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector="Border.ClaudeChatMenuItem.active Path.ClaudeChatMenuCheck">
    <Setter Property="Stroke" Value="{DynamicResource ClaudeChat.ListActiveForeground}" />
  </Style>
  <!-- the effort row: "Effort", the level 4 px after it in the secondary color, the slider 8 px after them; 4 px under it -->
  <Style Selector="Border.ClaudeChatEffortSection">
    <Setter Property="Padding" Value="0,0,0,4" />
  </Style>
  <Style Selector="Border.ClaudeChatMenu TextBlock.ClaudeChatEffortLevel">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="Margin" Value="4,0,0,0" />
  </Style>
  <!-- the slider: a 76 x 18 track in the input's border color, filled in inputOption.activeBorder up to a 14 px thumb
       in the text's color set 2 px inside; a 4 px notch per level, the secondary color at 40 % -->
  <Style Selector="Border.ClaudeChatEffortTrack">
    <Setter Property="Width" Value="76" />
    <Setter Property="Height" Value="18" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Margin" Value="8,0,0,0" />
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.InputBorder}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Border.ClaudeChatEffortFill">
    <Setter Property="Height" Value="18" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.InputActiveBorder}" />
  </Style>
  <Style Selector="Ellipse.ClaudeChatEffortNotch">
    <Setter Property="Width" Value="4" />
    <Setter Property="Height" Value="4" />
    <Setter Property="Fill" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="Border.ClaudeChatEffortThumb">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ClaudeChat.EffortThumbShadow}" />
  </Style>

  <!-- ===== a thumbnail of a message's image, as the extension's (2.1.309): a button without padding, a 1 px frame in
       the input's border color with 8 px corners, the picture's 7 px corners inside it, 4 px after it; the frame at
       70 % of the secondary color under the pointer, in the focus color with the keyboard ===== -->

  <Style Selector="Button.ClaudeChatMessageImage">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.InputBorder}" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="Border.ClaudeChatMessageImageClip">
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Button.ClaudeChatMessageImage:pointerover /template/ Border#PART_ChatButton">
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.ThumbnailHoverBorder}" />
  </Style>
  <Style Selector="Button.ClaudeChatMessageImage:focus-visible /template/ Border#PART_ChatButton">
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.FocusBorder}" />
  </Style>

  <!-- ===== the /context and /usage panels: the menus' frame over the end of the list, centered, 16 px from the
       sides, 8 px over what is under the list; a title and a ×, then the body, 12 px from the sides ===== -->

  <Style Selector=":is(Border).ClaudeChatPanelPlace">
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Margin" Value="16,16,16,8" />
  </Style>
  <Style Selector=":is(Border).ClaudeChatPanel">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.MenuBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.InputBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BoxShadow" Value="{DynamicResource ClaudeChat.PanelShadow}" />
    <Setter Property="Padding" Value="0,0,0,8" />
  </Style>
  <Style Selector=":is(Border).ClaudeChatPanel TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.MenuForeground}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.FontSize}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="DockPanel.ClaudeChatPanelHeader">
    <Setter Property="Margin" Value="12,4,4,4" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatPanelTitle">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <!-- the ×: a 14 px icon, 4 px around it, the toolbar's hover -->
  <Style Selector="Button.ClaudeChatPanelClose">
    <Setter Property="Padding" Value="4" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.MenuForeground}" />
  </Style>
  <Style Selector="Button.ClaudeChatPanelClose:pointerover /template/ Border#PART_ChatButton">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.HoverBackground}" />
  </Style>
  <Style Selector="Button.ClaudeChatPanelClose:focus-visible /template/ Border#PART_ChatButton">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.FocusBorder}" />
  </Style>
  <Style Selector="Border.ClaudeChatPanelBody">
    <Setter Property="Padding" Value="12,0" />
  </Style>
  <Style Selector=":is(Border).ClaudeChatPanel TextBlock.ClaudeChatPanelLoading">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
  </Style>
  <!-- a row: a 10 px color square, the name, the value at the right -->
  <Style Selector="Border.ClaudeChatPanelRow">
    <Setter Property="Padding" Value="0,2" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatPanelName">
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatPanelValue">
    <Setter Property="Margin" Value="12,0,0,0" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector=":is(Border).ClaudeChatPanel Border.ClaudeChatPanelRow.muted TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
  </Style>
  <Style Selector="Border.ClaudeChatContextSwatch">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- the bars: 8 px high, round, a pill's hover color as the track -->
  <Style Selector="Border.ClaudeChatContextBar, Border.ClaudeChatUsageBar">
    <Setter Property="Height" Value="8" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.PillHoverBackground}" />
  </Style>
  <Style Selector="Border.ClaudeChatContextBar">
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style Selector="Border.ClaudeChatUsageBar">
    <Setter Property="Margin" Value="0,4" />
  </Style>
  <Style Selector=":is(Border).ClaudeChatPanel TextBlock.ClaudeChatContextTotal">
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style Selector="Border.ClaudeChatContextSwatch.free">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.PillHoverBackground}" />
  </Style>
  <Style Selector="Border.ClaudeChatContextSegment.color1, Border.ClaudeChatContextSwatch.color1">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.ContextColor1}" />
  </Style>
  <Style Selector="Border.ClaudeChatContextSegment.color2, Border.ClaudeChatContextSwatch.color2">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.ContextColor2}" />
  </Style>
  <Style Selector="Border.ClaudeChatContextSegment.color3, Border.ClaudeChatContextSwatch.color3">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.ContextColor3}" />
  </Style>
  <Style Selector="Border.ClaudeChatContextSegment.color4, Border.ClaudeChatContextSwatch.color4">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.ContextColor4}" />
  </Style>
  <Style Selector="Border.ClaudeChatContextSegment.color5, Border.ClaudeChatContextSwatch.color5">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.ContextColor5}" />
  </Style>
  <Style Selector="Border.ClaudeChatContextSegment.color6, Border.ClaudeChatContextSwatch.color6">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.ContextColor6}" />
  </Style>
  <!-- /usage: a block per window, 12 px apart; the fill in the accent; when it renews, .85em in the secondary color -->
  <Style Selector="StackPanel.ClaudeChatUsageWindows">
    <Setter Property="Spacing" Value="12" />
  </Style>
  <Style Selector="Border.ClaudeChatUsageFill">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.AccentFill}" />
  </Style>
  <Style Selector=":is(Border).ClaudeChatPanel TextBlock.ClaudeChatUsageResets">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.SmallFontSize}" />
  </Style>

  <!-- ===== images attached to the reply box: a strip of pills above the text ===== -->

  <!-- 6 px around the pills, 4 px between them, a line under them; it scrolls sideways -->
  <Style Selector="controls|AttachmentStrip">
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.InputBorder}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="6" />
  </Style>
  <!-- a pill: 24 px, 4 px corners, 4 px inside (6 px at the right), 180 px at most -->
  <Style Selector="Button.ClaudeChatAttachment">
    <Setter Property="Height" Value="24" />
    <Setter Property="MaxWidth" Value="180" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.InputBorder}" />
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.AttachmentBackground}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.ClaudeChatAttachment:pointerover /template/ Border#PART_ChatButton">
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.AttachmentHoverBorder}" />
  </Style>
  <Style Selector="Button.ClaudeChatAttachment:focus-visible /template/ Border#PART_ChatButton">
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.FocusBorder}" />
  </Style>
  <Style Selector="Grid.ClaudeChatAttachmentContent">
    <Setter Property="Margin" Value="4,4,6,4" />
  </Style>
  <!-- the thumbnail: 12 px, cut to fill, 1 px corners -->
  <Style Selector="Border.ClaudeChatAttachmentThumb">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="CornerRadius" Value="1" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- a file's icon in place of the thumbnail: 12 px, the secondary color, 4 px before the name -->
  <Style Selector="Viewbox.ClaudeChatFileIcon">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Path.ClaudeChatFileIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stroke" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="StrokeThickness" Value="1.2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector="Path.ClaudeChatFileIcon.pdf">
    <Setter Property="Data" Value="{DynamicResource ClaudeChat.Icon.FilePdf}" />
  </Style>
  <Style Selector="Path.ClaudeChatFileIcon.text">
    <Setter Property="Data" Value="{DynamicResource ClaudeChat.Icon.FileText}" />
  </Style>
  <Style Selector="Path.ClaudeChatFileIcon.csv">
    <Setter Property="Data" Value="{DynamicResource ClaudeChat.Icon.Table}" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatAttachmentName">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatAttachmentMeta">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="Opacity" Value="0.6" />
    <Setter Property="Margin" Value="4,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- the ×: 32 px over the pill's end, the pill's color fading in under it; seen with the pointer on the pill -->
  <Style Selector="Button.ClaudeChatAttachmentRemove">
    <Setter Property="Width" Value="32" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Right" />
    <Setter Property="Padding" Value="0,0,6,0" />
    <Setter Property="CornerRadius" Value="0,3,3,0" />
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.AttachmentRemoveFade}" />
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Button.ClaudeChatAttachment:pointerover Button.ClaudeChatAttachmentRemove, Button.ClaudeChatAttachmentRemove:focus-visible">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Viewbox.ClaudeChatRemoveIcon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>
  <Style Selector="Path.ClaudeChatRemoveIcon">
    <Setter Property="Data" Value="{DynamicResource ClaudeChat.Icon.Remove}" />
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="StrokeLineCap" Value="Round" />
  </Style>
  <!-- why an image or a file did not go in -->
  <Style Selector="TextBlock.ClaudeChatAttachmentError">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Error}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.SmallFontSize}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="14,6,14,0" />
  </Style>

  <!-- the preview: the image over the whole view, 90 % of it at most, 8 px corners; a round close button on its corner -->
  <Style Selector="controls|ImagePreview">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.PreviewOverlay}" />
  </Style>
  <Style Selector="Border.ClaudeChatPreviewFrame">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BoxShadow" Value="{DynamicResource ClaudeChat.PreviewShadow}" />
  </Style>
  <Style Selector="Border.ClaudeChatPreviewClip">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Button.ClaudeChatPreviewClose">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.InputBorder}" />
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.MenuBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.MenuForeground}" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,-12,-12,0" />
  </Style>
  <Style Selector="Button.ClaudeChatPreviewClose:pointerover /template/ Border#PART_ChatButton">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.ListHoverBackground}" />
  </Style>
  <Style Selector="Button.ClaudeChatPreviewClose:focus-visible /template/ Border#PART_ChatButton">
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.FocusBorder}" />
  </Style>
  <Style Selector="Button.ClaudeChatPreviewClose Viewbox.ClaudeChatRemoveIcon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
  </Style>

  <!-- ===== the "N agents" chip and the Agent map (the extension's 2.1.309) ===== -->

  <!-- the chip: the model chip's pill, a 6 px dot 4 px before the count; the dot at 40 % of the secondary color, the
       busy green while an agent runs -->
  <Style Selector="Button.ClaudeChatAgentsChip">
    <Setter Property="Height" Value="18" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Margin" Value="6,0,0,0" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.SmallFontSize}" />
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.PillBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
  </Style>
  <Style Selector="Button.ClaudeChatAgentsChip:pointerover /template/ Border#PART_ChatButton">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.PillHoverBackground}" />
  </Style>
  <Style Selector="Button.ClaudeChatAgentsChip:focus-visible /template/ Border#PART_ChatButton">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.FocusBorder}" />
  </Style>
  <Style Selector="Button.ClaudeChatAgentsChip StackPanel">
    <Setter Property="Spacing" Value="4" />
  </Style>
  <Style Selector="Button.ClaudeChatAgentsChip TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Ellipse.ClaudeChatAgentsChipDot">
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Fill" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="Button.ClaudeChatAgentsChip.running Ellipse.ClaudeChatAgentsChipDot">
    <Setter Property="Fill" Value="{DynamicResource ClaudeChat.AgentRunning}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- the context ring: a bar button around the extension's 20 px pie -->
  <Style Selector="Button.ClaudeChatContextRing">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="4,2" />
  </Style>
  <Style Selector="controls|ContextRingArc">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Track" Value="{DynamicResource ClaudeChat.ContextRingTrack}" />
    <Setter Property="Fill" Value="{DynamicResource ClaudeChat.ContextRingFill}" />
  </Style>

  <!-- the map: the backdrop over the whole view; the dialog in the sidebar's color with its activity bar's line, 8 px
       corners, 16 px inside and around, 1200 px wide at most and as wide as its tree -->
  <Style Selector="controls|AgentMapPanel">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.ModalOverlay}" />
  </Style>
  <Style Selector="Border.ClaudeChatAgentMap, Border.ClaudeChatAgentCard">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.TimelineLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Margin" Value="16" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.ClaudeChatAgentMap">
    <Setter Property="MaxWidth" Value="1200" />
  </Style>
  <!-- with the keyboard in it, the border takes the input's active border at 65 %, as the extension's dialogs -->
  <Style Selector="Border.ClaudeChatAgentMap:focus-within, Border.ClaudeChatAgentCard:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.PermissionActiveBorder}" />
  </Style>
  <!-- an agent's card: 420 px, over the map with a backdrop of its own -->
  <Style Selector="Border.ClaudeChatAgentCard">
    <Setter Property="Width" Value="420" />
  </Style>
  <Style Selector="Border.ClaudeChatAgentCardLayer">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.ModalOverlay}" />
  </Style>
  <!-- the title line: 8 px over what follows; the title at 16 px, semibold -->
  <Style Selector="DockPanel.ClaudeChatAgentMapHeader">
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatAgentMapTitle">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- the subtitle: the text's 1.5 line, 12 px over the tree -->
  <Style Selector="TextBlock.ClaudeChatAgentMapSubtitle">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.LineHeight}" />
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>
  <!-- the × and the back arrow: the extension's icon buttons, a 20 px icon with 4 px around it, in the secondary color;
       the hover's background and the primary color under the pointer or with the keyboard -->
  <Style Selector="Button.ClaudeChatAgentMapButton">
    <Setter Property="Padding" Value="4" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.ClaudeChatAgentMapButton:pointerover, Button.ClaudeChatAgentMapButton:focus-visible">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
  </Style>
  <Style Selector="Button.ClaudeChatAgentMapButton:pointerover /template/ Border#PART_ChatButton, Button.ClaudeChatAgentMapButton:focus-visible /template/ Border#PART_ChatButton">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.HoverBackground}" />
  </Style>
  <Style Selector="Path.ClaudeChatAgentBackIcon">
    <Setter Property="Data" Value="{DynamicResource ClaudeChat.Icon.ArrowLeft}" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
    <Setter Property="StrokeThickness" Value="1.2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <!-- the tree: 4 px over it, 8 px at its right and under it; the agents' column 32 px after the main card, its rows
       8 px apart; the lines in the input's border color -->
  <Style Selector="Grid.ClaudeChatAgentTree">
    <Setter Property="Margin" Value="0,4,8,8" />
  </Style>
  <Style Selector="StackPanel.ClaudeChatAgentColumn">
    <Setter Property="Spacing" Value="8" />
  </Style>
  <Style Selector="StackPanel.ClaudeChatAgentColumn.nested">
    <Setter Property="Margin" Value="0,8,0,0" />
  </Style>
  <Style Selector="Border.ClaudeChatAgentLine">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.InputBorder}" />
  </Style>
  <Style Selector="Border.ClaudeChatAgentLine.stub">
    <Setter Property="Height" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- the main card's line starts right at its border and reaches the spine -->
  <Style Selector="Border.ClaudeChatAgentLine.stub.main">
    <Setter Property="Width" Value="16" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Border.ClaudeChatAgentLine.spine">
    <Setter Property="Width" Value="1" />
    <Setter Property="Margin" Value="16,0,0,0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Border.ClaudeChatAgentLine.spine.down">
    <Setter Property="Height" Value="8" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <!-- a row: 300 px (the main card 320), the menu's background with the input's border, 4 px corners, 6 px by 10 px
       inside; the list's hover over it -->
  <!-- one style for the agents' rows (buttons) and the main card (a border): Button's frame properties are Border's
       (and Padding Decorator's), shared through AddOwner -->
  <Style Selector=":is(Control).ClaudeChatAgentRow">
    <Setter Property="Width" Value="300" />
    <Setter Property="Decorator.Padding" Value="10,6" />
    <Setter Property="Border.CornerRadius" Value="4" />
    <Setter Property="Border.BorderThickness" Value="1" />
    <Setter Property="Border.BorderBrush" Value="{DynamicResource ClaudeChat.InputBorder}" />
    <Setter Property="Border.Background" Value="{DynamicResource ClaudeChat.MenuBackground}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.ClaudeChatAgentRow">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Border.ClaudeChatAgentRow.main">
    <Setter Property="Width" Value="320" />
  </Style>
  <Style Selector="Button.ClaudeChatAgentRow:pointerover /template/ Border#PART_ChatButton">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.ListHoverBackground}" />
  </Style>
  <Style Selector="Button.ClaudeChatAgentRow:focus-visible /template/ Border#PART_ChatButton">
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.FocusBorder}" />
  </Style>
  <Style Selector="StackPanel.ClaudeChatAgentRowBody">
    <Setter Property="Spacing" Value="2" />
  </Style>
  <!-- the title: the dot 6 px before it, cut with an ellipsis; semibold on the main card; a 17 px line (the
       extension's button keeps the font's own 17.3 px, which whole pixels would make 18, and the row 49 px instead of
       its 48). The meta line: .85em, in the secondary color, 14 px in (under the title) -->
  <Style Selector="TextBlock.ClaudeChatAgentRowTitle">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="LineHeight" Value="17" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.ClaudeChatAgentRow.main TextBlock.ClaudeChatAgentRowTitle">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatAgentRowMeta">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.SmallFontSize}" />
    <Setter Property="LineHeight" Value="15" /> <!-- fixed like the title: the row stays 48 px with any system font -->
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="Margin" Value="14,0,0,0" />
  </Style>
  <!-- the extension's status dot: 8 px; idle, 40 % of the secondary color; at work, the busy green; failed or
       stopped, the error color -->
  <Style Selector="Ellipse.ClaudeChatAgentDot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Fill" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="Ellipse.ClaudeChatAgentDot.card">
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>
  <Style Selector="Ellipse.ClaudeChatAgentDot.running">
    <Setter Property="Fill" Value="{DynamicResource ClaudeChat.AgentRunning}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Ellipse.ClaudeChatAgentDot.failed">
    <Setter Property="Fill" Value="{DynamicResource ClaudeChat.Error}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <!-- the card's lines: .85em in the secondary color, on the text's 1.5 line, 4 px apart. Under them, 10 px down: what
       a running agent is doing, and its answer as the extension shows it (the text as it came, its line breaks kept,
       on a 1.4 line) -->
  <Style Selector="TextBlock.ClaudeChatAgentCardMeta">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.SmallFontSize}" />
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.SmallLineHeight}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatAgentCardMeta.ClaudeChatAgentResult">
    <Setter Property="Margin" Value="0,10,0,0" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatAgentActivity, SelectableTextBlock.ClaudeChatAgentResult">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.LineHeight}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,10,0,0" />
  </Style>
  <Style Selector="SelectableTextBlock.ClaudeChatAgentResult">
    <Setter Property="LineHeight" Value="18.2" />
  </Style>

  <!-- ===== the banners over the reply box (the browser's, a Remote Control error) ===== -->

  <!-- 6 px over, 12 px under (8 of them under the reply box), 16 px at the left and 6 px at the right; rounded only on
       top. The border is .5 px in the extension, which Chromium draws as one device pixel -->
  <Style Selector=":is(Border).ClaudeChatBanner">
    <Setter Property="Padding" Value="16,6,6,12" />
    <Setter Property="CornerRadius" Value="8,8,0,0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.BannerForeground}" />
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.BannerBackground}" />
  </Style>
  <Style Selector=":is(Border).ClaudeChatBanner.error">
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.BannerErrorForeground}" />
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.BannerErrorBackground}" />
  </Style>
  <!-- .85em, semibold, a 1.4 line -->
  <Style Selector="TextBlock.ClaudeChatBannerText">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.BannerForeground}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.SmallFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="15.47" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector=":is(Border).ClaudeChatBanner.error TextBlock.ClaudeChatBannerText">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.BannerErrorForeground}" />
  </Style>
  <!-- the ×: a 12 px icon, 4 px around it, 12 px after the text, in the banner's color; the toolbar's hover -->
  <Style Selector="Button.ClaudeChatBannerClose">
    <Setter Property="Padding" Value="4" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Margin" Value="12,0,0,0" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.BannerForeground}" />
  </Style>
  <Style Selector=":is(Border).ClaudeChatBanner.error Button.ClaudeChatBannerClose">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.BannerErrorForeground}" />
  </Style>
  <Style Selector="Button.ClaudeChatBannerClose:pointerover /template/ Border#PART_ChatButton">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.HoverBackground}" />
  </Style>
  <Style Selector="Button.ClaudeChatBannerClose:focus-visible /template/ Border#PART_ChatButton">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.FocusBorder}" />
  </Style>
  <Style Selector="Button.ClaudeChatBannerClose Viewbox.ClaudeChatRemoveIcon">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
  </Style>

  <!-- ===== markdown (only inside a MarkdownBlock) ===== -->

  <Style Selector="controls|MarkdownBlock ctb|CTextBlock">
    <Setter Property="LineHeight" Value="{DynamicResource ClaudeChat.LineHeight}" />
    <Setter Property="Margin" Value="0,1.3,0,2.6" />
    <Setter Property="RenderTransform" Value="translate(0px,1px)" />
  </Style>
  <Style Selector="controls|MarkdownBlock StackPanel > ctb|CTextBlock:nth-child(1)">
    <Setter Property="Margin" Value="0,0,0,2.6" />
  </Style>
  <Style Selector="controls|MarkdownBlock ctb|CTextBlock.Heading1">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="NaN" />
    <Setter Property="Margin" Value="0,10,0,4" />
  </Style>
  <Style Selector="controls|MarkdownBlock ctb|CTextBlock.Heading2">
    <Setter Property="FontSize" Value="19.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="NaN" />
    <Setter Property="Margin" Value="0,10,0,4" />
  </Style>
  <Style Selector="controls|MarkdownBlock ctb|CTextBlock.Heading3">
    <Setter Property="FontSize" Value="15.2" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="NaN" />
    <Setter Property="Margin" Value="0,8,0,3" />
  </Style>
  <Style Selector="controls|MarkdownBlock ctb|CTextBlock.Heading4, controls|MarkdownBlock ctb|CTextBlock.Heading5, controls|MarkdownBlock ctb|CTextBlock.Heading6">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,6,0,2" />
  </Style>
  <Style Selector="controls|MarkdownBlock ctb|CHyperlink">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Accent}" />
    <Setter Property="IsUnderline" Value="True" />
  </Style>
  <!-- inline code: .9em in the editor's font, 2 px by 4 px inside, 3 px corners -->
  <Style Selector="controls|MarkdownBlock ctb|CCode">
    <Setter Property="MonospaceFontFamily" Value="{DynamicResource ClaudeChat.MonoFontFamily}" />
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.CodeBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.CodeForeground}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.CodeFontSize}" />
    <Setter Property="Padding" Value="4,4,4,0" /> <!-- 2 px by 4 px in the CSS; the text sits 2 px higher here -->
    <Setter Property="CornerRadius" Value="3" />
  </Style>
  <!-- a code block: 8 px inside, 4 px corners, 8 px over and under -->
  <Style Selector="controls|MarkdownBlock Border.CodeBlock">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.CodeBlockBackground}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="Margin" Value="0,8" />
  </Style>
  <!-- only sideways: the list is the one that scrolls up and down -->
  <Style Selector="controls|MarkdownBlock ScrollViewer.CodeBlock">
    <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
  </Style>
  <Style Selector="controls|MarkdownBlock TextBlock.CodeBlock">
    <Setter Property="FontFamily" Value="{DynamicResource ClaudeChat.MonoFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.CodeFontSize}" />
    <Setter Property="LineHeight" Value="17.55" />
    <Setter Property="RenderTransform" Value="translate(0px,4px)" />
  </Style>
  <!-- "Copy code" over the block's top right corner, 4 px in (the block's 8 px padding less 4), and it stays while the code scrolls. It is
       the command row's button (ClaudeChatCopyCode), clear until the pointer is over the block (it comes in over .15 s), at .7 while pressed -->
  <Style Selector="controls|MarkdownBlock Border.CodeBlock > Grid > Button.ClaudeChatCopyCode">
    <Setter Property="Margin" Value="0,-4,-4,0" />
  </Style>
  <Style Selector="controls|MarkdownBlock Border.CodeBlock:pointerover > Grid > Button.ClaudeChatCopyCode">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="controls|MarkdownBlock Border.CodeBlock > Grid > Button.ClaudeChatCopyCode:pressed">
    <Setter Property="Opacity" Value="0.7" />
  </Style>
  <Style Selector="controls|MarkdownBlock Grid.List">
    <Setter Property="Margin" Value="10,0,0,0" />
  </Style>
  <Style Selector="controls|MarkdownBlock ctb|CTextBlock.ListMarker">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="Margin" Value="0,1.3,8,2.6" />
  </Style>
  <Style Selector="controls|MarkdownBlock Border.Blockquote">
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.BorderStrong}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="Padding" Value="10,0,0,0" />
    <Setter Property="Margin" Value="0,4" />
  </Style>
  <Style Selector="controls|MarkdownBlock Border.Blockquote ctb|CTextBlock">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
  </Style>
  <Style Selector="controls|MarkdownBlock Border.Table">
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.InputBorder}" />
    <Setter Property="BorderThickness" Value="0,0,1,1" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Margin" Value="0,4" />
  </Style>
  <Style Selector="controls|MarkdownBlock Grid.Table > Border">
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.InputBorder}" />
    <Setter Property="BorderThickness" Value="1,1,0,0" />
    <Setter Property="Padding" Value="2" />
  </Style>
  <Style Selector="controls|MarkdownBlock Border.TableHeader">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.Surface}" />
  </Style>
  <Style Selector="controls|MarkdownBlock Border.TableHeader ctb|CTextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- ===== the plan's document, over the list (the extension's editor tab): after the markdown, whose styles it changes ===== -->

  <!-- the editor's colors; a header with the title and the ×, a line under it -->
  <Style Selector="controls|PlanDocumentPanel">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.ToolBackground}" />
  </Style>
  <Style Selector="Border.ClaudeChatPlanHeader">
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.Border}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="24,4,8,4" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatPlanTitle">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- the ×: the Agent map's icon button, a 20 px icon with 4 px around it -->
  <Style Selector="Button.ClaudeChatPlanClose">
    <Setter Property="Padding" Value="4" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.ClaudeChatPlanClose:pointerover, Button.ClaudeChatPlanClose:focus-visible">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
  </Style>
  <Style Selector="Button.ClaudeChatPlanClose:pointerover /template/ Border#PART_ChatButton, Button.ClaudeChatPlanClose:focus-visible /template/ Border#PART_ChatButton">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.HoverBackground}" />
  </Style>
  <!-- the page: 16 px over and under the text, 24 px at its sides -->
  <Style Selector="StackPanel.ClaudeChatPlanPage">
    <Setter Property="Margin" Value="24,16" />
  </Style>
  <!-- while the plan waits for an answer: the editor widget's colors and border, 4 px corners, 8 by 12 px inside, 16 px over the
       plan; "Ready for review" in bold over the hint (.85em, at 80 %) -->
  <Style Selector="Border.ClaudeChatPlanBanner">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.InputBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="0,0,0,16" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatPlanBannerTitle">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatPlanBannerText">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.SmallFontSize}" />
    <Setter Property="Opacity" Value="0.8" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <!-- the plan: the chat's font + 1 px (14 px) on a 1.6 line, in the editor's foreground -->
  <Style Selector="controls|MarkdownBlock.ClaudeChatPlanDocument">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
  </Style>
  <Style Selector="controls|MarkdownBlock.ClaudeChatPlanDocument ctb|CTextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="22.4" />
  </Style>
  <Style Selector="controls|MarkdownBlock.ClaudeChatPlanDocument Border.ClaudeChatPlanRule">
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.Border}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Margin" Value="0,24,0,8" />
  </Style>
  <Style Selector="controls|MarkdownBlock.ClaudeChatPlanDocument Border.ClaudeChatPlanRule.h1">
    <Setter Property="Padding" Value="0,0,0,8" />
  </Style>
  <Style Selector="controls|MarkdownBlock.ClaudeChatPlanDocument Border.ClaudeChatPlanRule.h2">
    <Setter Property="Padding" Value="0,0,0,6" />
  </Style>
  <Style Selector="controls|MarkdownBlock.ClaudeChatPlanDocument StackPanel > Border.ClaudeChatPlanRule:nth-child(1)">
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <!-- code blocks 12 px inside; lists 32 px in; quotes 4 by 12 px inside their bar -->
  <Style Selector="controls|MarkdownBlock.ClaudeChatPlanDocument Border.CodeBlock">
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="controls|MarkdownBlock.ClaudeChatPlanDocument TextBlock.CodeBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="19.5" />
  </Style>
  <Style Selector="controls|MarkdownBlock.ClaudeChatPlanDocument Border.CodeBlock > Grid > Button.ClaudeChatCopyCode">
    <Setter Property="Margin" Value="0,-8,-8,0" /> <!-- still 4 px from the corner, inside 12 -->
  </Style>
  <Style Selector="controls|MarkdownBlock.ClaudeChatPlanDocument Grid.List">
    <Setter Property="Margin" Value="16,0,0,0" />
  </Style>
  <Style Selector="controls|MarkdownBlock.ClaudeChatPlanDocument Border.Blockquote">
    <Setter Property="Padding" Value="12,4" />
  </Style>

  <!-- the plan's blocks, which the user can select (PlanTextBlock, a SelectableTextBlock in place of each of the Markdown's text blocks):
       the same measures as the Markdown's, with the plan's above -->
  <Style Selector="controls|MarkdownBlock.ClaudeChatPlanDocument SelectableTextBlock.ClaudeChatPlanText">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="22.4" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="Margin" Value="0,1.3,0,2.6" />
    <Setter Property="RenderTransform" Value="translate(0px,1px)" />
    <Setter Property="Cursor" Value="IBeam" />
  </Style>
  <Style Selector="controls|MarkdownBlock.ClaudeChatPlanDocument StackPanel > SelectableTextBlock.ClaudeChatPlanText:nth-child(1)">
    <Setter Property="Margin" Value="0,0,0,2.6" />
  </Style>
  <Style Selector="controls|MarkdownBlock.ClaudeChatPlanDocument SelectableTextBlock.ClaudeChatPlanText.Heading1, controls|MarkdownBlock.ClaudeChatPlanDocument SelectableTextBlock.ClaudeChatPlanText.Heading2, controls|MarkdownBlock.ClaudeChatPlanDocument SelectableTextBlock.ClaudeChatPlanText.Heading3">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="NaN" />
    <Setter Property="Margin" Value="0,24,0,8" />
  </Style>
  <Style Selector="controls|MarkdownBlock.ClaudeChatPlanDocument SelectableTextBlock.ClaudeChatPlanText.Heading1">
    <Setter Property="FontSize" Value="22.4" />
  </Style>
  <Style Selector="controls|MarkdownBlock.ClaudeChatPlanDocument SelectableTextBlock.ClaudeChatPlanText.Heading2">
    <Setter Property="FontSize" Value="18.2" />
  </Style>
  <Style Selector="controls|MarkdownBlock.ClaudeChatPlanDocument SelectableTextBlock.ClaudeChatPlanText.Heading3">
    <Setter Property="FontSize" Value="15.4" />
  </Style>
  <Style Selector="controls|MarkdownBlock.ClaudeChatPlanDocument SelectableTextBlock.ClaudeChatPlanText.Heading4, controls|MarkdownBlock.ClaudeChatPlanDocument SelectableTextBlock.ClaudeChatPlanText.Heading5, controls|MarkdownBlock.ClaudeChatPlanDocument SelectableTextBlock.ClaudeChatPlanText.Heading6">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,6,0,2" />
  </Style>
  <Style Selector="controls|MarkdownBlock.ClaudeChatPlanDocument Border.ClaudeChatPlanRule > SelectableTextBlock.ClaudeChatPlanText">
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="controls|MarkdownBlock.ClaudeChatPlanDocument StackPanel > SelectableTextBlock.ClaudeChatPlanText.Heading3:nth-child(1)">
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style Selector="controls|MarkdownBlock.ClaudeChatPlanDocument Border.Blockquote SelectableTextBlock.ClaudeChatPlanText">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
  </Style>
  <Style Selector="controls|MarkdownBlock.ClaudeChatPlanDocument Border.TableHeader SelectableTextBlock.ClaudeChatPlanText">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- inline code in the editor's font at 13 px on textPreformat's colors; links in textLink's, underlined -->
  <Style Selector="SelectableTextBlock.ClaudeChatPlanText Run.ClaudeChatPlanCode">
    <Setter Property="FontFamily" Value="{DynamicResource ClaudeChat.MonoFontFamily}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.CodeBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.CodeForeground}" />
  </Style>
  <Style Selector="SelectableTextBlock.ClaudeChatPlanText Run.ClaudeChatPlanLink">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Accent}" />
    <Setter Property="TextDecorations" Value="Underline" />
  </Style>
  <!-- a passage commented on: findMatchHighlightBackground at 60 %, then a circle of 1.4em in textLink's color, its number in white
       and the comment in its tooltip -->
  <Style Selector="SelectableTextBlock.ClaudeChatPlanText Run.ClaudeChatPlanMarked">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.PlanCommentHighlight}" />
  </Style>
  <Style Selector="Border.ClaudeChatPlanCommentNumber">
    <Setter Property="Width" Value="19.6" />
    <Setter Property="Height" Value="19.6" />
    <Setter Property="CornerRadius" Value="9.8" />
    <Setter Property="Margin" Value="2,0,0,0" />
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.Accent}" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatPlanCommentNumberText">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.AccentForeground}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LineHeight" Value="NaN" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- "Add Comment", 6 px under a passage selected: the button's colors, 4 by 10 px inside, 4 px corners, the font 2 px smaller, a soft
       shadow -->
  <Style Selector="Button.ClaudeChatPlanAddComment">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.AccentFill}" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.AccentForeground}" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Button.ClaudeChatPlanAddComment /template/ Border#PART_ChatButton">
    <Setter Property="BoxShadow" Value="{DynamicResource ClaudeChat.PanelShadow}" />
  </Style>
  <!-- the comment box: 320 px, the editor widget's colors and border, 6 px corners, 12 px inside; the passage in descriptionForeground
       over a 2 px bar; the field of 60 px at least in the input's colors; "Cancel" (secondary) and "Add Comment" (primary) at the right -->
  <Style Selector="Border.ClaudeChatPlanCommentBox">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.InputBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="BoxShadow" Value="{DynamicResource ClaudeChat.PanelShadow}" />
  </Style>
  <Style Selector="Border.ClaudeChatPlanCommentQuoteBar">
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="Padding" Value="8,0,0,0" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style Selector="TextBlock.ClaudeChatPlanCommentQuote">
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.ForegroundMuted}" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.FontSize}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBox.ClaudeChatPlanCommentField">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.InputBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="CaretBrush" Value="{DynamicResource ClaudeChat.Foreground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="MinHeight" Value="60" />
    <Setter Property="FontSize" Value="{DynamicResource ClaudeChat.FontSize}" />
  </Style>
  <Style Selector="TextBox.ClaudeChatPlanCommentField /template/ Border#PART_BorderElement, TextBox.ClaudeChatPlanCommentField:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.InputBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.BorderStrong}" />
  </Style>
  <Style Selector="TextBox.ClaudeChatPlanCommentField:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.InputBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.FocusBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="StackPanel.ClaudeChatPlanCommentButtons">
    <Setter Property="Spacing" Value="8" />
    <Setter Property="Margin" Value="0,8,0,0" />
  </Style>
  <Style Selector="Button.ClaudeChatPlanCommentCancel">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.SecondaryButtonBackground}" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <Style Selector="Button.ClaudeChatPlanCommentAdd">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.AccentFill}" />
    <Setter Property="Foreground" Value="{DynamicResource ClaudeChat.AccentForeground}" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <Style Selector="Button.ClaudeChatPlanCommentCancel:pointerover /template/ Border#PART_ChatButton">
    <Setter Property="Background" Value="{DynamicResource ClaudeChat.HoverBackground}" />
  </Style>
  <Style Selector="Button.ClaudeChatPlanCommentCancel:focus-visible /template/ Border#PART_ChatButton, Button.ClaudeChatPlanCommentAdd:focus-visible /template/ Border#PART_ChatButton, Button.ClaudeChatPlanAddComment:focus-visible /template/ Border#PART_ChatButton">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClaudeChat.FocusBorder}" />
  </Style>
</Styles>
