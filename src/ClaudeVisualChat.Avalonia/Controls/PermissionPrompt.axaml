<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ClaudeVisualChat.Controls.PermissionPrompt">
  <!-- the reply box's frame: 8 px corners, 8 px inside; the active border with the focus inside -->
  <Border Name="Frame" Classes="ClaudeChatPermission">
    <StackPanel>
      <DockPanel>
        <TextBlock Name="MoreText" Classes="ClaudeChatPermissionMore" DockPanel.Dock="Right" />
        <TextBlock Name="TitleText" Classes="ClaudeChatPermissionTitle" />
      </DockPanel>

      <!-- what the tool will do: the command, or the file and its diff; a long one scrolls inside (200 px, 240 in the touch
           layout, where the code binds ClaudeChat.PromptDetailPeekHeight instead while the field of option 3 is open) -->
      <ScrollViewer Name="DetailScroller" MaxHeight="{DynamicResource ClaudeChat.PromptDetailMaxHeight}"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Name="SummaryBox" Classes="ClaudeChatPermissionSummary">
            <SelectableTextBlock Name="SummaryText" Classes="ClaudeChatPermissionSummaryText" />
          </Border>
          <StackPanel Name="DiffPanel" />
        </StackPanel>
      </ScrollViewer>

      <!-- the answers, 8 px apart; 2 only when the claude offers to remember it; the selected one in the accent (in the touch
           layout, none is selected and the first, "primary", is always the accent) -->
      <StackPanel Classes="ClaudeChatPermissionOptions">
        <Button Name="YesButton" Classes="ClaudeChatButton ClaudeChatOption primary selected">
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Classes="ClaudeChatOptionNumber" Text="1" />
            <TextBlock Grid.Column="1" Name="YesText" Classes="ClaudeChatOptionText" />
          </Grid>
        </Button>
        <Button Name="AlwaysButton" Classes="ClaudeChatButton ClaudeChatOption">
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Classes="ClaudeChatOptionNumber" Text="2" />
            <TextBlock Grid.Column="1" Name="AlwaysText" Classes="ClaudeChatOptionText" />
          </Grid>
        </Button>
        <Button Name="NoButton" Classes="ClaudeChatButton ClaudeChatOption">
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Classes="ClaudeChatOptionNumber" Text="3" />
            <TextBlock Grid.Column="1" Name="NoText" Classes="ClaudeChatOptionText" />
          </Grid>
        </Button>
      </StackPanel>

      <!-- what to tell Claude, under option 3; in the touch layout a button under it sends it, as Enter does (hidden otherwise) -->
      <TextBox Name="DenyBox" Classes="ClaudeChatField" IsVisible="False" />
      <Button Name="DenySendButton" Classes="ClaudeChatButton ClaudeChatDenySend" IsVisible="False">
        <TextBlock Name="DenySendText" />
      </Button>
    </StackPanel>
  </Border>
</UserControl>
