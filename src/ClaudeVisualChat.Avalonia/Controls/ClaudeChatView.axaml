<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ClaudeVisualChat.Controls"
             x:Class="ClaudeVisualChat.Controls.ClaudeChatView">
  <UserControl.Styles>
    <StyleInclude Source="avares://ClaudeVisualChat.Avalonia/Themes/ClaudeChatTheme.axaml" />
    <!-- after the theme, so its styles win; all of them go through :touch or the class touch -->
    <StyleInclude Source="avares://ClaudeVisualChat.Avalonia/Themes/ClaudeChatTouch.axaml" />
  </UserControl.Styles>

  <Border Name="Root" Background="{DynamicResource ClaudeChat.Background}" DragDrop.AllowDrop="True">
    <!-- the chat, and the bookmarks panel beside it (the next column) or below it (the next row; the code moves it), which is
         not a layer: it takes its room from the chat -->
    <Grid Name="Split" ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
    <Grid Name="ChatArea" RowDefinitions="*,Auto,Auto">
      <!-- what a screen reader is told as it happens: a text with no size, in the tree, polite (see LiveAnnouncer) -->
      <controls:LiveAnnouncer Name="Announcer" HorizontalAlignment="Left" VerticalAlignment="Top" />
      <ScrollViewer Name="Scroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <!-- as wide as the view, like the extension's; the list's padding is ClaudeChat.ListPadding -->
        <controls:ChatItemList Name="ItemList" Classes="ClaudeChatItems">
          <controls:ChatItemList.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </controls:ChatItemList.ItemsPanel>
          <!-- while Claude works and nothing is arriving: a moving star and a verb that changes; under it the messages sent meanwhile,
               held until the claude takes them; under them, in the touch layout, the chip of the agents (in the tree only then:
               the desktop layout has it in the reply box's bar). This order holds whatever the layout -->
          <controls:ChatItemList.Footer>
            <StackPanel Name="FooterPanel">
              <controls:WorkingIndicator Name="WorkingRow" Classes="ClaudeChatWorking" IsVisible="False" />
              <controls:QueuedMessageList Name="QueuedList" />
              <controls:AgentsChip Name="TouchAgentsChip" HorizontalAlignment="Left" />
            </StackPanel>
          </controls:ChatItemList.Footer>
        </controls:ChatItemList>
      </ScrollViewer>
      <!-- the extension's fade: the last 150 px of the view go from nothing to the background, over the list and under the reply
           box (drawn after the one, before the other), so the list dims into the background over the box. Gone while read-only -->
      <Border Name="ListFade" Classes="ClaudeChatListFade" Grid.RowSpan="3" />
      <!-- the prompt of the turn on screen, pinned to the top of the list while its own row is above it; the next prompt pushes it
           out. Over the list only: every panel and layer comes over it -->
      <controls:StickyPrompt Name="Sticky" VerticalAlignment="Top" />
      <!-- the start screen of an empty conversation in auto mode: a card at the top, 340 px at most, that takes no room from the
           list and hides by itself with the view under 250 x 400 (also while read-only: it is no part of the reply box) -->
      <controls:AutoModeNotice Name="AutoNotice" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,16,16,0"
                               MaxWidth="340" />
      <!-- the plan of an ExitPlanMode request, as a document over the list only (the extension's tab beside the chat): the card
           under it stays in sight and answerable. It is long and stays open, so every passing layer opened after it comes over it:
           the /context and /usage panels, the Agent map, the comment box, the sheets and the preview, in the order the host's back
           button closes them -->
      <controls:PlanDocumentPanel Name="PlanDocument" />
      <!-- under the list, centered, 680 px at most: the request Claude waits on, the banners, then the reply box; all
           go away while the view is read-only (each shows and hides itself, so the code hides their parent: a binding to the
           view would log a warning whenever the host takes the view's data context away) -->
      <StackPanel Name="BottomPanel" Grid.Row="1" Grid.RowSpan="2">
        <controls:PermissionPrompt Name="Prompt" Margin="16,0,16,6"
                                   MaxWidth="{DynamicResource ClaudeChat.ComposerMaxWidth}" />
        <!-- the banners, their last 8 px under the reply box (drawn after them, so over them); one at a time -->
        <controls:BrowserBanner Name="BrowserBanner" Margin="16,0,16,-8"
                                MaxWidth="{DynamicResource ClaudeChat.ComposerMaxWidth}" />
        <controls:RemoteControlBanner Name="RemoteControlBanner" Margin="16,0,16,-8"
                                      MaxWidth="{DynamicResource ClaudeChat.ComposerMaxWidth}" />
        <controls:ModelFallbackBand Name="FallbackBand" Margin="16,0,16,-8"
                                    MaxWidth="{DynamicResource ClaudeChat.ComposerMaxWidth}" />
        <controls:ChatComposer Name="Composer" Margin="16,0,16,16"
                               MaxWidth="{DynamicResource ClaudeChat.ComposerMaxWidth}" />
      </StackPanel>
    </Grid>
    <controls:BookmarksPanel Name="Bookmarks" Grid.Column="1" />
    <!-- the layers, over the chat and the bookmarks panel alike (the panel is a side panel, under every modal): each spans both cells
         of the split. In the order they were over the chat before: the panels and the Agent map, the comment box, the touch layout's
         sheets, "What went wrong?", the Diff View, the image preview, the drop overlay -->
    <!-- "Context usage" and "Account &amp; Usage" (/context and /usage): modals over the whole view like the Agent map, one at a
         time; also while read-only. Not in the touch layout, where the usage sheet shows them -->
    <controls:ContextPanel Name="ContextPanel" Grid.RowSpan="2" Grid.ColumnSpan="2" />
    <controls:UsagePanel Name="UsagePanel" Grid.RowSpan="2" Grid.ColumnSpan="2" />
    <!-- the Agent map, over the whole view; also while read-only -->
    <controls:AgentMapPanel Name="AgentMap" Grid.RowSpan="2" Grid.ColumnSpan="2" />
    <!-- the box where the user writes a comment on a passage of the plan: over the list, under the passage; over the panels and the
         Agent map, under the sheets and the preview -->
    <controls:PlanCommentBox Name="PlanComment" Grid.RowSpan="2" Grid.ColumnSpan="2" />
    <!-- the touch layout's sheets, which rise from the bottom over the whole view and the Agent map; closed, each one is an
         empty hidden layer that draws nothing and takes no input, which is all the desktop layout has of them. The usage
         sheet is the last: it opens by itself when
         the conversation's panel does, so it is the one that may come up with another sheet open -->
    <controls:ModelSheet Name="ModelSheet" Grid.RowSpan="2" Grid.ColumnSpan="2" />
    <controls:AddSheet Name="AddSheet" Grid.RowSpan="2" Grid.ColumnSpan="2" />
    <controls:UsageSheet Name="UsageSheet" Grid.RowSpan="2" Grid.ColumnSpan="2" />
    <!-- "What went wrong?", which the thumb down under a reply opens: over the whole view, under the Diff View and the preview -->
    <controls:FeedbackDialog Name="Feedback" Grid.RowSpan="2" Grid.ColumnSpan="2" />
    <!-- the Diff View: a diff of the list, whole, over everything but the image preview; also while read-only -->
    <controls:DiffViewPanel Name="DiffViewer" Grid.RowSpan="2" Grid.ColumnSpan="2" />
    <!-- an attached image, over the whole view -->
    <controls:ImagePreview Name="Preview" Grid.RowSpan="2" Grid.ColumnSpan="2" />
    <!-- while files are dragged over the view: 15 % of the extension's orange over all of it, a dashed line round it and the label in
         a pill in the middle. Over everything, and it takes no input: the drop is the view's, not its own -->
    <Grid Name="DropOverlay" Classes="ClaudeChatDropOverlay" Grid.RowSpan="2" Grid.ColumnSpan="2" IsVisible="False" IsHitTestVisible="False">
      <Rectangle Classes="ClaudeChatDropFrame" />
      <Border Classes="ClaudeChatDropLabel">
        <TextBlock Name="DropLabel" />
      </Border>
    </Grid>
    </Grid>
  </Border>
</UserControl>
