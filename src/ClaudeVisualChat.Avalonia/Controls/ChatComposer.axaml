<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ClaudeVisualChat.Controls"
             x:Class="ClaudeVisualChat.Controls.ChatComposer">
  <StackPanel>
  <!-- the notice of the invisible characters taken out of the text: a banner over the box, its last 8 px under it (the box comes
       after it, so it is drawn over them) -->
  <Border Name="Notice" Classes="ClaudeChatBanner warning" Margin="0,0,0,-8" IsVisible="False">
    <DockPanel>
      <Button Name="NoticeClose" DockPanel.Dock="Right" Classes="ClaudeChatButton ClaudeChatBannerClose">
        <Viewbox Classes="ClaudeChatRemoveIcon">
          <Path Classes="ClaudeChatRemoveIcon" />
        </Viewbox>
      </Button>
      <TextBlock Name="NoticeText" Classes="ClaudeChatBannerText" />
    </DockPanel>
  </Border>
  <!-- image files dropped anywhere on the box are attached -->
  <Border Name="Box" Classes="ClaudeChatComposer" DragDrop.AllowDrop="True">
    <StackPanel>
      <!-- the images attached, above the text, and why the last one did not go in -->
      <controls:AttachmentStrip Name="Strip" />
      <TextBlock Name="AttachError" Classes="ClaudeChatAttachmentError" IsVisible="False" />
      <!-- Enter sends, Shift+Enter breaks the line (in the touch layout, Enter breaks it and Ctrl+Enter sends) -->
      <Grid>
        <TextBox Name="Input" Classes="ClaudeChatInput" AcceptsReturn="True" TextWrapping="Wrap" />
        <!-- after "/name " and nothing else, the hint of the command's arguments: the text itself, clear, then the hint in the
             placeholder's color, over the box, so that it starts where the text ends and wraps as it does -->
        <TextBlock Name="ArgumentHint" Classes="ClaudeChatArgumentHint" IsHitTestVisible="False" IsVisible="False" />
      </Grid>
      <!-- the bar, in the extension's (2.1.309) order: +, /, the context ring, the cache clock, the Remote Control chip,
           the agents chip, the model chip; at the right the mode, then send or stop. The touch layout has the bar below
           instead -->
      <Border Name="DesktopBar" Classes="ClaudeChatComposerBar">
        <DockPanel>
          <!-- send, and stop while Claude works: alone when nothing is written, next to send when something is -->
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" Margin="4,0,0,0">
            <Button Name="SendButton" Classes="ClaudeChatButton ClaudeChatSend">
              <Path Classes="ClaudeChatSendIcon" />
            </Button>
            <Button Name="StopButton" Classes="ClaudeChatButton ClaudeChatStop" IsVisible="False">
              <Border Classes="ClaudeChatStopIcon" />
            </Button>
          </StackPanel>
          <ComboBox Name="ModePicker" Classes="ClaudeChatPicker ClaudeChatModePicker" DockPanel.Dock="Right" />
          <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <Button Name="AddButton" Classes="ClaudeChatButton ClaudeChatBarButton">
              <Path Classes="ClaudeChatBarIcon ClaudeChatAddIcon" />
            </Button>
            <Button Name="CommandsButton" Classes="ClaudeChatButton ClaudeChatBarButton">
              <Path Classes="ClaudeChatBarIcon ClaudeChatCommandsIcon" />
            </Button>
            <!-- each hidden, taking no room, until there is something to show -->
            <controls:ContextRing Name="ContextRing" />
            <controls:PromptCacheClock Name="CacheClock" />
            <controls:RemoteControlChip Name="RemoteControlChip" />
            <controls:AgentsChip Name="AgentsChip" />
            <controls:ModelChip Name="ModelChip" />
          </StackPanel>
        </DockPanel>
      </Border>
      <!-- the touch layout's bar: + and the model at the left, the context ring, the microphone and send (stop, while
           Claude works) at the right, each one a target of 44 px. Its parts are separate instances that answer to the
           same rules as the bar above (send, stop), and they are in the tree only while the layout is Touch: the code
           takes them out in the desktop layout, so the desktop's tree stays as it was -->
      <Border Name="TouchBar" Classes="ClaudeChatTouchBar" IsVisible="False">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button Name="TouchAddButton" Grid.Column="0" Classes="ClaudeChatButton">
            <Path Classes="ClaudeChatBarIcon ClaudeChatAddIcon" />
          </Button>
          <!-- as wide as the bar leaves it: the name and the level end in an ellipsis when they do not fit -->
          <controls:ModelChip Name="TouchModelChip" Grid.Column="1" Ellipsize="True" />
          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <controls:ContextRing Name="TouchRing" MinimumPercent="0" />
            <!-- the microphone (dictation): shown by the code while the host's dictation is available; the class listening is its
                 accent fill, while it listens -->
            <Button Name="MicButton" Classes="ClaudeChatButton" IsVisible="False">
              <Path Classes="ClaudeChatMicIcon" />
            </Button>
            <Button Name="TouchSend" Classes="ClaudeChatButton ClaudeChatTouchSend">
              <Path Classes="ClaudeChatSendIcon" />
            </Button>
            <Button Name="TouchStop" Classes="ClaudeChatButton ClaudeChatTouchSend" IsVisible="False">
              <Border Classes="ClaudeChatStopIcon" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <!-- the command palette and the model menu open over the box, as wide as it -->
      <controls:CommandPalette Name="Palette" />
      <controls:ModelMenu Name="ModelMenu" />
    </StackPanel>
  </Border>
  </StackPanel>
</UserControl>
