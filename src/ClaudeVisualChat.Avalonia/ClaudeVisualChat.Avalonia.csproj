<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>ClaudeVisualChat</RootNamespace>
    <AssemblyName>ClaudeVisualChat.Avalonia</AssemblyName>
    <!-- the XML documentation goes in the package, beside the dll, for IntelliSense; not every member has a
         summary yet, so a missing one is no error under TreatWarningsAsErrors -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- the NuGet package -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>ClaudeVisualChat.Avalonia</PackageId>
    <Version>0.6.0</Version>
    <Authors>carlosdealmeida</Authors>
    <Description>Avalonia control that draws Claude Code conversations from the stream-json output of claude -p, in the style of the Claude Code extension for VS Code, with a touch layout for phones in the style of the Claude app. Community project, not affiliated with Anthropic.</Description>
    <PackageTags>claude claude-code avalonia chat stream-json ui touch mobile</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 carlosdealmeida</Copyright>
    <RepositoryUrl>https://github.com/carlosdealmeida/claude-visual-chat</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/carlosdealmeida/claude-visual-chat</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClaudeVisualChat.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.0.10" />
    <PackageReference Include="Markdown.Avalonia.Tight" Version="11.0.2" />
    <PackageReference Include="SkiaSharp" Version="2.88.7" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
