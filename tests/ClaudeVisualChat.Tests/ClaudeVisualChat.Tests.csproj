<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="11.0.10" />
    <PackageReference Include="Avalonia.Skia" Version="11.0.10" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.0.10" />
    <!-- the view under the other standard theme -->
    <PackageReference Include="Avalonia.Themes.Simple" Version="11.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\fixtures\**\*" Link="fixtures\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- each one's private words for FixturePrivacyTests; git ignores the file -->
    <None Include="..\private-words.txt" Condition="Exists('..\private-words.txt')" Link="private-words.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- the sample's player, tested here without the sample app -->
  <ItemGroup>
    <Compile Include="..\..\samples\ClaudeVisualChat.Sample\FixturePlayer.cs" Link="Sample\FixturePlayer.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ClaudeVisualChat.Avalonia\ClaudeVisualChat.Avalonia.csproj" />
  </ItemGroup>

</Project>
